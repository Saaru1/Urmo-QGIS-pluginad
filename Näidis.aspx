    const ESTONIA_RESOLUTIONS = [4000, 2000, 1000, 500, 250, 125, 62.5, 31.25, 15.625, 7.8125, 3.90625, 1.953125, 0.9765625, 0.48828125];

    function computeMapScaleDenominator() {
      if (!map) return 500000;
      try {
        if (typeof map.getSize === 'function' && typeof map.getBounds === 'function' && typeof map.distance === 'function') {
          const sz = map.getSize();
          const b = map.getBounds();
          if (sz && sz.x > 20 && b && b.isValid && b.isValid()) {
            const midLat = (b.getNorth() + b.getSouth()) * 0.5;
            const metersAcross = map.distance([midLat, b.getWest()], [midLat, b.getEast()]);
            if (Number.isFinite(metersAcross) && metersAcross > 0) {
              const mpp = metersAcross / sz.x;
              return Math.max(100, Math.round(mpp * 3779.52756));
            }
          }
        }
      } catch (_e) {}
      const z = (typeof map.getZoom === 'function') ? Math.max(0, Math.round(Number(map.getZoom() || 7))) : 7;
      const res = ESTONIA_RESOLUTIONS[Math.min(z, ESTONIA_RESOLUTIONS.length - 1)] || 31.25;
      return Math.max(100, Math.round(res * 3779.52756));
    }

    function targetLodForScale(scaleDenom) {

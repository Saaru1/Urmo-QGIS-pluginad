      syncMobileMapTouchLock();
      if (map && typeof map.invalidateSize === 'function') setTimeout(() => map.invalidateSize(), 60);
      if (typeof document !== 'undefined' && typeof document.querySelectorAll === 'function' && typeof Plotly !== 'undefined' && Plotly && Plotly.Plots) {

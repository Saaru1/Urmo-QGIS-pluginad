      let targetLatLon = null;
      if (item.lat !== undefined && item.lon !== undefined && item.lat !== null && item.lon !== null) {
        targetLatLon = [Number(item.lat), Number(item.lon)];
      } else if (item.x_3301 !== undefined && item.y_3301 !== undefined && item.x_3301 !== null && item.y_3301 !== null) {
        targetLatLon = _toWgs84Coord(item.x_3301, item.y_3301);
      } else if (item.viitepunkt_b !== undefined && item.viitepunkt_l !== undefined) {
        targetLatLon = [Number(item.viitepunkt_b), Number(item.viitepunkt_l)];
      } else if (item.viitepunkt_x !== undefined && item.viitepunkt_y !== undefined) {
        targetLatLon = _toWgs84Coord(item.viitepunkt_x, item.viitepunkt_y);
      }
      const geomWgs = item.geometry ? _convertEstGeomToWgs84(item.geometry) : null;
      const grp = L.featureGroup ? L.featureGroup().addTo(map) : L.layerGroup().addTo(map);
      if (geomWgs && typeof L.geoJSON === 'function') {
        const gl = L.geoJSON(geomWgs, { style: { color: '#f97316', fillColor: '#fb923c', weight: 3, fillOpacity: 0.25 } });
        grp.addLayer(gl);
      }
      if (!targetLatLon && Array.isArray(item.bbox_3301) && item.bbox_3301.length === 4) {
        targetLatLon = _toWgs84Coord((item.bbox_3301[0] + item.bbox_3301[2]) / 2, (item.bbox_3301[1] + item.bbox_3301[3]) / 2);
      }
      if (targetLatLon && typeof L.circleMarker === 'function') {
        const mk = L.circleMarker(targetLatLon, { radius: 8, color: '#ef4444', fillColor: '#fef08a', weight: 3, fillOpacity: 0.9 });
        if (mk.bindPopup) mk.bindPopup(`<b>${dispLabel}</b><br/><span style="opacity:0.8">${item.type_label || item.type || ''}</span>`);
        grp.addLayer(mk);

                version: '1.1.1',
                layers: layersParam,
                styles: revParam,
                format: 'image/png',
                transparent: true,
                tileSize: 256,
                opacity: 0.90,
                pane: desiredPane,
                zIndex: 1,
                updateWhenIdle: true,
                updateWhenZooming: false,
                keepBuffer: 2,

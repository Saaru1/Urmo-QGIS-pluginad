    function initMap() {
      const estoniaCrs = (typeof L !== 'undefined' && L.Proj && typeof proj4 !== 'undefined')
        ? new L.Proj.CRS(
            'EPSG:3301',
            '+proj=lcc +lat_1=59.33333333333334 +lat_2=58 +lat_0=57.51755393055556 +lon_0=24 +x_0=500000 +y_0=6375000 +ellps=GRS80 +towgs84=0,0,0,0,0,0,0 +units=m +no_defs',
            {
              resolutions: [4000, 2000, 1000, 500, 250, 125, 62.5, 31.25, 15.625, 7.8125, 3.90625, 1.953125, 0.9765625, 0.48828125, 0.244140625],
              origin: [40500, 5993000],
              bounds: L.bounds([40500, 5993000], [1064500, 7017000])
            }
          )
        : L.CRS.EPSG3857;

      const mapWidget = (DASHBOARD.widgets || []).find(w => w.widget_type === 'map');
      const initLat = Number((mapWidget && mapWidget.map_center_lat) || DASHBOARD.map_center_lat || 58.758);
      const initLon = Number((mapWidget && mapWidget.map_center_lon) || DASHBOARD.map_center_lon || 23.825);
      const rawZoom = (mapWidget && mapWidget.map_zoom !== undefined && mapWidget.map_zoom !== null)
        ? mapWidget.map_zoom
        : DASHBOARD.map_zoom;
      const initZoom = (rawZoom !== undefined && rawZoom !== null)
        ? Math.min(14, Number(rawZoom))
        : 7;
      const rawHomeBounds = (mapWidget && Array.isArray(mapWidget.map_home_bounds) && mapWidget.map_home_bounds.length === 4)
        ? mapWidget.map_home_bounds
        : ((Array.isArray(DASHBOARD.map_home_bounds) && DASHBOARD.map_home_bounds.length === 4) ? DASHBOARD.map_home_bounds : null);
      HOME_MAP_VIEW = { lat: initLat, lon: initLon, zoom: initZoom, bounds: rawHomeBounds ? rawHomeBounds.map(Number) : null };
      LEGEND_COLLAPSED = Boolean(mapWidget && mapWidget.map_legend_collapsed);
      // "Kihid" layer menu on the map always starts minimized by default
      LAYER_CONTROL_COLLAPSED = true;

      map = L.map('map-canvas', {
        crs: estoniaCrs,
        preferCanvas: true,
        attributionControl: true,
        minZoom: 0,
        maxZoom: 14,
        zoomSnap: 0.02,
        zoomDelta: 1
      }).setView([initLat, initLon], initZoom);
      if (HOME_MAP_VIEW.bounds && HOME_MAP_VIEW.bounds.every(Number.isFinite)) {
        IS_PROGRAMMATIC_MOVE = true;
        try {
          map.fitBounds(
            [[HOME_MAP_VIEW.bounds[0], HOME_MAP_VIEW.bounds[1]], [HOME_MAP_VIEW.bounds[2], HOME_MAP_VIEW.bounds[3]]],
            { padding: [6, 6], maxZoom: 14, animate: false }
          );
        } finally {
          setTimeout(() => { IS_PROGRAMMATIC_MOVE = false; }, 120);
        }
      }
      if (map.attributionControl && typeof map.attributionControl.setPrefix === 'function') {
        map.attributionControl.setPrefix(false);
      }
      if (typeof L.canvas === 'function') {
        vectorCanvasRenderer = L.canvas({ padding: 0.5 });
      }

      const mapCardEl = document.querySelector('.map-card');
      if (mapCardEl && typeof ResizeObserver !== 'undefined') {
        new ResizeObserver(() => { if (map) map.invalidateSize(); }).observe(mapCardEl);
      }

      const baseMaps = {};
      const overlays = {};
      const baseLayerIds = {};

      // Attach configured Estonian Maa- ja Ruumiamet & corporate WMS layers (unified block; CIR removed #8)
      (BUNDLE.ogc_services || []).forEach(svc => {
        if (svc.type === 'wms' && svc.url) {
          const rawLyr = String(svc.layers || '');
          if (rawLyr.toLowerCase() === 'cir_ngr' || /cir\s*infrapuna/i.test(svc.name || '')) return;
          const normLayers = rawLyr === 'MA-FOTOKAART' ? 'EESTIFOTO' : rawLyr;
          const normUrl = (normLayers === 'EESTIFOTO' || normLayers === 'HYBRID')
            ? 'https://kaart.maaamet.ee/wms/fotokaart'
            : svc.url;
          const normFmt = normLayers === 'EESTIFOTO'
            ? 'image/jpeg'
            : (svc.format || (Boolean(svc.is_basemap) ? 'image/jpeg' : 'image/png'));
          const isBase = Boolean(svc.is_basemap);
          const wmsLayer = L.tileLayer.wms(normUrl, {
            version: svc.version || '1.1.1',
            layers: normLayers,
            format: normFmt,
            transparent: !isBase,
            styles: svc.styles || '',
            attribution: '&copy; Maa- ja Ruumiamet / EELIS'
          });
          if (isBase) {
            baseMaps[svc.name] = wmsLayer;
            baseLayerIds[normLayers] = wmsLayer;
          } else {
            overlays[svc.name] = wmsLayer;
            attachMapLayerLoaderEvents(wmsLayer, 'ogc:' + (svc.name || normLayers), t('map_rendering_layers'));
            if (!/hübriid|hybrid/i.test(svc.name)) wmsLayer.addTo(map);
          }
        }
      });

      // Default Estonian Maa- ja Ruumiamet WMS block (Hallkaart, Põhikaart, Ortofoto + Hübriidkaart) (#8)
      if (Object.keys(baseMaps).length === 0) {
        baseMaps['Maa- ja Ruumiamet Hallkaart'] = L.tileLayer.wms('https://kaart.maaamet.ee/wms/hallkaart', {
          version: '1.1.1', layers: 'MA-HALLKAART', format: 'image/png', transparent: false,
          attribution: '&copy; Maa- ja Ruumiamet'
        });
        baseLayerIds['MA-HALLKAART'] = baseMaps['Maa- ja Ruumiamet Hallkaart'];
        baseMaps['Maa- ja Ruumiamet Põhikaart'] = L.tileLayer.wms('https://kaart.maaamet.ee/wms/kaart', {
          version: '1.1.1', layers: 'MA-KAART', format: 'image/png', transparent: false,
          attribution: '&copy; Maa- ja Ruumiamet'
        });
        baseLayerIds['MA-KAART'] = baseMaps['Maa- ja Ruumiamet Põhikaart'];
        baseMaps['Maa- ja Ruumiamet Fotokaart (Ortofoto)'] = L.tileLayer.wms('https://kaart.maaamet.ee/wms/fotokaart', {
          version: '1.1.1', layers: 'EESTIFOTO', format: 'image/jpeg', transparent: false,
          attribution: '&copy; Maa- ja Ruumiamet'
        });
        baseLayerIds['EESTIFOTO'] = baseMaps['Maa- ja Ruumiamet Fotokaart (Ortofoto)'];
      }
      if (!Object.keys(overlays).some(k => /hübriid|hybrid/i.test(k))) {
        overlays['Maa- ja Ruumiamet Hübriidkaart'] = L.tileLayer.wms('https://kaart.maaamet.ee/wms/fotokaart', {
          version: '1.1.1', layers: 'HYBRID', format: 'image/png', transparent: true,
          attribution: '&copy; Maa- ja Ruumiamet'
        });
      }

      let desiredBmId = (mapWidget && mapWidget.map_basemap) || '';
      if (desiredBmId === 'MA-FOTOKAART') desiredBmId = 'EESTIFOTO';
      if (desiredBmId === 'cir_ngr') desiredBmId = 'MA-HALLKAART';
      const firstBase = baseLayerIds[desiredBmId] || Object.values(baseMaps)[0];
      Object.assign(BASE_MAP_LAYERS, baseMaps);
      DEFAULT_BASEMAP_LAYER = firstBase || null;
      INITIAL_LAYER_ORDER = (mapWidget && Array.isArray(mapWidget.map_layers) && mapWidget.map_layers.length)
        ? mapWidget.map_layers.slice()
        : null;
      const hybridEntry = Object.entries(overlays).find(([k]) => /hübriid|hybrid/i.test(k));
      HYBRID_LAYER_REF = hybridEntry ? hybridEntry[1] : null;
      INITIAL_HYBRID_ENABLED = Boolean(HYBRID_LAYER_REF && map.hasLayer(HYBRID_LAYER_REF));
      if (firstBase) firstBase.addTo(map);

      // Create toggleable GeoJSON layer groups for every WFS / vector layer, preserving Design Mode visibility (#4)
      const vectorNames = Array.from(new Set([
        ...Object.keys(LAYER_RECORDS),
        ...(BUNDLE.ogc_services || []).filter(s => s.type === 'wfs').map(s => s.name)
      ]));
      const initVis = computeInitialLayerVisibility(vectorNames);
      vectorNames.forEach(ln => {
        const isVis = initVis[ln] !== false;
        if (MAP_LAYER_VISIBILITY[ln] === undefined) MAP_LAYER_VISIBILITY[ln] = isVis;
        const grp = L.layerGroup();
        if (MAP_LAYER_VISIBILITY[ln] !== false) grp.addTo(map);
        LAYER_OVERLAYS[ln] = grp;
        overlays[ln] = grp;

        // Companion GeoServer WMS tile layer for standalone HTML high-speed overview rendering
        if (!HAS_PREVIEW_API) {
          const svc = (BUNDLE.ogc_services || []).find(s => s.name === ln && s.type === 'wfs');
          const wmsUrl = svc ? deriveGeoServerWmsUrl(svc.url) : '';
          if (wmsUrl && svc.typename && typeof L.tileLayer !== 'undefined' && typeof L.tileLayer.wms === 'function') {
            const stCfgWms = getMapLayerStyleCfg(ln);
            const wmsMinZ = (stCfgWms && Number(stCfgWms.min_zoom) > 0) ? Math.max(0, Number(stCfgWms.min_zoom)) : 0;
            LAYER_WMS_OVERLAYS[ln] = L.tileLayer.wms(wmsUrl, {
              version: '1.1.1',
              layers: svc.typename,
              format: 'image/png',
              transparent: true,
              opacity: 0.85,
              minZoom: wmsMinZ,
              attribution: '&copy; Maa- ja Ruumiamet / EELIS / PRIA'
            });
            attachMapLayerLoaderEvents(LAYER_WMS_OVERLAYS[ln], 'wfs_wms:' + ln, t('map_rendering_layers'));
          }
        }
      });

      layerControl = L.control.layers(baseMaps, overlays, { collapsed: false, position: 'topright' }).addTo(map);
      if (layerControl && typeof layerControl.getContainer === 'function' && typeof L.DomUtil !== 'undefined') {
        const lcEl = layerControl.getContainer();
        if (lcEl && typeof lcEl.insertBefore === 'function') {
          const bar = document.createElement('div');
          bar.className = 'leaflet-control-layers-collapse-bar';
          bar.innerHTML = `<span id="leaflet-layers-panel-title">${t('html_layers_panel')}</span><button type="button" class="panel-right-toggle-btn leaflet-layer-collapse-btn" title="${LAYER_CONTROL_COLLAPSED ? t('html_expand_panel') : t('html_collapse_panel')}">${LAYER_CONTROL_COLLAPSED ? '⟨' : '⟩'}</button>`;
          lcEl.insertBefore(bar, lcEl.firstChild || null);
          if (lcEl.classList) lcEl.classList.toggle('leaflet-right-collapsed', Boolean(LAYER_CONTROL_COLLAPSED));
          const colBtn = bar.querySelector('.leaflet-layer-collapse-btn');
          bar.style.cursor = 'pointer';
          bar.onclick = ev => {
            if (ev && ev.stopPropagation) ev.stopPropagation();
            toggleLayerControlCollapsed();
          };
          if (colBtn) {
            colBtn.onclick = ev => {
              if (ev && ev.stopPropagation) ev.stopPropagation();
              toggleLayerControlCollapsed();
            };
          }
          if (L.DomEvent && typeof L.DomEvent.disableClickPropagation === 'function') {
            L.DomEvent.disableClickPropagation(bar);
          }
        }
      }
      syncLeafletLayerControlActions();

      if (typeof map.on === 'function') {
        map.on('overlayadd', ev => {
          if (IS_SYNCING_MAP_LAYERS > 0 || !ev || !ev.layer) return;
          const matchName = Object.keys(LAYER_OVERLAYS).find(ln => LAYER_OVERLAYS[ln] === ev.layer);
          if (!matchName) return;
          MAP_LAYER_VISIBILITY[matchName] = true;
          renderMapLayersDrawer();
          scheduleMapRender({ skipAutoZoom: true });
        });
        map.on('overlayremove', ev => {
          if (IS_SYNCING_MAP_LAYERS > 0 || !ev || !ev.layer) return;
          const matchName = Object.keys(LAYER_OVERLAYS).find(ln => LAYER_OVERLAYS[ln] === ev.layer);
          if (!matchName) return;
          MAP_LAYER_VISIBILITY[matchName] = false;
          if (LAYER_WMS_OVERLAYS[matchName] && map.hasLayer && map.hasLayer(LAYER_WMS_OVERLAYS[matchName])) {
            IS_SYNCING_MAP_LAYERS += 1;
            try { map.removeLayer(LAYER_WMS_OVERLAYS[matchName]); } finally { IS_SYNCING_MAP_LAYERS -= 1; }
          }
          renderMapLayersDrawer();
          scheduleMapRender({ skipAutoZoom: true });
        });
      }
      if (L.control && L.control.scale) {
        L.control.scale({ metric: true, imperial: false, position: 'bottomleft' }).addTo(map);
      }
      if (typeof L.DomUtil !== 'undefined' && typeof L.control === 'function') {
        const homeCtrl = L.control({ position: 'topleft' });
        homeCtrl.onAdd = () => {
          const wrap = L.DomUtil.create('div', 'leaflet-bar leaflet-control');
          const a = L.DomUtil.create('a', 'leaflet-home-btn', wrap);
          a.href = '#';
          a.title = t('html_reset_home');
          a.innerHTML = '🏠';
          a.onclick = ev => {
            if (ev && ev.preventDefault) ev.preventDefault();
            resetMapHomeView();
            return false;
          };
          return wrap;
        };
        homeCtrl.addTo(map);
      }

      legendControl = L.control({ position: 'bottomright' });
      legendControl.onAdd = () => {
        const div = L.DomUtil.create('div', 'map-legend');
        div.innerHTML = legendHtml();
        if (L.DomEvent && typeof L.DomEvent.disableClickPropagation === 'function') {
          L.DomEvent.disableClickPropagation(div);
        }
        if (L.DomEvent && typeof L.DomEvent.disableScrollPropagation === 'function') {
          L.DomEvent.disableScrollPropagation(div);
        }
        return div;
      };
      legendControl.addTo(map);
      updateMapLegend();

      map.on('movestart zoomstart', () => {
        IS_MAP_INTERACTING = true;
        if (VIEWPORT_REFRESH_TIMER) {
          clearTimeout(VIEWPORT_REFRESH_TIMER);
          VIEWPORT_REFRESH_TIMER = null;
        }
        if (EXTENT_REFRESH_TIMER) {
          clearTimeout(EXTENT_REFRESH_TIMER);
          EXTENT_REFRESH_TIMER = null;
        }
        if (MAP_RENDER_SHOW_TIMER) {
          clearTimeout(MAP_RENDER_SHOW_TIMER);
          MAP_RENDER_SHOW_TIMER = null;
        }
      });

      map.on('zoomend', () => {
        syncZoomVisibilityImmediate();
      });

      map.on('moveend', () => {
        IS_MAP_INTERACTING = false;
        const sDenom = computeMapScaleDenominator();
        updateMapScaleBadge(sDenom, targetLodForScale(sDenom));
        saveDashboardSessionState();
        if (MAP_RENDER_OPS > 0 && !MAP_RENDER_SHOW_TIMER) {
          MAP_RENDER_SHOW_TIMER = setTimeout(() => {
            MAP_RENDER_SHOW_TIMER = null;
            if (MAP_RENDER_OPS > 0 && !IS_MAP_INTERACTING) _syncMapRenderLoaderDOM();
          }, MAP_RENDER_LOADER_DELAY_MS);
        }
        if (IS_PROGRAMMATIC_MOVE) return;
        if (EXTENT_FILTER_ENABLED) {
          scheduleExtentFilterRefresh();
        } else if (!shouldSkipMinorViewportRefresh()) {
          scheduleMapRefreshOnViewport();
        } else if (typeof updateMapLegend === 'function') {
          updateMapLegend();
        }
      });

      const initScale = computeMapScaleDenominator();
      updateMapScaleBadge(initScale, targetLodForScale(initScale));
      updateExtentButtonUI();
    }

    function applyExcelJoinsToLayer(layerName, rawRecords) {
      let records = rawRecords.map(r => Object.assign({}, r));
      (DASHBOARD.joins || []).forEach(jn => {
        const targetDs = (DASHBOARD.data_sources || []).find(d => d.id === jn.target_layer_id);
        const targetName = targetDs ? targetDs.name : jn.target_layer_id;
        if (targetName !== layerName) return;

        const excelRows = EXCEL_TABLES[jn.source_table_id] || [];
        const lookup = {};
        excelRows.forEach(ex => {
          const k = ex[jn.source_key_field];
          if (k !== undefined && k !== null) lookup[String(k).trim()] = ex;
        });
        const prefix = jn.join_prefix || 'xl_';
        records.forEach(row => {
          const tk = row[jn.target_key_field];
          const match = tk !== undefined && tk !== null ? lookup[String(tk).trim()] : null;
          if (match) {
            Object.keys(match).forEach(col => {
              if (col !== jn.source_key_field) {
                row[prefix + col] = match[col];
              }
            });
          }
        });
      });
      return records;
    }

    function _buildPaginatedWfsUrl(baseUrl, countVal, startIdx, svc, sortField) {
      let out = String(baseUrl || '');
      if (!out) return '';
      try {
        const u = new URL(out);
        const isV1 = /^1\./i.test(String(u.searchParams.get('version') || ''));
        u.searchParams.delete('count');
        u.searchParams.delete('maxFeatures');
        u.searchParams.delete('startIndex');
        u.searchParams.delete('sortBy');
        if (isV1) {
          u.searchParams.set('maxFeatures', String(countVal));
        } else {
          u.searchParams.set('count', String(countVal));
        }
        if (startIdx > 0) {
          u.searchParams.set('startIndex', String(startIdx));
        }
        if (sortField) {
          u.searchParams.set('sortBy', String(sortField) + ' A');
        }
        if (svc && svc.restrict_to_bbox === true && map && typeof map.getBounds === 'function' && !u.searchParams.has('bbox')) {
          const b = map.getBounds();
          if (b && (!b.isValid || b.isValid())) {
            u.searchParams.set('bbox', `${b.getSouth()},${b.getWest()},${b.getNorth()},${b.getEast()},urn:ogc:def:crs:EPSG::4326`);
          }
        }
        return u.toString();
      } catch (_urlErr) {
        let cleaned = out.replace(/([?&])(count|maxFeatures|startIndex|sortBy)=[^&]*/gi, '$1').replace(/[?&]$/, '').replace(/&&+/g, '&').replace(/\?&/, '?');
        const sep = cleaned.includes('?') ? '&' : '?';
        const cntParam = /version=1\./i.test(cleaned) ? 'maxFeatures' : 'count';
        let res = `${cleaned}${sep}${cntParam}=${countVal}`;
        if (startIdx > 0) res += `&startIndex=${startIdx}`;
        if (sortField) res += `&sortBy=${encodeURIComponent(String(sortField) + ' A')}`;
        if (svc && svc.restrict_to_bbox === true && map && typeof map.getBounds === 'function' && !/bbox=/i.test(res)) {
          const b = map.getBounds();
          res += `&bbox=${b.getSouth()},${b.getWest()},${b.getNorth()},${b.getEast()},urn:ogc:def:crs:EPSG::4326`;
        }
        return res;
      }
    }

    function _pickWfsSortField(features) {
      if (!Array.isArray(features) || !features.length) return '';
      const props = (features[0] && features[0].properties) || {};
      const cands = ['parandniidu_nr', 'kr_kood', 'kood', 'tunnus', 'sys_id', 'gid', 'objectid', 'fid', 'id'];
      for (let i = 0; i < cands.length; i++) {
        if (props[cands[i]] !== undefined && props[cands[i]] !== null) return cands[i];
      }
      const keys = Object.keys(props);
      return keys.length ? keys[0] : '';
    }

    async function _fetchWfsFeaturePages(baseUrl, wfsSvc, pageOpts) {
      const opts = pageOpts || {};
      const rawMax = opts.maxFeatures;
      const hasFiniteCap = rawMax !== null && rawMax !== undefined && rawMax !== '' && Number.isFinite(Number(rawMax)) && Number(rawMax) > 0;
      const maxFeatures = hasFiniteCap ? Math.max(1, Number(rawMax)) : Infinity;
      const pageSize = Math.min(Math.max(100, Number(opts.pageSize || (hasFiniteCap ? Math.min(maxFeatures, 5000) : 5000))), 10000);
      const skipBboxAppend = Boolean(opts.skipBboxAppend);
      const optsBase = { method: 'GET', cache: 'no-store', headers: { 'Accept': 'application/json' } };
      if (wfsSvc && wfsSvc.with_credentials) optsBase.credentials = 'include';

      let allFeatures = [];
      let seenFids = new Set();
      let startIdx = 0;
      let totalFeatures = 0;
      let hitCap = false;
      let activeSortField = '';
      let retriedSorted = false;
      while (true) {
        const remaining = Number.isFinite(maxFeatures) ? (maxFeatures - allFeatures.length) : pageSize;
        if (remaining <= 0) {
          hitCap = true;
          break;
        }
        const reqCount = Math.min(pageSize, remaining);
        const pageUrl = _buildPaginatedWfsUrl(baseUrl, reqCount, startIdx, skipBboxAppend ? null : wfsSvc, activeSortField);
        const resp = await fetch(pageUrl, optsBase);
        if (!resp.ok) {
          if (activeSortField && startIdx === 0) {
            activeSortField = '';
            continue;
          }
          if (allFeatures.length > 0) {
            hitCap = true;
            break;
          }
          throw new Error('HTTP ' + resp.status);
        }
        const geojson = await resp.json();
        const feats = (geojson && Array.isArray(geojson.features)) ? geojson.features : [];
        const reportedTotal = Number((geojson && (geojson.totalFeatures ?? geojson.numberMatched)) || 0);
        if (reportedTotal > 0) totalFeatures = reportedTotal;

        if (startIdx === 0 && typeof opts.onFirstPageMeta === 'function') {
          const early = opts.onFirstPageMeta({ totalFeatures, feats });
          if (early && early.abort) return early;
        }

        if (!feats.length) break;
        let dupInPage = 0;
        let addedInPage = 0;
        for (let fi = 0; fi < feats.length; fi++) {
          const ft = feats[fi];
          const fidKey = (ft && ft.id !== undefined && ft.id !== null) ? String(ft.id) : '';
          if (fidKey && seenFids.has(fidKey)) {
            dupInPage++;
            continue;
          }
          if (fidKey) seenFids.add(fidKey);
          allFeatures.push(ft);
          addedInPage++;
        }
        if (startIdx > 0 && dupInPage > 0 && !retriedSorted) {
          const sf = _pickWfsSortField(allFeatures);
          if (sf) {
            retriedSorted = true;
            activeSortField = sf;
            allFeatures = [];
            seenFids = new Set();
            startIdx = 0;
            continue;
          }
        }
        if (addedInPage === 0) break;
        if (totalFeatures > 0) {
          if (allFeatures.length >= totalFeatures) break;
        } else if (feats.length < reqCount) {
          break;
        }
        startIdx += feats.length;
      }
      return { features: allFeatures, totalFeatures, hitCap, aborted: false };
    }

    async function _fetchFullViewportGeometriesForGpkg(layerName, viewBb) {
      if (!layerName || !Array.isArray(viewBb) || viewBb.length !== 4) return false;
      const hadRows = Array.isArray(LAYER_RECORDS[layerName]) && LAYER_RECORDS[layerName].length > 0;
      try {
        if (HAS_PREVIEW_API) {
          const params = new URLSearchParams();
          params.set('layer', layerName);
          params.set('zoom', '16');
          params.set('lod', '3');
          params.set('scale', '25000');
          params.set('max', '25000');
          params.set('bbox', viewBb.map(v => Number(v).toFixed(5)).join(','));
          const resp = await fetch('/api/features?' + params.toString(), { cache: 'no-store' });
          if (!resp.ok) return false;
          const fc = await resp.json();
          const feats = (fc && Array.isArray(fc.features)) ? fc.features : [];
          if (feats.length > 0) {
            ingestGeoJsonFeatures(layerName, feats, {
              mergeExisting: true,
              matchExistingOnly: hadRows,
              lod: 3
            });
            return true;
          }
          return false;
        }
        const wfsSvc = findLiveWfsService(layerName);
        if (!wfsSvc) return false;
        const pageSize = 5000;
        const bboxUrl = _buildWfsBboxUrl(wfsSvc, viewBb, pageSize);
        if (!bboxUrl) return false;
        const res = await _fetchWfsFeaturePages(bboxUrl, wfsSvc, {
          maxFeatures: 25000,
          pageSize,
          skipBboxAppend: true
        });
        const allFeatures = (res && Array.isArray(res.features)) ? res.features : [];
        if (allFeatures.length > 0) {
          ingestGeoJsonFeatures(layerName, allFeatures, {
            mergeExisting: true,
            matchExistingOnly: hadRows,
            lod: 3
          });
          return true;
        }
      } catch (err) {
        console.warn('Full 1:1 viewport geometry fetch failed for ' + layerName, err);
      }
      return false;
    }

    async function fetchSingleWfsService(svc, fetchOpts) {
      const fopts = fetchOpts || {};
      if (!svc || !svc.geojson_url) return false;
      if (!fopts.deferStatus && !fopts.silent) setLiveStatus('html_loading_wfs');
      try {
        const rawDashCap = Number(DASHBOARD.html_live_max_features);
        const isMassiveSvc = Boolean(
          svc.restrict_to_bbox || /(kataster|ky_kehtiv|etak|kitsendus)/i.test(String(svc.typename || svc.name || ''))
        );
        const effectiveCap = isMassiveSvc
          ? 2500
          : ((fopts.forceFull || !Number.isFinite(rawDashCap) || rawDashCap <= 0) ? Infinity : Math.max(1, rawDashCap));
        const rawPage = Number(svc.page_size || 0);
        const pageSize = isMassiveSvc
          ? 400
          : ((rawPage >= 100 && rawPage <= 10000) ? rawPage : (Number.isFinite(effectiveCap) ? Math.min(effectiveCap, 5000) : 5000));
        const existingRows = Array.isArray(LAYER_RECORDS[svc.name]) ? LAYER_RECORDS[svc.name] : [];
        const optsBase = { method: 'GET', cache: 'no-store', headers: { 'Accept': 'application/json' } };
        if (svc.with_credentials) optsBase.credentials = 'include';

        if (Number.isFinite(effectiveCap) && !fopts.forceFull && existingRows.length > effectiveCap) {
          const probeUrl = _buildPaginatedWfsUrl(svc.geojson_url, 1, 0, svc);
          const pResp = await fetch(probeUrl, optsBase);
          if (!pResp.ok) throw new Error('HTTP ' + pResp.status);
          const pJson = await pResp.json();
          const tot = Number((pJson && (pJson.totalFeatures ?? pJson.numberMatched)) ?? existingRows.length);
          LAYER_LIVE_INFO[svc.name] = {
            status: 'live_streamed',
            label: 'LIVE (stream)',
            loaded: existingRows.length,
            totalFeatures: Number.isFinite(tot) ? tot : existingRows.length
          };
          return { ok: true, live: true, partial: true, replaced: false, totalFeatures: tot };
        }

        const pageRes = await _fetchWfsFeaturePages(svc.geojson_url, svc, {
          maxFeatures: effectiveCap,
          pageSize,
          onFirstPageMeta: ({ totalFeatures }) => {
            if (Number.isFinite(effectiveCap) && !fopts.forceFull && totalFeatures > effectiveCap && existingRows.length >= Math.min(totalFeatures, effectiveCap)) {
              LAYER_LIVE_INFO[svc.name] = {
                status: 'live_streamed',
                label: 'LIVE (stream)',
                loaded: existingRows.length,
                totalFeatures
              };
              return { abort: true, earlyReturn: { ok: true, live: true, partial: true, replaced: false, totalFeatures } };
            }
            return null;
          }
        });
        if (pageRes && pageRes.aborted && pageRes.earlyReturn) {
          return pageRes.earlyReturn;
        }
        const allFeatures = (pageRes && Array.isArray(pageRes.features)) ? pageRes.features : [];
        const totalFeatures = Number((pageRes && pageRes.totalFeatures) || 0);
        const hitCap = Boolean(pageRes && pageRes.hitCap);

        if (allFeatures.length > 0) {
          const isComplete = !hitCap || (totalFeatures > 0 && allFeatures.length >= totalFeatures);
          ingestGeoJsonFeatures(svc.name, allFeatures, {
            mergeExisting: !isComplete,
            lod: 3
          });
          LAYER_RECORDS[svc.name] = applyExcelJoinsToLayer(svc.name, LAYER_RECORDS[svc.name] || []);
          delete LAYER_LAST_MISSING_KEY[svc.name];
          if (typeof _CROSS_LAYER_FID_CACHE !== 'undefined') _CROSS_LAYER_FID_CACHE.clear();
          if (typeof _CROSS_LAYER_AREA_CACHE !== 'undefined') _CROSS_LAYER_AREA_CACHE.clear();
          LAYER_LIVE_INFO[svc.name] = {
            status: isComplete ? 'live' : 'live_partial',
            label: isComplete ? 'LIVE' : `LIVE (${allFeatures.length})`,
            loaded: (LAYER_RECORDS[svc.name] || []).length,
            totalFeatures: totalFeatures || allFeatures.length
          };
          if (!fopts.deferStatus) {
            setLiveStatus(isComplete ? 'html_wfs_connected' : 'html_live_partial', {
              count: 1,
              total: 1,
              cap: effectiveCap
            });
          }
          if (!fopts.deferRender) {
            computeBrowserNaturaPriaOverlap({ force: true });
            renderAll({ skipAutoZoom: true });
          }
          return {
            ok: true,
            live: true,
            partial: !isComplete,
            replaced: true,
            layerName: svc.name,
            totalFeatures: totalFeatures || allFeatures.length
          };
        }
      } catch (err) {
        console.warn('WFS fetch failed for ' + svc.name, err);
        const cachedCnt = Array.isArray(LAYER_RECORDS[svc.name]) ? LAYER_RECORDS[svc.name].length : 0;
        LAYER_LIVE_INFO[svc.name] = { status: 'cached', label: 'Cached', loaded: cachedCnt };
      }
      return false;
    }

    async function refreshLiveWfs(opts) {
      const ropts = opts || {};
      const wfsServices = (BUNDLE.ogc_services || []).filter(s => s.type === 'wfs' && s.geojson_url);
      if (!wfsServices.length) {
        if (!ropts.silent) renderAll({ skipAutoZoom: true });
        return 0;
      }
      const targetServices = ropts.missingOnly
        ? wfsServices.filter(s => !(LAYER_RECORDS[s.name] && LAYER_RECORDS[s.name].length))
        : wfsServices;
      if (!targetServices.length) {
        return 0;
      }
      if (IS_WFS_REFRESHING && !ropts.allowConcurrent) return 0;
      IS_WFS_REFRESHING = true;
      if (ropts.force) {
        Object.keys(LAYER_LAST_MISSING_KEY).forEach(k => delete LAYER_LAST_MISSING_KEY[k]);
        Object.keys(LAYER_FETCH_COOLDOWN).forEach(k => delete LAYER_FETCH_COOLDOWN[k]);
        if (typeof _CROSS_LAYER_FID_CACHE !== 'undefined') _CROSS_LAYER_FID_CACHE.clear();
        if (typeof _CROSS_LAYER_AREA_CACHE !== 'undefined') _CROSS_LAYER_AREA_CACHE.clear();
      }
      const hadInitial = targetServices.every(s => Array.isArray(LAYER_RECORDS[s.name]) && LAYER_RECORDS[s.name].length > 0);
      if (!ropts.silent) {
        setLiveStatus(hadInitial ? 'html_wfs_checking' : 'html_loading_wfs');
      }
      let connectedCount = 0;
      let partialCount = 0;
      let anyReplaced = false;
      try {
        const results = await Promise.all(
          targetServices.map(svc => fetchSingleWfsService(svc, {
            deferRender: true,
            deferStatus: true,
            force: Boolean(ropts.force),
            forceFull: Boolean(ropts.forceFull),
            silent: Boolean(ropts.silent)
          }))
        );
        results.forEach(res => {
          if (res && res.ok) {
            connectedCount++;
            if (res.partial) partialCount++;
            if (res.replaced) anyReplaced = true;
          }
        });
      } finally {
        IS_WFS_REFRESHING = false;
      }
      if (connectedCount > 0) {
        LIVE_SESSION_STAMP = _formatLiveTimeStamp(new Date());
        if (anyReplaced) {
          computeBrowserNaturaPriaOverlap();
        }
        const dataMode = String(DASHBOARD.html_data_mode || 'cached').toLowerCase();
        if (dataMode === 'cached') {
          setLiveStatus('html_cached_snapshot');
        } else if (partialCount > 0) {
          const rawCapVal = Number(DASHBOARD.html_live_max_features || 0);
          const capVal = rawCapVal > 0 ? rawCapVal : 2500;
          setLiveStatus('html_live_partial', { count: connectedCount, total: wfsServices.length, cap: capVal });
        } else {
          setLiveStatus('html_wfs_connected', { count: connectedCount, total: wfsServices.length });
        }
        if (anyReplaced || !hadInitial) {
          buildSlicers();
          renderAll({ skipAutoZoom: !ropts.autoZoom });
        }
      } else {
        setLiveStatus('html_cached_snapshot');
        if (!hadInitial && !ropts.silent) {
          buildSlicers();
          renderAll({ skipAutoZoom: true });
        }
      }
      return connectedCount;
    }

    function initAutoRefreshTimer() {
      if (AUTO_REFRESH_TIMER && typeof clearInterval === 'function') {
        clearInterval(AUTO_REFRESH_TIMER);
        AUTO_REFRESH_TIMER = null;
      }
      const mode = String(DASHBOARD.html_data_mode || 'live').toLowerCase();
      if (mode === 'cached') return;
      const dashSec = Number(DASHBOARD.html_auto_refresh_seconds || 0);
      const svcMaxSec = (BUNDLE.ogc_services || []).reduce((acc, s) => Math.max(acc, Number((s && s.auto_refresh_seconds) || 0)), 0);
      const sec = dashSec > 0 ? dashSec : svcMaxSec;
      if (Number.isFinite(sec) && sec >= 10 && typeof setInterval === 'function') {
        AUTO_REFRESH_TIMER = setInterval(() => {
          refreshLiveWfs({ force: true, silent: true });
        }, Math.round(sec * 1000));
      }
    }

    function normalizeWidgetSourceId(sid) {
      const s = String(sid || '');
      return s.replace(/^tbl_/, '').replace(/__pane_\d+$/, '');
    }

    function getConnectionsFrom(sourceId) {
      const allConns = DASHBOARD.widget_connections || [];
      const norm = normalizeWidgetSourceId(sourceId);
      return allConns.filter(c => c && c.enabled !== false && c.target_id && (c.source_id === sourceId || normalizeWidgetSourceId(c.source_id) === norm));
    }

    function mapTargetIdSet() {
      const s = new Set(['__map__']);
      (DASHBOARD.widgets || []).forEach(w => {
        if (w && w.widget_type === 'map' && w.id) s.add(w.id);
      });
      return s;
    }

    const _CROSS_LAYER_FID_CACHE = new Map();

    function _bboxOverlaps2D(a, b) {
      if (!a || !b) return false;
      return !(a[2] < b[0] || a[0] > b[2] || a[3] < b[1] || a[1] > b[3]);
    }

    function _bboxToPolyGeom(bb) {
      if (!bb || bb.length !== 4) return null;
      if (Math.abs(bb[2] - bb[0]) <= 1e-12 && Math.abs(bb[3] - bb[1]) <= 1e-12) {
        return { type: 'Point', coordinates: [bb[0], bb[1]] };
      }
      return {
        type: 'Polygon',
        coordinates: [[[bb[0], bb[1]], [bb[2], bb[1]], [bb[2], bb[3]], [bb[0], bb[3]], [bb[0], bb[1]]]]
      };
    }

    function _segIntersects2D(ax1, ay1, ax2, ay2, bx1, by1, bx2, by2) {
      if (Math.max(ax1, ax2) < Math.min(bx1, bx2) || Math.max(bx1, bx2) < Math.min(ax1, ax2)) return false;
      if (Math.max(ay1, ay2) < Math.min(by1, by2) || Math.max(by1, by2) < Math.min(ay1, ay2)) return false;
      const orient = (px, py, qx, qy, rx, ry) => (qx - px) * (ry - py) - (qy - py) * (rx - px);
      const d1 = orient(bx1, by1, bx2, by2, ax1, ay1);
      const d2 = orient(bx1, by1, bx2, by2, ax2, ay2);
      const d3 = orient(ax1, ay1, ax2, ay2, bx1, by1);
      const d4 = orient(ax1, ay1, ax2, ay2, bx2, by2);
      if (((d1 > 0 && d2 < 0) || (d1 < 0 && d2 > 0)) && ((d3 > 0 && d4 < 0) || (d3 < 0 && d4 > 0))) return true;
      const eps = 1e-12;
      const onSeg = (px, py, qx, qy, rx, ry) =>
        qx >= Math.min(px, rx) - eps && qx <= Math.max(px, rx) + eps &&
        qy >= Math.min(py, ry) - eps && qy <= Math.max(py, ry) + eps;
      if (Math.abs(d1) <= eps && onSeg(bx1, by1, ax1, ay1, bx2, by2)) return true;
      if (Math.abs(d2) <= eps && onSeg(bx1, by1, ax2, ay2, bx2, by2)) return true;
      if (Math.abs(d3) <= eps && onSeg(ax1, ay1, bx1, by1, ax2, ay2)) return true;
      if (Math.abs(d4) <= eps && onSeg(ax1, ay1, bx2, by2, ax2, ay2)) return true;
      return false;
    }

    function _extractPtsFromGeom(geom) {
      if (!geom || !geom.coordinates) return [];
      if (geom.type === 'Point') return [[Number(geom.coordinates[0]), Number(geom.coordinates[1])]];
      if (geom.type === 'MultiPoint') return geom.coordinates.map(c => [Number(c[0]), Number(c[1])]);
      return [];
    }

    function _extractLinesFromGeom(geom) {
      if (!geom || !geom.coordinates) return [];
      if (geom.type === 'LineString') return [geom.coordinates];
      if (geom.type === 'MultiLineString') return geom.coordinates;
      return [];
    }

    function geomIntersectsGeom(g1, g2) {
      if (!g1 || !g2) return false;
      const b1 = geomBbox(g1), b2 = geomBbox(g2);
      if (!b1 || !b2 || !_bboxOverlaps2D(b1, b2)) return false;
      if (g1.type === 'GeometryCollection') return (g1.geometries || []).some(s => geomIntersectsGeom(s, g2));
      if (g2.type === 'GeometryCollection') return (g2.geometries || []).some(s => geomIntersectsGeom(g1, s));

      const p1 = g1.type === 'Polygon' ? [g1.coordinates] : (g1.type === 'MultiPolygon' ? g1.coordinates : []);
      const p2 = g2.type === 'Polygon' ? [g2.coordinates] : (g2.type === 'MultiPolygon' ? g2.coordinates : []);
      if (p1.length && p2.length) {
        for (const poly1 of p1) {
          for (const ring of poly1) {
            for (const pt of ring) {
              if (pointInGeom(pt[0], pt[1], g2)) return true;
            }
          }
        }
        for (const poly2 of p2) {
          for (const ring of poly2) {
            for (const pt of ring) {
              if (pointInGeom(pt[0], pt[1], g1)) return true;
            }
          }
        }
        for (const poly1 of p1) {
          for (const r1 of poly1) {
            for (let i = 0; i < r1.length; i++) {
              const a1 = r1[i], a2 = r1[(i + 1) % r1.length];
              for (const poly2 of p2) {
                for (const r2 of poly2) {
                  for (let j = 0; j < r2.length; j++) {
                    const b1p = r2[j], b2p = r2[(j + 1) % r2.length];
                    if (_segIntersects2D(a1[0], a1[1], a2[0], a2[1], b1p[0], b1p[1], b2p[0], b2p[1])) return true;
                  }
                }
              }
            }
          }
        }
        return false;
      }
      const pts1 = _extractPtsFromGeom(g1), pts2 = _extractPtsFromGeom(g2);
      if (p1.length && pts2.length) return pts2.some(pt => pointInGeom(pt[0], pt[1], g1));
      if (p2.length && pts1.length) return pts1.some(pt => pointInGeom(pt[0], pt[1], g2));

      const ls1 = _extractLinesFromGeom(g1), ls2 = _extractLinesFromGeom(g2);
      if (p1.length && ls2.length) {
        for (const line of ls2) {
          for (const pt of line) if (pointInGeom(pt[0], pt[1], g1)) return true;
          for (let i = 0; i < line.length - 1; i++) {
            for (const poly1 of p1) {
              for (const r1 of poly1) {
                for (let j = 0; j < r1.length; j++) {
                  const c1 = r1[j], c2 = r1[(j + 1) % r1.length];
                  if (_segIntersects2D(line[i][0], line[i][1], line[i + 1][0], line[i + 1][1], c1[0], c1[1], c2[0], c2[1])) return true;
                }
              }
            }
          }
        }
        return false;
      }
      if (p2.length && ls1.length) return geomIntersectsGeom(g2, g1);
      if (ls1.length && ls2.length) {
        for (const l1 of ls1) {
          for (let i = 0; i < l1.length - 1; i++) {
            for (const l2 of ls2) {
              for (let j = 0; j < l2.length - 1; j++) {
                if (_segIntersects2D(l1[i][0], l1[i][1], l1[i + 1][0], l1[i + 1][1], l2[j][0], l2[j][1], l2[j + 1][0], l2[j + 1][1])) return true;
              }
            }
          }
        }
        return false;
      }
      return true;
    }

    function _filterRowMatchesAttr(row, flt, layerName) {
      if (!row || !flt) return true;
      if (flt.type === 'spatial_geom' || flt.type === 'spatial_bbox') {
        const shp = _rowSpatialShape(layerName || flt._targetLayer || '', row);
        if (!shp) return false;
        if (Array.isArray(flt.bbox) && flt.bbox.length === 4 && !_bboxOverlaps2D(shp.bbox, flt.bbox.map(Number))) return false;
        if (flt.geometry && typeof geomIntersectsGeom === 'function') {
          return geomIntersectsGeom(shp.geom, flt.geometry);
        }
        return true;
      }
      const val = row[flt.field_name];
      if (flt.type === 'category' && flt.values && flt.values.length) {
        return flt.values.map(String).includes(String(val));
      }
      if (flt.type === 'numeric_range') {
        const num = Number(val);
        if (val === null || val === undefined || val === '' || isNaN(num)) return false;
        if (flt.min !== null && flt.min !== undefined && num < flt.min) return false;
        if (flt.max !== null && flt.max !== undefined && num > flt.max) return false;
        return true;
      }
      if (flt.type === 'date_range') {
        if (val === null || val === undefined) return false;
        let sval = String(val).trim();
        if (!sval) return false;
        const minStr = (flt.min !== null && flt.min !== undefined) ? String(flt.min).trim() : '';
        const maxStr = (flt.max !== null && flt.max !== undefined) ? String(flt.max).trim() : '';
        if ((minStr.length === 10 || maxStr.length === 10) && sval.length >= 10) {
          sval = sval.slice(0, 10).replace('/', '-').replace('/', '-');
        }
        if (minStr && sval < minStr) return false;
        if (maxStr && sval > maxStr) return false;
        return true;
      }
      return true;
    }

    function _rowSpatialShape(ln, row) {
      if (!row) return null;
      const fidStr = (row._feature_id !== undefined && row._feature_id !== null) ? String(row._feature_id) : '';
      let geom = fidStr ? getFeatureGeometry(ln, fidStr) : null;
      let bb = null;
      if (Array.isArray(row._bbox) && row._bbox.length === 4) {
        bb = row._bbox.map(Number);
      } else if (fidStr) {
        bb = getFeatureBbox(ln, fidStr);
      }
      if (!bb && geom) bb = geomBbox(geom);
      if (!bb && row._lon !== undefined && row._lat !== undefined) {
        const x = Number(row._lon), y = Number(row._lat);
        if (Number.isFinite(x) && Number.isFinite(y)) bb = [x, y, x, y];
      }
      if (!bb) return null;
      if (!geom) geom = _bboxToPolyGeom(bb);
      return { geom, bbox: bb };
    }

    const _CROSS_LAYER_AREA_CACHE = new Map();

    function resolveCrossLayerResult(flt, layerName) {
      const srcLayer = flt && flt.layer_name ? String(flt.layer_name) : '';
      if (!srcLayer || !layerName || srcLayer === layerName || srcLayer === '__spatial__' || flt.type === 'spatial_geom' || flt.type === 'spatial_bbox') return null;
      const srcRecs = LAYER_RECORDS[srcLayer] || [];
      const tgtRecs = LAYER_RECORDS[layerName] || [];
      if (!srcRecs.length || !tgtRecs.length) return null;

      const srcGeomCount = Object.keys(LAYER_GEOMETRIES[srcLayer] || {}).length + Object.keys(LAYER_PYRAMID_LOD1[srcLayer] || {}).length;
      const tgtGeomCount = Object.keys(LAYER_GEOMETRIES[layerName] || {}).length + Object.keys(LAYER_PYRAMID_LOD1[layerName] || {}).length;
      const cacheKey = `${srcLayer}|${layerName}|${flt.field_name}|${flt.type}|${(flt.values || []).join(',')}|${flt.min ?? ''}|${flt.max ?? ''}|${srcRecs.length}|${tgtRecs.length}|${srcGeomCount}|${tgtGeomCount}`;
      if (_CROSS_LAYER_FID_CACHE.has(cacheKey)) {
        return {
          allowed: _CROSS_LAYER_FID_CACHE.get(cacheKey),
          clippedAreas: _CROSS_LAYER_AREA_CACHE.get(cacheKey) || null
        };
      }

      const matchingSrc = srcRecs.filter(r => _filterRowMatchesAttr(r, flt, srcLayer));
      if (!matchingSrc.length) {
        const hasSrcSpatial = srcGeomCount > 0 || srcRecs.slice(0, 25).some(r => r && ((r._lon !== undefined && r._lat !== undefined) || Array.isArray(r._bbox)));
        if (hasSrcSpatial) {
          const empty = new Set();
          _CROSS_LAYER_FID_CACHE.set(cacheKey, empty);
          return { allowed: empty, clippedAreas: null };
        }
        return null;
      }

      const srcHasPriaOv = srcRecs.slice(0, 40).some(r => r && r.overlap_pria_ha !== undefined);
      const tgtHasPriaOv = tgtRecs.slice(0, 40).some(r => r && r.overlap_pria_ha !== undefined);
      const srcIsPria = srcRecs.slice(0, 40).some(r => r && (r.parandniidu_tyyp !== undefined || r.koosluse_grupp !== undefined));
      const tgtIsPria = tgtRecs.slice(0, 40).some(r => r && (r.parandniidu_tyyp !== undefined || r.koosluse_grupp !== undefined));

      // Case 1: Natura (or habitat layer with overlap_pria_ha) filtering PRIA meadows (#2 fix)
      if (srcHasPriaOv && tgtIsPria) {
        const ovSrc = matchingSrc.filter(r => Number((r && r.overlap_pria_ha) || 0) > 0);
        if (!ovSrc.length) {
          const empty = new Set();
          const emptyMap = new Map();
          _CROSS_LAYER_FID_CACHE.set(cacheKey, empty);
          _CROSS_LAYER_AREA_CACHE.set(cacheKey, emptyMap);
          return { allowed: empty, clippedAreas: emptyMap };
        }
        const allowed = new Set();
        const clippedAreas = new Map();
        const tgtByFid = new Map();
        const tgtShapes = [];
        for (const tr of tgtRecs) {
          const fidStr = (tr._feature_id !== undefined && tr._feature_id !== null) ? String(tr._feature_id) : '';
          if (fidStr) tgtByFid.set(fidStr, tr);
          const shp = _rowSpatialShape(layerName, tr);
          if (shp && fidStr) tgtShapes.push({ fid: fidStr, rec: tr, shp });
        }
        for (const sr of ovSrc) {
          const ovHa = Number(sr.overlap_pria_ha || 0);
          if (Array.isArray(sr._pria_ov) && sr._pria_ov.length) {
            for (const pair of sr._pria_ov) {
              if (!Array.isArray(pair) || pair.length < 2) continue;
              const pfid = String(pair[0]);
              const pha = Number(pair[1] || 0);
              if (pha <= 0) continue;
              const tRec = tgtByFid.get(pfid);
              const maxT = tRec ? Number(tRec._geom_area_ha ?? tRec.area_ha ?? pha) : pha;
              allowed.add(pfid);
              clippedAreas.set(pfid, Math.min(maxT, (clippedAreas.get(pfid) || 0) + pha));
            }
            continue;
          }
          const sFidStr = (sr._feature_id !== undefined && sr._feature_id !== null) ? String(sr._feature_id) : '';
          const sHasRealGeom = Boolean(sFidStr && getFeatureGeometry(srcLayer, sFidStr));
          const sShp = _rowSpatialShape(srcLayer, sr);
          if (!sShp) continue;
          const bboxCands = tgtShapes.filter(t => _bboxOverlaps2D(sShp.bbox, t.shp.bbox));
          let hits = [];
          if (sHasRealGeom) {
            hits = bboxCands.filter(t => geomIntersectsGeom(sShp.geom, t.shp.geom));
          } else {
            hits = bboxCands.filter(t => geomIntersectsGeom(sShp.geom, t.shp.geom));
            if (hits.length > 1) {
              const scx = (sShp.bbox[0] + sShp.bbox[2]) * 0.5;
              const scy = (sShp.bbox[1] + sShp.bbox[3]) * 0.5;
              hits.sort((a, b) => {
                const ax = (a.shp.bbox[0] + a.shp.bbox[2]) * 0.5 - scx;
                const ay = (a.shp.bbox[1] + a.shp.bbox[3]) * 0.5 - scy;
                const bx = (b.shp.bbox[0] + b.shp.bbox[2]) * 0.5 - scx;
                const by = (b.shp.bbox[1] + b.shp.bbox[3]) * 0.5 - scy;
                return (ax * ax + ay * ay) - (bx * bx + by * by);
              });
            }
          }
          const chosen = hits.length ? hits : bboxCands.slice(0, 1);
          if (!chosen.length) continue;
          const shareHa = ovHa / chosen.length;
          for (const ch of chosen) {
            const maxT = Number(ch.rec._geom_area_ha ?? ch.rec.area_ha ?? ovHa);
            allowed.add(ch.fid);
            clippedAreas.set(ch.fid, Math.min(maxT, (clippedAreas.get(ch.fid) || 0) + shareHa));
          }
        }
        _CROSS_LAYER_FID_CACHE.set(cacheKey, allowed);
        _CROSS_LAYER_AREA_CACHE.set(cacheKey, clippedAreas);
        return { allowed, clippedAreas };
      }

      const srcShapes = [];
      for (const sr of matchingSrc) {
        const shp = _rowSpatialShape(srcLayer, sr);
        if (shp) srcShapes.push(shp);
      }
      if (!srcShapes.length) return null;

      let u0 = Infinity, u1 = Infinity, u2 = -Infinity, u3 = -Infinity;
      for (const s of srcShapes) {
        if (s.bbox[0] < u0) u0 = s.bbox[0];
        if (s.bbox[1] < u1) u1 = s.bbox[1];
        if (s.bbox[2] > u2) u2 = s.bbox[2];
        if (s.bbox[3] > u3) u3 = s.bbox[3];
      }
      const unionBb = [u0, u1, u2, u3];

      let sawTgtSpatial = false;
      const allowed = new Set();
      const clippedAreas = (tgtHasPriaOv && srcIsPria) ? new Map() : null;
      const srcFidsSet = new Set(matchingSrc.map(r => String(r._feature_id ?? '')).filter(Boolean));
      const ovFieldForSrc = (tgtHasPriaOv && srcIsPria)
        ? (matchingSrc.every(r => String(r.koosluse_grupp || r.parandniidu_tyyp || '').startsWith('MN'))
            ? 'overlap_mn_ha'
            : (matchingSrc.every(r => String(r.koosluse_grupp || r.parandniidu_tyyp || '').startsWith('PN')) ? 'overlap_pn_ha' : 'overlap_pria_ha'))
        : 'overlap_pria_ha';

      for (const tr of tgtRecs) {
        const fidStr = (tr._feature_id !== undefined && tr._feature_id !== null) ? String(tr._feature_id) : '';
        if (tgtHasPriaOv && srcIsPria) {
          const trOv = Number(tr[ovFieldForSrc] ?? tr.overlap_pria_ha ?? 0);
          if (trOv <= 0) {
            sawTgtSpatial = true;
            continue;
          }
          if (Array.isArray(tr._pria_ov) && tr._pria_ov.length) {
            sawTgtSpatial = true;
            let matchedOv = 0;
            for (const pair of tr._pria_ov) {
              if (Array.isArray(pair) && srcFidsSet.has(String(pair[0]))) {
                matchedOv += Number(pair[1] || 0);
              }
            }
            if (matchedOv > 0 && fidStr) {
              allowed.add(fidStr);
              if (clippedAreas) clippedAreas.set(fidStr, Math.min(Number(tr._geom_area_ha ?? tr.area_ha ?? trOv), matchedOv));
            }
            continue;
          }
        }
        const tShp = _rowSpatialShape(layerName, tr);
        if (!tShp) continue;
        sawTgtSpatial = true;
        if (!_bboxOverlaps2D(tShp.bbox, unionBb)) continue;
        for (const sShp of srcShapes) {
          if (_bboxOverlaps2D(sShp.bbox, tShp.bbox) && geomIntersectsGeom(sShp.geom, tShp.geom)) {
            if (fidStr) {
              allowed.add(fidStr);
              if (clippedAreas) {
                const ovV = Number(tr[ovFieldForSrc] ?? tr.overlap_pria_ha ?? 0);
                clippedAreas.set(fidStr, Math.min(Number(tr._geom_area_ha ?? tr.area_ha ?? ovV), ovV));
              }
            }
            break;
          }
        }
      }
      if (!sawTgtSpatial) return null;
      _CROSS_LAYER_FID_CACHE.set(cacheKey, allowed);
      if (clippedAreas) _CROSS_LAYER_AREA_CACHE.set(cacheKey, clippedAreas);
      return { allowed, clippedAreas };
    }

    function resolveCrossLayerAllowedFids(flt, layerName) {
      const res = resolveCrossLayerResult(flt, layerName);
      return res ? res.allowed : null;
    }

    function shouldFilterApply(srcId, flt, targetWidgetId, layerName) {
      const outgoing = getConnectionsFrom(srcId);
      const targetWidget = targetWidgetId
        ? (targetWidgetId === '__map__'
            ? (DASHBOARD.widgets || []).find(w => w.widget_type === 'map')
            : (DASHBOARD.widgets || []).find(w => w.id === targetWidgetId))
        : null;
      const normSrc = normalizeWidgetSourceId(srcId);
      const srcItem = (DASHBOARD.widgets || []).concat(DASHBOARD.slicers || []).find(it => it && it.id === normSrc);
      const fltIsGlobal = Boolean(flt && flt.is_global) || Boolean(srcItem && srcItem.is_global);
      const fltPageId = (flt && flt.page_id) || (srcItem && srcItem.page_id) || '';
      if (targetWidget && fltPageId && !fltIsGlobal) {
        const tgtPageId = String(targetWidget.page_id || 'page_1');
        if (String(fltPageId) !== tgtPageId) {
          const mSet = mapTargetIdSet();
          const hasExplicitConn = targetWidgetId === '__map__'
            ? outgoing.some(c => mSet.has(c.target_id) && c.action !== 'zoom_only')
            : outgoing.some(c => c.target_id === targetWidgetId && c.action !== 'zoom_only');
          if (!hasExplicitConn) return false;
        }
      }
      const isSpatialFlt = Boolean(flt && (flt.layer_name === '__spatial__' || flt.type === 'spatial_geom' || flt.type === 'spatial_bbox'));
      if (outgoing.length > 0 && targetWidgetId) {
        if (targetWidgetId === '__map__') {
          const mSet = mapTargetIdSet();
          const mapConns = outgoing.filter(c => mSet.has(c.target_id) && c.action !== 'zoom_only');
          if (!mapConns.length) return false;
          if (isSpatialFlt) return true;
          if (flt.layer_name && layerName && flt.layer_name !== layerName) {
            if (resolveCrossLayerAllowedFids(flt, layerName) !== null) return true;
            const recs = LAYER_RECORDS[layerName] || [];
            return recs.some(r => r && r[flt.field_name] !== undefined);
          }
          return true;
        }
        return outgoing.some(c => c.target_id === targetWidgetId && c.action !== 'zoom_only');
      }
      if (isSpatialFlt) return true;
      if (flt.layer_name && layerName && flt.layer_name !== layerName) return false;
      return true;
    }

    function filterRecords(layerName, excludeSourceId, targetWidgetId) {
      const all = LAYER_RECORDS[layerName] || Object.values(LAYER_RECORDS)[0] || [];
      let bounds = null;
      if (EXTENT_FILTER_ENABLED && map) {
        bounds = map.getBounds();
      }
      const directFilters = [];
      const crossAllowedSets = [];
      const crossClippedMaps = [];
      const exNorm = excludeSourceId ? normalizeWidgetSourceId(excludeSourceId) : '';
      for (const [srcId, flt] of Object.entries(ACTIVE_FILTERS)) {
        if (excludeSourceId && (srcId === excludeSourceId || normalizeWidgetSourceId(srcId) === exNorm)) continue;
        if (!shouldFilterApply(srcId, flt, targetWidgetId, layerName)) continue;
        const isSpatialFlt = Boolean(flt && (flt.layer_name === '__spatial__' || flt.type === 'spatial_geom' || flt.type === 'spatial_bbox'));
        if (!isSpatialFlt && flt.layer_name && layerName && flt.layer_name !== layerName) {
          const cres = resolveCrossLayerResult(flt, layerName);
          if (cres && cres.allowed !== null) {
            crossAllowedSets.push(cres.allowed);
            if (cres.clippedAreas && cres.clippedAreas.size > 0) crossClippedMaps.push(cres.clippedAreas);
            continue;
          }
        }
        directFilters.push(flt);
      }
      const matched = all.filter(row => {
        if (bounds && row._lat !== undefined && row._lon !== undefined) {
          if (!bounds.contains([Number(row._lat), Number(row._lon)])) return false;
        }
        if (crossAllowedSets.length) {
          const fidStr = (row._feature_id !== undefined && row._feature_id !== null) ? String(row._feature_id) : '';
          if (!fidStr || crossAllowedSets.some(setObj => !setObj.has(fidStr))) return false;
        }
        for (const flt of directFilters) {
          if (!_filterRowMatchesAttr(row, flt, layerName)) return false;
        }
        return true;
      });
      if (crossClippedMaps.length && targetWidgetId !== '__map__') {
        return matched.map(row => {
          const fidStr = (row._feature_id !== undefined && row._feature_id !== null) ? String(row._feature_id) : '';
          const origHa = Number(row._geom_area_ha ?? row.area_ha ?? 0);
          let clipHa = origHa;
          for (const cmap of crossClippedMaps) {
            if (cmap.has(fidStr)) clipHa = Math.min(clipHa, Number(cmap.get(fidStr)));
          }
          if (!Number.isFinite(clipHa) || clipHa === origHa) return row;
          return Object.assign({}, row, { _geom_area_ha: clipHa, area_ha: clipHa });
        });
      }
      return matched;
    }

    function computeMetric(vals, agg) {
      const mode = (agg || 'count').toLowerCase();
      if (mode === 'count') return vals.length;
      if (mode === 'distinct_count') {
        return new Set(vals.filter(v => v !== null && v !== undefined && v !== '').map(String)).size;
      }
      const nums = vals.map(v => Number(v)).filter(n => !isNaN(n));
      if (!nums.length) return 0;
      const sum = nums.reduce((a, b) => a + b, 0);
      if (mode === 'sum') return sum;
      if (mode === 'avg' || mode === 'mean') return sum / nums.length;
      if (mode === 'min') return Math.min(...nums);
      if (mode === 'max') return Math.max(...nums);
      if (mode === 'median') {
        const s = [...nums].sort((a, b) => a - b);
        const mid = Math.floor(s.length / 2);
        return s.length % 2 !== 0 ? s[mid] : (s[mid - 1] + s[mid]) / 2;
      }
      return vals.length;
    }

    function resolveFieldVal(row, fieldName) {
      if (!row || !fieldName) return null;
      const fnLower = String(fieldName).trim().toLowerCase();
      if (
        fieldName === '__calc_count__'
        || fnLower === 'calculate count'
        || fnLower === 'kirjete arv'
      ) {
        return 1;
      }
      if (
        fieldName === '__calc_area_ha__'
        || fnLower === 'calculate area (ha)'
        || fnLower === 'arvuta pindala (ha)'
      ) {
        const candidates = ['_geom_area_ha', 'area_ha', 'pindala_ha', 'natura_overlap_ha', 'pria_overlap_ha', 'pindala', 'shape_area'];
        for (const key of candidates) {
          const v = row[key];
          if (v !== null && v !== undefined && v !== '' && !isNaN(Number(v))) {
            const n = Number(v);
            return (key === 'pindala' || key === 'shape_area') ? n / 10000.0 : n;
          }
        }
        return 0;
      }
      return row[fieldName];
    }

    function friendlyFieldLabel(fieldName) {
      if (fieldName === '__calc_area_ha__') return CURR_LANG === 'et' ? 'Pindala (ha)' : 'Area (ha)';
      if (fieldName === '__calc_count__') return CURR_LANG === 'et' ? 'Kirjete arv' : 'Record Count';
      return fieldName;
    }

    function widgetFieldLabel(w, fieldName) {
      const aliases = (w && w.field_aliases && typeof w.field_aliases === 'object') ? w.field_aliases : null;
      if (aliases && fieldName) {
        const custom = aliases[fieldName];
        if (custom !== undefined && custom !== null && String(custom).trim() !== '') {
          return String(custom).trim();
        }
      }
      return friendlyFieldLabel(fieldName);
    }

    function transposeTableMatrix(headers, matrix, cornerLabel) {
      if (!headers || !headers.length) return { headers: [], rows: [], isPivot: false };
      const rowLabels = matrix.map((r, i) => (r && r.length) ? String(r[0]) : String(i + 1));
      const newHeaders = [cornerLabel || (CURR_LANG === 'et' ? 'Väli' : 'Field'), ...rowLabels];
      const newRows = [];
      for (let c = 1; c < headers.length; c++) {
        const line = [headers[c]];
        matrix.forEach(r => line.push((c < r.length) ? r[c] : ''));
        newRows.push(line);
      }
      if (headers.length === 1 && matrix.length) {
        const line = [headers[0]];
        matrix.forEach(r => line.push(r[0]));
        return { headers: [cornerLabel || '#', ...rowLabels], rows: [line], isPivot: false };
      }
      return { headers: newHeaders, rows: newRows, isPivot: false };
    }

    function resolveSpatialPivotRows(w, baseRows) {
      const joinName = w.spatial_join_layer;
      if (!joinName || !Array.isArray(baseRows) || !baseRows.length) return baseRows;
      const prefix = `[${joinName}] `;
      if (Object.keys(baseRows[0] || {}).some(k => k.startsWith(prefix))) return baseRows;

      const joinRecs = LAYER_RECORDS[joinName] || [];
      const baseGeoms = LAYER_GEOMETRIES[w.layer_name] || {};
      const joinGeoms = LAYER_GEOMETRIES[joinName] || {};
      const noOverlap = CURR_LANG === 'et' ? '(Kattuvus puudub)' : '(No overlap)';
      const joinIndex = [];
      joinRecs.forEach(jr => {
        const jfid = String(jr._feature_id ?? '');
        const g = jfid && (typeof getFeatureGeometry === 'function') ? getFeatureGeometry(joinName, jfid) : joinGeoms[jfid];
        const b = (jfid && (typeof getFeatureBbox === 'function') ? getFeatureBbox(joinName, jfid) : null) || geomBbox(g);
        if (b && g) joinIndex.push({ rec: jr, geom: g, bbox: b });
      });
      const joinKeys = joinRecs.length ? Object.keys(joinRecs[0]).filter(k => !k.startsWith('_')) : [];

      const out = [];
      const N = 10;
      const makeRow = (br, jr, haVal) => {
        const merged = Object.assign({}, br);
        joinKeys.forEach(jk => {
          merged[`${prefix}${jk}`] = jr ? jr[jk] : noOverlap;
        });
        merged._geom_area_ha = haVal;
        merged.area_ha = haVal;
        return merged;
      };

      baseRows.forEach(br => {
        const bfid = String(br._feature_id ?? '');
        const g = bfid && (typeof getFeatureGeometry === 'function') ? getFeatureGeometry(w.layer_name, bfid) : baseGeoms[bfid];
        const b = (bfid && (typeof getFeatureBbox === 'function') ? getFeatureBbox(w.layer_name, bfid) : null) || geomBbox(g);
        const baseHa = Number(br._geom_area_ha ?? br.area_ha ?? 0);
        if (!b || !g || !joinIndex.length) {
          out.push(makeRow(br, null, baseHa));
          return;
        }
        const cands = joinIndex.filter(c => !(c.bbox[2] < b[0] || c.bbox[0] > b[2] || c.bbox[3] < b[1] || c.bbox[1] > b[3]));
        if (!cands.length) {
          out.push(makeRow(br, null, baseHa));
          return;
        }
        let inBase = 0;
        const candHits = new Array(cands.length).fill(0);
        let anyHit = 0;
        const dx = (b[2] - b[0]) / N, dy = (b[3] - b[1]) / N;
        for (let ix = 0; ix < N; ix++) {
          const px = b[0] + (ix + 0.5) * dx;
          for (let iy = 0; iy < N; iy++) {
            const py = b[1] + (iy + 0.5) * dy;
            if (!pointInGeom(px, py, g)) continue;
            inBase++;
            let matchedThisPt = false;
            for (let ci = 0; ci < cands.length; ci++) {
              const c = cands[ci];
              if (px >= c.bbox[0] && px <= c.bbox[2] && py >= c.bbox[1] && py <= c.bbox[3] && pointInGeom(px, py, c.geom)) {
                candHits[ci]++;
                matchedThisPt = true;
              }
            }
            if (matchedThisPt) anyHit++;
          }
        }
        if (!inBase) {
          out.push(makeRow(br, cands[0].rec, baseHa));
          return;
        }
        let totalMatched = 0;
        for (let ci = 0; ci < cands.length; ci++) {
          if (candHits[ci] > 0) {
            const fracHa = Math.round(((candHits[ci] / inBase) * baseHa) * 10000) / 10000;
            out.push(makeRow(br, cands[ci].rec, fracHa));
            totalMatched += candHits[ci];
          }
        }
        if (anyHit === 0 && totalMatched === 0) {
          out.push(makeRow(br, null, baseHa));
        } else if (anyHit < inBase) {
          const remHa = Math.max(0, Math.round((((inBase - anyHit) / inBase) * baseHa) * 10000) / 10000);
          if (remHa > 0.0001) out.push(makeRow(br, null, remHa));
        }
      });
      return out;
    }

    function computeTableData(w, rawRows) {
      const rows = resolveSpatialPivotRows(w, rawRows);
      const mode = w.table_mode || ((w.pivot_rows && w.pivot_rows.length) || (w.pivot_values && w.pivot_values.length) ? 'pivot' : 'detail');
      const transpose = !!w.table_transpose;
      if (mode !== 'pivot') {
        const cols = (w.table_columns && w.table_columns.length)
          ? w.table_columns
          : Object.keys(rows[0] || {}).filter(k => !k.startsWith('_')).slice(0, 8);
        const headers = cols.map(c => widgetFieldLabel(w, c));
        const matrix = rows.slice(0, 120).map(r => cols.map(c => resolveFieldVal(r, c)));
        const fids = rows.slice(0, 120).map(r => ({
          fid: r._feature_id ?? '',
          lat: r._lat ?? '',
          lon: r._lon ?? '',
          bbox: Array.isArray(r._bbox) ? r._bbox : null
        }));
        if (transpose) {
          const trRes = transposeTableMatrix(headers, matrix, CURR_LANG === 'et' ? 'Veerg' : 'Column');
          return { ...trRes, rowMeta: [], transposed: true };
        }
        return { headers, rows: matrix, rowMeta: fids, isPivot: false, transposed: false };
      }

      const pRows = (w.pivot_rows && w.pivot_rows.length) ? w.pivot_rows : (w.category_field ? [w.category_field] : []);
      const pCols = w.pivot_cols || [];
      let pVals = (w.pivot_values && w.pivot_values.length) ? w.pivot_values : [];
      if (!pVals.length) {
        pVals = [{ field: w.value_field || '__calc_area_ha__', agg: w.aggregation || 'sum' }];
      }
      const rowHeaderLabel = pRows.length ? pRows.map(f => widgetFieldLabel(w, f)).join(' / ') : (CURR_LANG === 'et' ? 'Kategooria' : 'Category');
      const rowKey = r => pRows.length ? pRows.map(f => {
        const v = resolveFieldVal(r, f);
        return (v !== null && v !== undefined && String(v).trim() !== '') ? String(v) : (CURR_LANG === 'et' ? '(Määramata)' : '(Unassigned)');
      }).join(' / ') : (CURR_LANG === 'et' ? 'Kokku' : 'All');

      const aggName = a => ({ sum: 'Σ', count: '#', distinct_count: 'U', avg: 'μ', min: 'Min', max: 'Max', median: 'Med' }[a] || a);
      const valLabel = sp => {
        const aliases = (w && w.field_aliases && typeof w.field_aliases === 'object') ? w.field_aliases : {};
        const agg = sp.agg || 'sum';
        const fld = sp.field || '';
        const mKey = `${agg}:${fld}`;
        if (sp.label && String(sp.label).trim() !== '') return String(sp.label).trim();
        if (aliases[mKey] && String(aliases[mKey]).trim() !== '') return String(aliases[mKey]).trim();
        const defLbl = `${aggName(agg)} ${friendlyFieldLabel(fld)}`;
        if (aliases[defLbl] && String(aliases[defLbl]).trim() !== '') return String(aliases[defLbl]).trim();
        return defLbl;
      };

      const rowBuckets = new Map();
      const colBuckets = new Map();
      const cellMap = new Map();
      const colSet = new Set();

      rows.forEach(r => {
        const rk = rowKey(r);
        if (!rowBuckets.has(rk)) rowBuckets.set(rk, []);
        rowBuckets.get(rk).push(r);
        if (pCols.length) {
          const ck = pCols.map(f => {
            const v = resolveFieldVal(r, f);
            return (v !== null && v !== undefined && String(v).trim() !== '') ? String(v) : '(Unassigned)';
          }).join(' / ');
          colSet.add(ck);
          if (!colBuckets.has(ck)) colBuckets.set(ck, []);
          colBuckets.get(ck).push(r);
          const cellKey = rk + '||' + ck;
          if (!cellMap.has(cellKey)) cellMap.set(cellKey, []);
          cellMap.get(cellKey).push(r);
        }
      });

      const rowKeys = Array.from(rowBuckets.keys());
      const colKeys = Array.from(colSet).sort();
      let headers = [rowHeaderLabel];
      if (colKeys.length) {
        colKeys.forEach(ck => pVals.forEach(sp => headers.push(pVals.length === 1 ? ck : `${ck} (${valLabel(sp)})`)));
      } else {
        pVals.forEach(sp => headers.push(valLabel(sp)));
      }

      const calcSpec = (subset, sp) => {
        const a = (sp.agg || 'sum').toLowerCase();
        const f = sp.field || '__calc_count__';
        if (a === 'count' && (f === '__calc_count__' || !f)) return subset.length;
        return computeMetric(subset.map(r => resolveFieldVal(r, f)), a);
      };

      const combinedRows = [];
      rowKeys.forEach(rk => {
        const line = [rk];
        const grp = rowBuckets.get(rk) || [];
        if (colKeys.length) {
          colKeys.forEach(ck => {
            const sub = cellMap.get(rk + '||' + ck) || [];
            pVals.forEach(sp => line.push(sub.length ? calcSpec(sub, sp) : 0));
          });
        } else {
          pVals.forEach(sp => line.push(calcSpec(grp, sp)));
        }
        combinedRows.push({
          line,
          meta: { filterField: pRows[0] || '', filterVal: rk }
        });
      });
      combinedRows.sort((a, b) => (Number(b.line[1]) || 0) - (Number(a.line[1]) || 0));
      const matrix = combinedRows.map(item => item.line);
      const rowMeta = combinedRows.map(item => item.meta);

      if (w.table_show_totals !== false && matrix.length) {
        const totLbl = CURR_LANG === 'et' ? 'Kokku' : 'Total';
        const totRow = [totLbl];
        if (colKeys.length) {
          colKeys.forEach(ck => {
            const csub = colBuckets.get(ck) || [];
            pVals.forEach(sp => totRow.push(calcSpec(csub, sp)));
          });
        } else {
          pVals.forEach(sp => totRow.push(calcSpec(rows, sp)));
        }
        matrix.push(totRow);
        rowMeta.push({ isTotal: true });
      }

      if (transpose) {
        const trRes = transposeTableMatrix(headers, matrix, rowHeaderLabel);
        return { ...trRes, rowMeta: [], transposed: true };
      }
      return { headers, rows: matrix, rowMeta, isPivot: true, transposed: false };
    }

    function toggleTableTranspose(wid) {
      const w = (DASHBOARD.widgets || []).find(x => x.id === wid);
      if (w) {
        w.table_transpose = !w.table_transpose;
        renderAll();
      }
    }

    function triggerRenderWithBusyFeedback(opts) {
      beginMapRenderLoader(t('map_rendering_layers'));
      const run = () => {
        try {
          renderAll(opts);
        } finally {
          endMapRenderLoader(false);
        }
      };
      if (typeof requestAnimationFrame === 'function') {
        requestAnimationFrame(() => {
          setTimeout(run, 12);
        });
      } else {
        run();
      }
    }

    function _sessionStorageKey() {
      try {
        if (typeof window !== 'undefined' && window.location) {
          const dashId = (typeof DASHBOARD !== 'undefined' && DASHBOARD && DASHBOARD.id)
            ? String(DASHBOARD.id)
            : '';
          return 'qdash_state:' + String(window.location.pathname || '') + '|' + dashId;
        }
      } catch (_e) {}
      return '';
    }

    function saveDashboardSessionState() {
      try {
        const key = _sessionStorageKey();
        if (!key || typeof window === 'undefined' || !window.sessionStorage) return;
        let view = null;
        if (map && typeof map.getCenter === 'function' && typeof map.getZoom === 'function') {
          const c = map.getCenter();
          if (c && Number.isFinite(Number(c.lat)) && Number.isFinite(Number(c.lng))) {
            view = { lat: Number(c.lat), lng: Number(c.lng), zoom: Number(map.getZoom()) };
          }
        }
        window.sessionStorage.setItem(key, JSON.stringify({
          filters: ACTIVE_FILTERS,
          extent: Boolean(EXTENT_FILTER_ENABLED),
          activePageId: ACTIVE_PAGE_ID,
          view: view
        }));
      } catch (_e) {}
    }

    function clearDashboardSessionState() {
      try {
        const key = _sessionStorageKey();
        if (key && typeof window !== 'undefined' && window.sessionStorage) {
          window.sessionStorage.removeItem(key);
        }
      } catch (_e) {}
    }

    function restoreDashboardSessionState() {
      try {
        const key = _sessionStorageKey();
        if (!key || typeof window === 'undefined' || !window.sessionStorage) return false;
        const raw = window.sessionStorage.getItem(key);
        if (!raw) return false;
        const st = JSON.parse(raw);
        if (!st || typeof st !== 'object') return false;
        if (st.filters && typeof st.filters === 'object') {
          Object.keys(ACTIVE_FILTERS).forEach(k => delete ACTIVE_FILTERS[k]);
          Object.entries(st.filters).forEach(([k, v]) => {
            if (v && typeof v === 'object') ACTIVE_FILTERS[k] = v;
          });
        }
        if (typeof st.extent === 'boolean') {
          EXTENT_FILTER_ENABLED = st.extent;
          updateExtentButtonUI();
        }
        if (st.activePageId && (DASHBOARD.pages || []).some(p => p.id === st.activePageId)) {
          ACTIVE_PAGE_ID = st.activePageId;
        }
        const hasConfiguredHome = Boolean(HOME_MAP_VIEW && Array.isArray(HOME_MAP_VIEW.bounds) && HOME_MAP_VIEW.bounds.length === 4);
        if (!hasConfiguredHome && st.view && map && Number.isFinite(Number(st.view.lat)) && Number.isFinite(Number(st.view.lng)) && Number.isFinite(Number(st.view.zoom))) {
          safeSetView([Number(st.view.lat), Number(st.view.lng)], Number(st.view.zoom));
          return true;
        }
        return Object.keys(ACTIVE_FILTERS).length > 0;
      } catch (_e) {
        return false;
      }
    }

    function toggleCategoryFilter(sourceId, layerName, fieldName, value, forceZoom) {
      const srcMeta = (DASHBOARD.widgets || []).concat(DASHBOARD.slicers || []).find(it => it && it.id === normalizeWidgetSourceId(sourceId));
      const pageId = srcMeta ? (srcMeta.page_id || ACTIVE_PAGE_ID) : ACTIVE_PAGE_ID;
      const isGlobal = Boolean(srcMeta && srcMeta.is_global);
      const cur = ACTIVE_FILTERS[sourceId];
      if (cur && cur.values && cur.values.includes(String(value))) {
        cur.values = cur.values.filter(v => v !== String(value));
        if (!cur.values.length) {
          delete ACTIVE_FILTERS[sourceId];
          if (LAST_INTERACTED_FILTER_SOURCE === sourceId) LAST_INTERACTED_FILTER_SOURCE = null;
        } else {
          LAST_INTERACTED_FILTER_SOURCE = sourceId;
        }
      } else if (cur && cur.multi) {
        cur.values.push(String(value));
        LAST_INTERACTED_FILTER_SOURCE = sourceId;
      } else {
        ACTIVE_FILTERS[sourceId] = {
          layer_name: layerName,
          field_name: fieldName,
          type: 'category',
          multi: Boolean(cur && cur.multi),
          values: [String(value)],
          page_id: pageId,
          is_global: isGlobal
        };
        LAST_INTERACTED_FILTER_SOURCE = sourceId;
      }
      saveDashboardSessionState();
      if (srcMeta && srcMeta.drill_to_page_id && ACTIVE_FILTERS[sourceId]) {
        switchDashboardPage(srcMeta.drill_to_page_id, { skipRender: true });
      }
      buildSlicers();
      if (typeof renderActiveFiltersBanner === 'function') renderActiveFiltersBanner();
      triggerRenderWithBusyFeedback({ forceZoom: Boolean(forceZoom) });
    }

    function clearWidgetFilter(widgetOrSlicerId) {
      const baseId = normalizeWidgetSourceId(widgetOrSlicerId);
      let removed = false;
      Object.keys(ACTIVE_FILTERS).forEach(k => {
        if (k === widgetOrSlicerId || k === baseId || normalizeWidgetSourceId(k) === baseId || k.startsWith(baseId + '__pane_')) {
          delete ACTIVE_FILTERS[k];
          removed = true;
        }
      });
      if (LAST_INTERACTED_FILTER_SOURCE && normalizeWidgetSourceId(LAST_INTERACTED_FILTER_SOURCE) === baseId) {
        LAST_INTERACTED_FILTER_SOURCE = null;
      }
      if (widgetOrSlicerId === '__map_addr__') {
        clearAddressSearchResult();
        return;
      }
      if (removed) {
        saveDashboardSessionState();
        buildSlicers();
        if (typeof renderActiveFiltersBanner === 'function') renderActiveFiltersBanner();
        triggerRenderWithBusyFeedback({ skipAutoZoom: true });
      }
    }

    function clearAllFilters() {
      Object.keys(ACTIVE_FILTERS).forEach(k => delete ACTIVE_FILTERS[k]);
      LAST_INTERACTED_FILTER_SOURCE = null;
      if (ADDRESS_RESULT_LAYER && map && map.hasLayer && map.hasLayer(ADDRESS_RESULT_LAYER)) {
        map.removeLayer(ADDRESS_RESULT_LAYER);
      }
      ADDRESS_RESULT_LAYER = null;
      const addrInp = document.getElementById('map-addr-input');
      if (addrInp) addrInp.value = '';
      saveDashboardSessionState();
      buildSlicers();
      if (typeof renderActiveFiltersBanner === 'function') renderActiveFiltersBanner();
      triggerRenderWithBusyFeedback();
    }

    function _formatFilterSummaryText(flt) {
      if (!flt) return '';
      if (flt.display_label) return `${flt.field_name || ''}: ${flt.display_label}`.replace(/^:\s*/, '');
      if (flt.type === 'category' && Array.isArray(flt.values) && flt.values.length) {
        const vals = flt.values.slice(0, 3).join(', ') + (flt.values.length > 3 ? ` (+${flt.values.length - 3})` : '');
        return `${friendlyFieldLabel(flt.field_name)}: ${vals}`;
      }
      if (flt.type === 'numeric_range' || flt.type === 'date_range') {
        const lo = (flt.min !== null && flt.min !== undefined && flt.min !== '') ? flt.min : '…';
        const hi = (flt.max !== null && flt.max !== undefined && flt.max !== '') ? flt.max : '…';
        return `${friendlyFieldLabel(flt.field_name)}: ${lo} – ${hi}`;
      }
      if (flt.type === 'spatial_geom' || flt.type === 'spatial_bbox') {
        return flt.display_label || t('addr_search_btn');
      }
      return flt.field_name || '';
    }

    function _getIncomingFilterBadgeText(targetWidgetId, layerName) {
      const labels = [];
      for (const [srcId, flt] of Object.entries(ACTIVE_FILTERS)) {
        if (normalizeWidgetSourceId(srcId) === normalizeWidgetSourceId(targetWidgetId)) continue;
        if (!shouldFilterApply(srcId, flt, targetWidgetId, layerName)) continue;
        const txt = _formatFilterSummaryText(flt);
        if (txt && !labels.includes(txt)) labels.push(txt);
      }
      if (!labels.length) return '';
      const head = labels.slice(0, 2).join('; ');
      const suffix = labels.length > 2 ? ` (+${labels.length - 2})` : '';
      return `⚡ ${t('filter_badge_prefix')}: ${head}${suffix}`;
    }

    function renderActiveFiltersBanner() {
      const bar = document.getElementById('active-filters-bar');
      if (!bar) return;
      const entries = Object.entries(ACTIVE_FILTERS);
      if (!entries.length) {
        bar.classList.remove('visible');
        bar.innerHTML = '';
        return;
      }
      bar.classList.add('visible');
      bar.innerHTML = '';
      const lbl = document.createElement('span');
      lbl.style.fontWeight = '700';
      lbl.textContent = `⚡ ${t('active_filters_title')}:`;
      bar.appendChild(lbl);
      entries.forEach(([srcId, flt]) => {
        const chip = document.createElement('span');
        chip.className = 'active-filter-chip';
        const srcObj = (DASHBOARD.widgets || []).concat(DASHBOARD.slicers || []).find(it => it && it.id === normalizeWidgetSourceId(srcId));
        const srcPrefix = srcObj ? (localizedTitle(srcObj) + ' · ') : '';
        const txt = document.createElement('span');
        txt.textContent = srcPrefix + _formatFilterSummaryText(flt);
        const rmBtn = document.createElement('button');
        rmBtn.type = 'button';
        rmBtn.textContent = '✕';
        rmBtn.title = t('btn_clear_filter');
        rmBtn.onclick = () => clearWidgetFilter(srcId);
        chip.appendChild(txt);
        chip.appendChild(rmBtn);
        bar.appendChild(chip);
      });
      const clrAll = document.createElement('button');
      clrAll.type = 'button';
      clrAll.className = 'btn-mini-icon';
      clrAll.textContent = t('html_reset_filters');
      clrAll.onclick = () => clearAllFilters();
      bar.appendChild(clrAll);
    }

    function renderPagesBar() {
      const bar = document.getElementById('dashboard-pages-bar');
      if (!bar) return;
      const pages = Array.isArray(DASHBOARD.pages) ? DASHBOARD.pages : [];
      if (pages.length <= 1) {
        bar.classList.remove('visible');
        bar.innerHTML = '';
        return;
      }
      if (!pages.some(p => p.id === ACTIVE_PAGE_ID)) {
        ACTIVE_PAGE_ID = pages[0].id;
      }
      bar.classList.add('visible');
      bar.innerHTML = '';
      pages.forEach(pg => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'page-tab-btn' + (pg.id === ACTIVE_PAGE_ID ? ' active' : '');
        btn.textContent = (LANG === 'en' && pg.title_en) ? pg.title_en : (pg.title || pg.id);
        btn.onclick = () => switchDashboardPage(pg.id);
        bar.appendChild(btn);
      });
    }

    function switchDashboardPage(pageId, opts) {
      if (!pageId || ACTIVE_PAGE_ID === pageId) return;
      ACTIVE_PAGE_ID = String(pageId);
      saveDashboardSessionState();
      renderPagesBar();
      if (!(opts && opts.skipRender)) {
        buildSlicers();
        renderActiveFiltersBanner();
        renderAll({ skipAutoZoom: true });
        updateMobileNavBar();
      }
    }

    function isMobileCardStackActive() {
      return Boolean(MOBILE_VIEW_ENABLED && !MOBILE_FIT_OVERVIEW);
    }

    function syncMobileMapTouchLock() {
      const btn = document.getElementById('btn-mobile-map-lock');
      const canvas = document.getElementById('map-canvas');
      const activeLock = Boolean(isMobileCardStackActive() && MOBILE_MAP_LOCKED);
      if (canvas && canvas.classList) {
        canvas.classList.toggle('mobile-scroll-locked', activeLock);
      }
      if (map && map.dragging) {
        if (activeLock && typeof map.dragging.disable === 'function') {
          map.dragging.disable();
        } else if (!activeLock && typeof map.dragging.enable === 'function') {
          map.dragging.enable();
        }
      }
      if (btn) {
        btn.textContent = t(MOBILE_MAP_LOCKED ? 'mobile_map_lock' : 'mobile_map_unlock');
        btn.title = t('mobile_map_lock_tip');
        if (btn.classList) btn.classList.toggle('active', activeLock);
      }
    }

    function toggleMobileMapTouchLock() {
      MOBILE_MAP_LOCKED = !MOBILE_MAP_LOCKED;
      syncMobileMapTouchLock();
    }

    function toggleMobileView() {
      MOBILE_VIEW_ENABLED = !MOBILE_VIEW_ENABLED;
      MOBILE_VIEW_OVERRIDE = MOBILE_VIEW_ENABLED;
      if (MOBILE_VIEW_ENABLED) MOBILE_FIT_OVERVIEW = false;
      const ws = document.getElementById('workspace-main');
      if (ws) {
        ws.style.transform = '';
        ws.style.marginBottom = '';
      }
      if (typeof document !== 'undefined' && document.body && document.body.classList) {
        document.body.classList.toggle('mobile-view', isMobileCardStackActive());
      }
      const btn = document.getElementById('btn-mobile-view');
      if (btn) btn.textContent = MOBILE_VIEW_ENABLED ? t('mobile_view_active') : t('mobile_view_btn');
      applyArtboardLayout();

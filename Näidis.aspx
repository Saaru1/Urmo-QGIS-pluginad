          if (PREVIEW_WMS_RUN_OVERLAYS.length > runs.length) {
            IS_SYNCING_MAP_LAYERS += 1;
            try {
              for (let j = runs.length; j < PREVIEW_WMS_RUN_OVERLAYS.length; j++) {
                const oldOv = PREVIEW_WMS_RUN_OVERLAYS[j];
                if (oldOv && map.hasLayer(oldOv)) map.removeLayer(oldOv);
              }
            } finally {
              IS_SYNCING_MAP_LAYERS -= 1;
            }
          }
          PREVIEW_WMS_RUN_OVERLAYS = nextOverlays;
          PREVIEW_WMS_OVERLAY = nextOverlays[0] || null;
          PREVIEW_WMS_KEY = runs.map(r => r.layers.join(',')).join('|');
          PREVIEW_WMS_REV = revParam;
          if (anyLoading) _setTileSourceLoading('preview_wms', true, t('map_rendering_layers'));
        } catch (_e) {
          _setTileSourceLoading('preview_wms', false);
        }
        return;
      }

      const curZoom = (map && typeof map.getZoom === 'function') ? Number(map.getZoom()) : 7;
      const visibleLarge = layerNames.filter(ln => {
        if (MAP_LAYER_VISIBILITY[ln] === false || !isLayerVisibleAtZoom(ln, curZoom)) return false;
        const st = LAYER_STATS[ln] || {};
        const rows = LAYER_RECORDS[ln] || [];
        return Number(st.feature_count || rows.length || 0) > 2500;
      });
      const visibleNeedsTiles = visibleLarge.filter(ln => {
        const vp = VECTOR_PYRAMIDS[ln];
        const hasLod0Vec = Boolean(vp && vp.lod0 && Array.isArray(vp.lod0.features) && vp.lod0.features.length > 0);
        return scaleDenom <= 750000 || !hasLod0Vec || EXTENT_FILTER_ENABLED;
      });
      if (!visibleNeedsTiles.length || scaleDenom <= 55000 || hasAnyFilter) {
        _clearPreviewWmsRunOverlays();
        return;
      }
      try {
        const mb = map.getBounds();
        const sz = map.getSize ? map.getSize() : { x: 960, y: 640 };
        if (!mb || !mb.isValid || !mb.isValid()) return;
        const bboxStr = [
          mb.getWest().toFixed(5),
          mb.getSouth().toFixed(5),
          mb.getEast().toFixed(5),
          mb.getNorth().toFixed(5)
        ].join(',');
        const w = Math.max(256, Math.min(1800, Math.round(sz.x || 960)));
        const h = Math.max(256, Math.min(1400, Math.round(sz.y || 640)));
        const key = `${visibleLarge.join('|')}|${bboxStr}|${w}x${h}`;
        if (key === PREVIEW_WMS_KEY && PREVIEW_WMS_OVERLAY && map.hasLayer(PREVIEW_WMS_OVERLAY)) return;

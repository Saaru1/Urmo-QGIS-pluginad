          attachMapLayerLoaderEvents(PREVIEW_WMS_OVERLAY, 'preview_wms', t('map_rendering_layers'));
          PREVIEW_WMS_OVERLAY.addTo(map);
        }
      } catch (_e) {
        _setTileSourceLoading('preview_wms', false);
      }
    }

    function orderedLegendLayerNames() {
      const mapWidget = (DASHBOARD.widgets || []).find(w => w.widget_type === 'map');
      const activeNames = orderedMapLayerNames();
      const legPref = (mapWidget && Array.isArray(mapWidget.map_legend_layers) && mapWidget.map_legend_layers.length)
        ? mapWidget.map_legend_layers
        : null;
      if (!legPref) return activeNames;
      const activeSet = new Set(activeNames);
      const out = [];
      legPref.forEach(ln => {
        if (activeSet.has(ln) && !out.includes(ln)) out.push(ln);
      });
      activeNames.forEach(ln => {
        if (!out.includes(ln)) out.push(ln);
      });
      return out;
    }

    function resolveStyleFields(custom) {
      if (!custom) return [];
      const multi = Array.isArray(custom.style_fields) && custom.style_fields.length
        ? custom.style_fields
        : (Array.isArray(custom.legend_fields) && custom.legend_fields.length ? custom.legend_fields : null);
      if (multi) {
        return multi.map(f => String(f || '').trim()).filter(Boolean);
      }
      if (custom.style_field && String(custom.style_field).trim()) {
        return [String(custom.style_field).trim()];
      }
      return [];
    }

    function resolveCategoryColor(valKey, qgisStyle) {
      if (qgisStyle && qgisStyle.category_colors && qgisStyle.category_colors[valKey]) {
        return qgisStyle.category_colors[valKey];
      }
      return hashCategoryColor(valKey);
    }

    function getEffectiveLayerStyleSpec(layerName) {
      const custom = getMapLayerStyleCfg(layerName);
      const qgisStyle = (LAYER_STATS[layerName] || {}).qgis_style || null;
      const customFields = resolveStyleFields(custom);
      const explicitMode = (custom && (custom.style_mode || custom.mode)) || '';
      let mode = explicitMode || (qgisStyle && qgisStyle.style_mode) || 'single';
      let styleFields = customFields;
      if (!styleFields.length && mode !== 'single' && explicitMode !== 'single' && qgisStyle && qgisStyle.style_field) {
        styleFields = [String(qgisStyle.style_field).trim()].filter(Boolean);
      }
      if (explicitMode === 'single') {
        mode = 'single';
        styleFields = [];
      }
      return { custom, qgisStyle, mode, styleFields };
    }

    function defaultUniformColor(layerName, custom, svc) {
      if (custom && custom.color && String(custom.color).trim()) return custom.color;
      const qgisStyle = (LAYER_STATS[layerName] || {}).qgis_style || null;
      if (qgisStyle && qgisStyle.color && String(qgisStyle.color).trim()) return qgisStyle.color;
      const svcCol = (svc && svc.layer_color) ? String(svc.layer_color).trim() : '';
      if (svcCol && svcCol.toLowerCase() !== '#38bdf8') return svcCol;
      if (/natura|elupaik/i.test(layerName)) return '#10b981';
      if (/pria|pärandniit|niit/i.test(layerName)) return '#0ea5e9';
      if (/kaitseala|loodusala|hoiuala|linnuala|püsielupaik/i.test(layerName)) return '#f97316';

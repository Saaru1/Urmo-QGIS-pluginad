    function legendHtml() {
      const mapWidget = (DASHBOARD.widgets || []).find(w => w.widget_type === 'map');
      const titleText = (mapWidget && mapWidget.map_legend_title) ? mapWidget.map_legend_title : t('html_legend_title');
      const visibleLayers = orderedLegendLayerNames().filter(ln => MAP_LAYER_VISIBILITY[ln] !== false);
      const btnIcon = LEGEND_COLLAPSED ? '⟨' : '⟩';
      const btnTitle = LEGEND_COLLAPSED ? t('html_expand_panel') : t('html_collapse_panel');
      const headerHtml = `<div class="legend-hdr"><b>${escapeHtml(titleText)}</b><button type="button" class="panel-right-toggle-btn" onclick="toggleLegendCollapsed()" title="${escapeHtml(btnTitle)}">${btnIcon}</button></div>`;
      if (LEGEND_COLLAPSED || !visibleLayers.length) {
        return headerHtml;
      }

      let viewBb = null;
      if (map && typeof map.getBounds === 'function') {
        try {
          const mb = map.getBounds();
          if (mb && mb.isValid && mb.isValid()) {
            viewBb = [mb.getWest(), mb.getSouth(), mb.getEast(), mb.getNorth()];
          }
        } catch (_vb) {}
      }

      const items = [];
      visibleLayers.forEach(ln => {
        const spec = getEffectiveLayerStyleSpec(ln);
        const custom = spec.custom;
        const qgisStyle = spec.qgisStyle;
        if (custom && custom.show_in_legend === false) return;
        const rawRows = LAYER_RECORDS[ln] || [];
        const filteredRows = (typeof filterRecords === 'function')
          ? (filterRecords(ln, null, '__map__') || [])
          : rawRows;
        let sourceRows = filteredRows;
        if (sourceRows.length > 400 && viewBb) {
          const inView = sourceRows.filter(row => {
            if (!row) return false;
            const bb = getFeatureBbox(ln, String(row._feature_id));
            if (bb && bb.length === 4) return bboxIntersects(bb, viewBb);
            if (row._lat !== undefined && row._lon !== undefined) {
              const lat = Number(row._lat), lon = Number(row._lon);
              return Number.isFinite(lat) && Number.isFinite(lon)
                && lon >= viewBb[0] && lon <= viewBb[2]
                && lat >= viewBb[1] && lat <= viewBb[3];
            }
            return true;
          });
          if (inView.length > 0) sourceRows = inView;
        }
        const svc = (BUNDLE.ogc_services || []).find(s => s.name === ln) || {};
        const dispName = (custom && custom.legend_label) ? custom.legend_label : ln;
        const dispNameEsc = escapeHtml(dispName);
        const mode = spec.mode;
        const styleFields = spec.styleFields;

        if (rawRows.length > 0 && filteredRows.length === 0) {
          items.push(`<span class="legend-dot" style="background:${defaultUniformColor(ln, custom, svc)}"></span>${dispNameEsc} (0)`);
          return;
        }

        if (mode !== 'single' && styleFields.length > 0) {
          const catAgg = new Map();
          for (let i = 0; i < sourceRows.length; i++) {
            const row = sourceRows[i];
            if (!row) continue;
            const parts = styleFields.map(f => row[f]).filter(v => v !== null && v !== undefined && String(v).trim() !== '').map(v => String(v));
            const key = parts.join(' | ');
            if (!key) continue;
            const areaVal = Math.max(0, Number(row._geom_area_ha !== undefined ? row._geom_area_ha : (row.area_ha || 0)) || 0);
            let entry = catAgg.get(key);
            if (!entry) {
              entry = { key, area: 0, count: 0 };
              catAgg.set(key, entry);
            }
            entry.area += areaVal;
            entry.count += 1;
          }
          let rankedCats = Array.from(catAgg.values()).sort((a, b) => {
            if (Math.abs(b.area - a.area) > 1e-6) return b.area - a.area;
            if (b.count !== a.count) return b.count - a.count;
            return a.key.localeCompare(b.key);
          }).map(x => x.key);

          if (!rankedCats.length && !rawRows.length && qgisStyle && qgisStyle.category_colors) {
            rankedCats = Object.keys(qgisStyle.category_colors).filter(Boolean);
          }
          if (rankedCats.length) {
            const MAX_LEGEND_CATS = 40;
            const shownCats = rankedCats.slice(0, MAX_LEGEND_CATS);
            items.push(`<b>${dispNameEsc} (${escapeHtml(styleFields.join(', '))})</b>`);
            shownCats.forEach(v => {
              items.push(`<span class="legend-dot" style="background:${resolveCategoryColor(v, qgisStyle)}"></span>${escapeHtml(v)}`);
            });
            if (rankedCats.length > MAX_LEGEND_CATS) {
              items.push(`<span style="opacity:0.75;font-size:0.72rem;">… (+${rankedCats.length - MAX_LEGEND_CATS})</span>`);
            }
            return;
          }
        }

        // No category field selected -> clean uniform style (matching QGIS native style if set)
        items.push(`<span class="legend-dot" style="background:${defaultUniformColor(ln, custom, svc)}"></span>${dispNameEsc}`);
      });

      if (!items.length) return headerHtml;
      return headerHtml + items.join('<br/>');
    }


            const isPurePoint = (
              !cachedExact
              && row._lon !== undefined && row._lat !== undefined
              && !Array.isArray(row._bbox)
              && !(LAYER_PYRAMID_LOD1[ln] && LAYER_PYRAMID_LOD1[ln][fidStr])
              && !/Polygon|Line/i.test(LAYER_GEOM_TYPES[ln] || '')

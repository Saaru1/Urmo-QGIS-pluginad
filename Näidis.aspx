    function ensureLayerPane(layerName, idx, totalCount) {
      if (!map || typeof map.createPane !== 'function') return undefined;
      const paneName = 'qdash_lyr_' + Math.max(0, Number(idx || 0));
      let pane = (typeof map.getPane === 'function') ? map.getPane(paneName) : null;
      if (!pane) {
        pane = map.createPane(paneName);
      }
      if (pane && pane.style) {
        const total = Math.max(1, Number(totalCount || 1));
        const revRank = Math.max(0, total - 1 - Math.max(0, Number(idx || 0)));
        const z = total <= 1 ? 450 : (405 + Math.round((revRank / (total - 1)) * 85));
        pane.style.zIndex = String(z);
      }
      return paneName;
    }

    function getLayerCanvasRenderer(layerName, paneName) {
      if (typeof L === 'undefined' || typeof L.canvas !== 'function') return vectorCanvasRenderer || undefined;
      if (!paneName) return vectorCanvasRenderer || undefined;

    function _canLayerUsePreviewTile(ln, targetLod, scaleDenom, hasAnyFilter) {
      const curZoom = (map && typeof map.getZoom === 'function') ? Number(map.getZoom()) : 7;
      if (!HAS_PREVIEW_API || hasAnyFilter || MAP_LAYER_VISIBILITY[ln] === false || !isLayerVisibleAtZoom(ln, curZoom)) return false;
      const st = LAYER_STATS[ln] || {};
      const rows = LAYER_RECORDS[ln] || [];
      const isLarge = Number(st.feature_count || rows.length || 0) > 2500;
      if (!isLarge || st.has_qgis_layer !== true) return false;
      if (typeof L === 'undefined' || !L.tileLayer || typeof L.tileLayer.wms !== 'function') return false;
      const vp = VECTOR_PYRAMIDS[ln];
      const hasLod0Vec = Boolean(vp && vp.lod0 && Array.isArray(vp.lod0.features) && vp.lod0.features.length > 0);
      const hasLod0Overview = !EXTENT_FILTER_ENABLED && hasLod0Vec;
      return Boolean(
        targetLod >= 1
        && scaleDenom > 55000
        && (scaleDenom <= 750000 || !hasLod0Overview)

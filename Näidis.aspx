        await Promise.all(Object.keys(VECTOR_PYRAMIDS).map(ln => unpackLod1Pyramid(ln)));
        const mb = map.getBounds();
        const viewBb = [mb.getWest(), mb.getSouth(), mb.getEast(), mb.getNorth()];
        const viewGeom = _bboxToPolyGeom(viewBb);
        const visibleLayers = orderedMapLayerNames().filter(ln => MAP_LAYER_VISIBILITY[ln] !== false);

        const layerCandidates = [];
        for (const ln of visibleLayers) {
          const filtered = filterRecords(ln, null, '__map__');
          const cands = [];
          let needsFullFetch = false;
          let cMinX = Infinity, cMinY = Infinity, cMaxX = -Infinity, cMaxY = -Infinity;
          for (const row of filtered) {
            if (!row) continue;
            const fidStr = (row._feature_id !== undefined && row._feature_id !== null) ? String(row._feature_id) : '';
            const curLod = fidStr ? Number(((LAYER_GEOM_LOD[ln] || {})[fidStr]) || 0) : 0;
            const cachedExact = (fidStr && LAYER_GEOMETRIES[ln]) ? LAYER_GEOMETRIES[ln][fidStr] : null;

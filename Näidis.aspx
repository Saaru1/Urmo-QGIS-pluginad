        const bounds = [[mb.getSouth(), mb.getWest()], [mb.getNorth(), mb.getEast()]];
        const topIdx = layerNames.indexOf(visibleLarge[0]);
        const topPane = ensureLayerPane(visibleLarge[0], Math.max(0, topIdx), layerNames.length);
        _setTileSourceLoading('preview_wms', true, t('map_rendering_layers'));
        if (PREVIEW_WMS_OVERLAY && typeof PREVIEW_WMS_OVERLAY.setUrl === 'function') {

    const _LCC_3301 = (() => {
      const a = 6378137.0;
      const f = 1.0 / 298.257222101;
      const e = Math.sqrt(2 * f - f * f);
      const rad = Math.PI / 180.0;
      const p1 = 59.33333333333334 * rad;
      const p2 = 58.0 * rad;
      const p0 = 57.51755393055556 * rad;
      const l0 = 24.0 * rad;
      const mFn = (phi) => Math.cos(phi) / Math.sqrt(1 - Math.pow(e * Math.sin(phi), 2));
      const tFn = (phi) => Math.tan(Math.PI / 4 - phi / 2) / Math.pow((1 - e * Math.sin(phi)) / (1 + e * Math.sin(phi)), e / 2);
      const m1 = mFn(p1), m2 = mFn(p2);
      const t0 = tFn(p0), t1 = tFn(p1), t2 = tFn(p2);
      const n = (Math.log(m1) - Math.log(m2)) / (Math.log(t1) - Math.log(t2));
      const F = m1 / (n * Math.pow(t1, n));
      const rho0 = a * F * Math.pow(t0, n);
      return { a, e, rad, l0, n, F, rho0, tFn };
    })();

    function projectWgs84ToEstonia3301(lon, lat) {
      const { a, rad, l0, n, F, rho0, tFn } = _LCC_3301;
      const phi = lat * rad;
      const lam = lon * rad;
      const rho = a * F * Math.pow(tFn(phi), n);
      const th = n * (lam - l0);
      return [500000.0 + rho * Math.sin(th), 6375000.0 + rho0 - rho * Math.cos(th)];
    }

    function estonia3301ToWgs84(xEast, yNorth) {
      const { a, e, rad, l0, n, F, rho0 } = _LCC_3301;
      const x = Number(xEast) - 500000.0;
      const y = rho0 - (Number(yNorth) - 6375000.0);
      const rho = (n >= 0 ? 1 : -1) * Math.hypot(x, y);
      if (!Number.isFinite(rho) || rho === 0) return [24.0, 58.65];
      const th = Math.atan2(x, y);
      const lon = (l0 + th / n) / rad;
      const tVal = Math.pow(rho / (a * F), 1.0 / n);
      let phi = Math.PI * 0.5 - 2.0 * Math.atan(tVal);
      for (let it = 0; it < 6; it++) {
        const es = e * Math.sin(phi);
        phi = Math.PI * 0.5 - 2.0 * Math.atan(tVal * Math.pow((1 - es) / (1 + es), e * 0.5));
      }
      return [lon, phi / rad];
    }

    function ringAreaM2(ring) {
      if (!ring || ring.length < 3) return 0;
      const p0 = ring[0];
      const lon0 = Number(p0 && p0[0]);
      const lat0 = Number(p0 && p0[1]);
      if (Number.isFinite(lon0) && Number.isFinite(lat0) && lon0 >= 19.5 && lon0 <= 30.5 && lat0 >= 56.5 && lat0 <= 61.5) {
        let area = 0;
        let prev = projectWgs84ToEstonia3301(lon0, lat0);
        const first = prev;
        for (let i = 1; i <= ring.length; i++) {
          const pt = ring[i % ring.length];
          const cur = (i === ring.length) ? first : projectWgs84ToEstonia3301(Number(pt[0]), Number(pt[1]));
          area += (prev[0] * cur[1]) - (cur[0] * prev[1]);
          prev = cur;
        }
        return Math.abs(area) / 2;
      }
      if (Number.isFinite(lon0) && Number.isFinite(lat0) && (Math.abs(lon0) > 180 || Math.abs(lat0) > 90)) {
        let area = 0;
        let px = 0, py = 0;
        for (let i = 1; i <= ring.length; i++) {
          const pt = ring[i % ring.length];
          const cx = Number(pt[0]) - lon0;
          const cy = Number(pt[1]) - lat0;
          area += (px * cy) - (cx * py);
          px = cx;
          py = cy;
        }
        return Math.abs(area) / 2;
      }
      const rad = Math.PI / 180;
      const R = 6371007.181;
      let area = 0;
      for (let i = 0; i < ring.length; i++) {
        const p1 = ring[i];
        const p2 = ring[(i + 1) % ring.length];
        area += (p2[0] * rad - p1[0] * rad) * (2 + Math.sin(p1[1] * rad) + Math.sin(p2[1] * rad));
      }
      return Math.abs((area * R * R) / 2);
    }

    function computeGeomMeta(geom) {
      if (!geom || !geom.coordinates) return { lat: null, lon: null, area_ha: 0 };
      let sumLon = 0, sumLat = 0, count = 0, areaM2 = 0;
      const addRing = (ring) => {
        for (const pt of ring) {
          sumLon += Number(pt[0]);
          sumLat += Number(pt[1]);
          count++;
        }
      };
      if (geom.type === 'Point') {
        return { lon: Number(geom.coordinates[0]), lat: Number(geom.coordinates[1]), area_ha: 0 };
      } else if (geom.type === 'Polygon') {
        const rings = geom.coordinates;
        if (rings.length) {
          addRing(rings[0]);
          areaM2 += ringAreaM2(rings[0]);
          for (let i = 1; i < rings.length; i++) areaM2 -= ringAreaM2(rings[i]);
        }
      } else if (geom.type === 'MultiPolygon') {
        for (const poly of geom.coordinates) {
          if (poly.length) {
            addRing(poly[0]);
            areaM2 += ringAreaM2(poly[0]);
            for (let i = 1; i < poly.length; i++) areaM2 -= ringAreaM2(poly[i]);
          }
        }
      } else if (geom.type === 'LineString') {
        addRing(geom.coordinates);
      } else if (geom.type === 'MultiLineString') {
        for (const line of geom.coordinates) addRing(line);
      }
      return {
        lon: count ? sumLon / count : null,
        lat: count ? sumLat / count : null,
        area_ha: Math.max(0, Math.round((areaM2 / 10000) * 10000) / 10000)
      };
    }

    function ingestGeoJsonFeatures(layerName, features, opts) {

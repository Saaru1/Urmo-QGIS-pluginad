          document.querySelectorAll('.plot-container').forEach(p => {
            try { Plotly.Plots.resize(p); } catch (_rp) {}
          });
        }, 80);
      }
    }

    let MOBILE_NAV_LOCK_UNTIL = 0;

    function _focusMobileWidgetEl(el) {
      if (!el) return;
      MOBILE_NAV_LOCK_UNTIL = Date.now() + 550;
      if (typeof el.scrollIntoView === 'function') {
        el.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
      if (el.classList) {
        el.classList.remove('mobile-focus-flash');
        void el.offsetWidth;
        el.classList.add('mobile-focus-flash');
        setTimeout(() => {
          if (el.classList) el.classList.remove('mobile-focus-flash');
        }, 900);
      }
    }

    function _trimMobileLabel(raw) {
      const s = String(raw || '').trim();
      if (!s) return 'Widget';
      return s.length > 24 ? s.slice(0, 22).trimEnd() + '…' : s;
    }

    function _mobileWidgetEls() {
      const list = [];
      const mapWidget = (DASHBOARD.widgets || []).find(w => w.widget_type === 'map');
      const mapEl = document.getElementById('map-card');
      if (mapEl && mapEl.style && mapEl.style.display !== 'none') {
        const rawMapLbl = mapWidget ? localizedTitle(mapWidget) : t('html_map_header');
        list.push({ el: mapEl, label: _trimMobileLabel(rawMapLbl) });
      }
      if (typeof document !== 'undefined' && typeof document.querySelectorAll === 'function') {
        document.querySelectorAll('#workspace-main [data-widget-id], #workspace-main .slicer-group').forEach(el => {
          if (!el || el.id === 'map-card' || (el.style && el.style.display === 'none')) return;
          const hdr = el.querySelector ? el.querySelector('.card-header span, .kpi-title, .slicer-label') : null;
          const lbl = hdr ? _trimMobileLabel(hdr.textContent) : ((el.dataset && (el.dataset.widgetId || el.dataset.slicerId)) || 'Widget');
          list.push({ el, label: lbl });
        });
      }
      return list;
    }

    function _isEditableEl(el) {
      if (!el || !el.tagName) return false;
      const tag = String(el.tagName).toUpperCase();
      if (tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT') return true;
      return Boolean(el.isContentEditable);
    }

    function _centerActiveMobilePill(pills, activePill) {
      if (!pills || !activePill) return;
      const runCenter = () => {
        const pw = Number(pills.clientWidth || 0);
        const ol = Number(activePill.offsetLeft || 0);
        const ow = Number(activePill.offsetWidth || 0);
        if (pw > 0) {
          const targetLeft = Math.max(0, Math.round(ol + ow * 0.5 - pw * 0.5));
          if (typeof pills.scrollTo === 'function') {
            try { pills.scrollTo({ left: targetLeft, behavior: 'smooth' }); } catch (_e) { pills.scrollLeft = targetLeft; }
          }
          pills.scrollLeft = targetLeft;
        }
      };
      runCenter();
      if (typeof requestAnimationFrame === 'function') requestAnimationFrame(runCenter);
    }

    function syncMobileScrollBlob() {
      const rail = document.getElementById('mobile-scroll-rail');
      const blob = document.getElementById('mobile-scroll-blob');
      const scroller = (typeof document !== 'undefined' && typeof document.querySelector === 'function')
        ? document.querySelector('.workspace-scroll')
        : null;
      if (!rail || !blob || !scroller) return;
      const isActive = (typeof isMobileCardStackActive === 'function') ? isMobileCardStackActive() : false;
      const sh = Number(scroller.scrollHeight || 0);
      const ch = Number(scroller.clientHeight || 0);
      const maxScroll = Math.max(0, sh - ch);
      const show = Boolean(isActive && maxScroll > 20);
      if (rail.classList) rail.classList.toggle('visible', show);
      if (!show) return;
      if (typeof scroller.getBoundingClientRect === 'function') {
        const sRect = scroller.getBoundingClientRect();
        if (sRect && Number.isFinite(sRect.top) && sRect.top >= 0) {
          rail.style.top = `${Math.max(4, Math.round(sRect.top) + 6)}px`;
        }
      }
      const railH = Math.max(60, Number(rail.clientHeight || (ch - 20)));
      const blobH = Math.max(40, Math.min(railH * 0.65, Math.round((ch / Math.max(1, sh)) * railH)));
      const ratio = maxScroll > 0 ? Math.max(0, Math.min(1, Number(scroller.scrollTop || 0) / maxScroll)) : 0;
      const topPx = Math.round(ratio * Math.max(0, railH - blobH));
      blob.style.height = `${blobH}px`;
      blob.style.top = `${topPx}px`;
    }

    let _MOBILE_SCROLL_SPY_TIMER = null;

    function initMobileScrollControls() {
      const rail = document.getElementById('mobile-scroll-rail');
      const blob = document.getElementById('mobile-scroll-blob');
      const scroller = (typeof document !== 'undefined' && typeof document.querySelector === 'function')
        ? document.querySelector('.workspace-scroll')
        : null;
      if (!scroller) return;
      if (scroller.dataset && scroller.dataset.mobileScrollBound === '1') {
        syncMobileScrollBlob();
        return;
      }
      if (scroller.dataset) scroller.dataset.mobileScrollBound = '1';

      if (typeof scroller.addEventListener === 'function') {
        scroller.addEventListener('focusin', (ev) => {
          if (_isEditableEl(ev && ev.target)) {
            MOBILE_NAV_LOCK_UNTIL = Date.now() + 900;
          }
        });
      }

      scroller.addEventListener('scroll', () => {
        syncMobileScrollBlob();
        if (!isMobileCardStackActive() || Date.now() < MOBILE_NAV_LOCK_UNTIL) return;
        if (_MOBILE_SCROLL_SPY_TIMER) clearTimeout(_MOBILE_SCROLL_SPY_TIMER);
        _MOBILE_SCROLL_SPY_TIMER = setTimeout(() => {
          _MOBILE_SCROLL_SPY_TIMER = null;
          if (!isMobileCardStackActive() || Date.now() < MOBILE_NAV_LOCK_UNTIL) return;
          const items = _mobileWidgetEls();
          if (!items.length || typeof scroller.getBoundingClientRect !== 'function') return;
          const sTop = scroller.getBoundingClientRect().top;
          let bestIdx = MOBILE_FOCUS_IDX, bestDist = Infinity;
          items.forEach((it, idx) => {
            if (!it.el || typeof it.el.getBoundingClientRect !== 'function') return;
            const d = Math.abs(it.el.getBoundingClientRect().top - (sTop + 8));
            if (d < bestDist) { bestDist = d; bestIdx = idx; }
          });
          if (bestIdx !== MOBILE_FOCUS_IDX) {
            MOBILE_FOCUS_IDX = bestIdx;
            const pills = document.getElementById('mobile-nav-pills');
            if (pills && typeof pills.querySelectorAll === 'function') {
              const btns = pills.querySelectorAll('.mobile-nav-pill');
              let activeBtn = null;
              btns.forEach((b, bi) => {
                const act = bi === MOBILE_FOCUS_IDX;
                if (b.classList) b.classList.toggle('active', act);
                if (act) activeBtn = b;
              });
              if (activeBtn) _centerActiveMobilePill(pills, activeBtn);
            }
          }
        }, 120);
      }, { passive: true });

      if (rail && blob && typeof window !== 'undefined') {
        let dragState = null;
        const setScrollFromClientY = (clientY) => {
          if (!dragState || typeof rail.getBoundingClientRect !== 'function') return;
          const rRect = rail.getBoundingClientRect();
          const railH = Math.max(40, rRect.height || rail.clientHeight || 200);
          const blobH = Math.max(40, blob.clientHeight || 40);
          const maxTravel = Math.max(1, railH - blobH);
          const desiredTop = Math.max(0, Math.min(maxTravel, (clientY - rRect.top) - dragState.offsetY));
          const maxScroll = Math.max(0, (scroller.scrollHeight || 0) - (scroller.clientHeight || 0));
          scroller.scrollTop = (desiredTop / maxTravel) * maxScroll;
          syncMobileScrollBlob();
        };
        const startDrag = (clientY, fromBlob) => {
          if (!rail.getBoundingClientRect || !blob.getBoundingClientRect) return;
          const bRect = blob.getBoundingClientRect();
          dragState = { offsetY: fromBlob ? (clientY - bRect.top) : ((bRect.height || 40) * 0.5) };
          if (rail.classList) rail.classList.add('dragging');
          if (!fromBlob) setScrollFromClientY(clientY);
        };
        const endDrag = () => {
          if (!dragState) return;
          dragState = null;
          if (rail.classList) rail.classList.remove('dragging');
        };
        rail.addEventListener('mousedown', (ev) => {
          if (ev.button !== 0) return;
          ev.preventDefault();
          startDrag(ev.clientY, ev.target === blob);
        });
        rail.addEventListener('touchstart', (ev) => {
          const tch = ev.touches && ev.touches[0];
          if (!tch) return;
          if (ev.cancelable) ev.preventDefault();
          startDrag(tch.clientY, ev.target === blob);
        }, { passive: false });
        window.addEventListener('mousemove', (ev) => {
          if (dragState) setScrollFromClientY(ev.clientY);
        });
        window.addEventListener('touchmove', (ev) => {
          if (!dragState) return;
          const tch = ev.touches && ev.touches[0];
          if (!tch) return;
          if (ev.cancelable) ev.preventDefault();
          setScrollFromClientY(tch.clientY);
        }, { passive: false });
        window.addEventListener('mouseup', endDrag);
        window.addEventListener('touchend', endDrag);
        window.addEventListener('touchcancel', endDrag);
      }
      syncMobileScrollBlob();
    }

    function updateMobileNavBar() {
      if (typeof document !== 'undefined' && document.body && document.body.classList) {
        document.body.classList.toggle('mobile-view', isMobileCardStackActive());
      }
      const btn = document.getElementById('btn-mobile-view');
      if (btn) btn.textContent = MOBILE_VIEW_ENABLED ? t('mobile_view_active') : t('mobile_view_btn');
      const pills = document.getElementById('mobile-nav-pills');
      if (pills) {
        const items = _mobileWidgetEls();
        if (MOBILE_FOCUS_IDX >= items.length) MOBILE_FOCUS_IDX = 0;
        pills.innerHTML = '';
        let activePillEl = null;
        items.forEach((it, idx) => {
          const b = document.createElement('button');
          b.type = 'button';
          const isAct = (idx === MOBILE_FOCUS_IDX);
          b.className = 'mobile-nav-pill' + (isAct ? ' active' : '');
          b.textContent = it.label;
          b.title = it.label;
          b.onclick = () => {
            MOBILE_FOCUS_IDX = idx;
            _focusMobileWidgetEl(it.el);
            updateMobileNavBar();
          };
          pills.appendChild(b);
          if (isAct) activePillEl = b;
        });
        if (activePillEl) _centerActiveMobilePill(pills, activePillEl);
      }
      const fitBtn = document.getElementById('btn-mobile-fit');
      if (fitBtn) {
        fitBtn.textContent = t('mobile_fit_btn');
        if (fitBtn.classList) fitBtn.classList.toggle('active', Boolean(MOBILE_FIT_OVERVIEW));
      }
      syncMobileMapTouchLock();
      initMobileScrollControls();
      if (typeof setTimeout === 'function') setTimeout(syncMobileScrollBlob, 60);
    }

    function stepMobileWidget(delta) {
      const items = _mobileWidgetEls();
      if (!items.length) return;
      MOBILE_FOCUS_IDX = (MOBILE_FOCUS_IDX + Number(delta || 0) + items.length) % items.length;
      const target = items[MOBILE_FOCUS_IDX];
      if (target && target.el) _focusMobileWidgetEl(target.el);
      updateMobileNavBar();
    }

    function _applyMobileFitScale() {
      const ws = document.getElementById('workspace-main');
      const scrollEl = (typeof document !== 'undefined' && typeof document.querySelector === 'function')
        ? document.querySelector('.workspace-scroll')
        : null;
      if (!ws || !scrollEl) return;
      if (!MOBILE_FIT_OVERVIEW) {
        ws.style.transform = '';
        ws.style.transformOrigin = '';
        ws.style.marginBottom = '';
        return;
      }
      const wFull = ws.scrollWidth || Number(DASHBOARD.canvas_width || 1280);
      const wAvail = Math.max(280, (scrollEl.clientWidth || (typeof window !== 'undefined' ? window.innerWidth : 390)) - 16);
      const sc = Math.min(1, wAvail / Math.max(1, wFull));
      ws.style.transformOrigin = 'top left';
      ws.style.transform = sc < 0.99 ? `scale(${sc.toFixed(3)})` : '';
      const hFull = ws.scrollHeight || Number(DASHBOARD.canvas_height || 720);
      ws.style.marginBottom = sc < 0.99 ? `${Math.round(hFull * (sc - 1))}px` : '';
    }

    function toggleMobileFitOverview() {
      MOBILE_FIT_OVERVIEW = !MOBILE_FIT_OVERVIEW;
      applyArtboardLayout();
      _applyMobileFitScale();
      updateMobileNavBar();
      if (map && typeof map.invalidateSize === 'function') setTimeout(() => map.invalidateSize(), 60);
      if (typeof document !== 'undefined' && typeof document.querySelectorAll === 'function' && typeof Plotly !== 'undefined' && Plotly && Plotly.Plots) {
        setTimeout(() => {
          document.querySelectorAll('.plot-container').forEach(p => {
            try { Plotly.Plots.resize(p); } catch (_rp) {}
          });
        }, 80);
      }
    }

    // Pure-JS OGC GeoPackage (SQLite3 binary) builder for viewport download (#10)
    function _utf8Bytes(str) {
      if (typeof TextEncoder !== 'undefined') return new TextEncoder().encode(String(str ?? ''));
      const s = unescape(encodeURIComponent(String(str ?? '')));
      const out = new Uint8Array(s.length);
      for (let i = 0; i < s.length; i++) out[i] = s.charCodeAt(i);
      return out;
    }

    function _sqliteVarintBytes(val) {
      let v = BigInt(val);
      if (v < 0n) v = BigInt.asUintN(64, v);
      if (v <= 0x7fn) return [Number(v)];
      if (v > 0xffffffffffffffn) {
        const out9 = new Array(9);
        out9[8] = Number(v & 0xffn);
        let hi = v >> 8n;
        for (let i = 7; i >= 0; i--) {
          out9[i] = Number(hi & 0x7fn) | 0x80;
          hi >>= 7n;
        }
        return out9;
      }
      const rev = [Number(v & 0x7fn)];
      v >>= 7n;
      while (v > 0n) {
        rev.push(Number(v & 0x7fn) | 0x80);
        v >>= 7n;
      }
      return rev.reverse();
    }

    function _encodeSqliteRecord(fields) {
      // fields: array of { type: 'null'|'int'|'float'|'text'|'blob', value }
      const serials = [];
      const bodies = [];
      for (const f of fields) {
        if (f.value === null || f.value === undefined || f.type === 'null') {
          serials.push(..._sqliteVarintBytes(0));
        } else if (f.type === 'int') {
          const iv = BigInt(Math.trunc(Number(f.value)));
          if (iv === 0n) {
            serials.push(..._sqliteVarintBytes(8));
          } else if (iv === 1n) {
            serials.push(..._sqliteVarintBytes(9));
          } else if (iv >= -128n && iv <= 127n) {
            serials.push(..._sqliteVarintBytes(1));
            const b = new Uint8Array(1);
            new DataView(b.buffer).setInt8(0, Number(iv));
            bodies.push(b);

      const options = opts || {};
      const lbl = CURR_LANG === 'en' ? 'Scale' : 'Mõõtkava';
      const zRaw = (map && typeof map.getZoom === 'function' && Number.isFinite(Number(map.getZoom())))
        ? Number(map.getZoom())
        : 7;
      const zTxt = Math.abs(zRaw - Math.round(zRaw)) < 0.08 ? String(Math.round(zRaw)) : zRaw.toFixed(1);
      let lodTxt = `LOD-${lod}`;
      if (lod >= 3) {
        if (options.hasExactDetail === true) {
          lodTxt = '1:1 Detail';
        } else {
          const dispLod = Number.isFinite(Number(options.actualLod)) ? Math.max(0, Math.min(2, Number(options.actualLod))) : 1;
          lodTxt = options.fetchingUpgrade ? `LOD-${dispLod} (1:1…)` : `LOD-${dispLod}`;
        }
      }
      const scaleTxt = formatScaleText(scaleDenom);
      el.textContent = `${lbl}: ${scaleTxt} · Z=${zTxt} · ${lodTxt} ▾`;
      el.title = t('map_scale_hover_info', {
        scale: scaleTxt,
        zoom_txt: `Z=${zTxt}`,
        span_txt: _computeViewportSpanText(),
        detail_txt: lodTxt,
      });
    }

    function _ensureMapScaleMenuEl() {
      let menu = document.getElementById('map-scale-menu');
      if (!menu && document.body && typeof document.createElement === 'function') {
        menu = document.createElement('div');
        menu.id = 'map-scale-menu';
        menu.className = 'map-scale-menu';
        document.body.appendChild(menu);
      }
      return menu;
    }

    function closeMapScaleMenu() {
      const menu = document.getElementById('map-scale-menu');
      if (menu) menu.style.display = 'none';
    }

    function renderMapScaleMenu() {
      const menu = _ensureMapScaleMenuEl();
      if (!menu) return;
      menu.innerHTML = '';
      const hdr = document.createElement('div');
      hdr.className = 'map-scale-menu-hdr';
      hdr.textContent = t('map_scale_menu_title');
      menu.appendChild(hdr);
      _ESTONIA_SCALE_PRESETS.forEach(p => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'map-scale-preset-btn';
        btn.textContent = t(p.labelKey);
        btn.onclick = () => {
          closeMapScaleMenu();
          applyMapScalePreset(p.scale, p.fitEstonia);
        };
        menu.appendChild(btn);
      });
      const row = document.createElement('div');
      row.className = 'map-scale-manual-row';
      const prefix = document.createElement('span');
      prefix.textContent = '1:';
      prefix.style.fontWeight = '700';
      const inp = document.createElement('input');
      inp.id = 'map-scale-manual-input';
      inp.type = 'text';
      inp.placeholder = t('map_scale_manual_ph');
      inp.value = String(Math.max(500, Math.round(computeMapScaleDenominator() / 100) * 100));
      inp.onkeydown = (e) => {
        if (e.key === 'Enter') {
          e.preventDefault();
          applyManualMapScale();
        } else if (e.key === 'Escape') {
          closeMapScaleMenu();
        }
      };
      const goBtn = document.createElement('button');
      goBtn.type = 'button';
      goBtn.className = 'btn-mini-icon';
      goBtn.textContent = t('map_scale_manual_apply');
      goBtn.onclick = () => applyManualMapScale();
      row.appendChild(prefix);
      row.appendChild(inp);
      row.appendChild(goBtn);
      menu.appendChild(row);
    }

    function toggleMapScaleMenu(ev) {
      if (ev && typeof ev.stopPropagation === 'function') ev.stopPropagation();
      const menu = _ensureMapScaleMenuEl();
      const btn = document.getElementById('map-scale-badge');
      if (!menu || !btn) return;
      const isOpen = menu.style.display === 'flex';
      if (isOpen) {
        closeMapScaleMenu();
        return;
      }
      renderMapScaleMenu();
      menu.style.display = 'flex';
      if (typeof btn.getBoundingClientRect === 'function') {
        const rect = btn.getBoundingClientRect();
        const winW = (typeof window !== 'undefined' && window.innerWidth) ? window.innerWidth : 1200;
        const winH = (typeof window !== 'undefined' && window.innerHeight) ? window.innerHeight : 800;
        const leftPos = Math.max(8, Math.min(rect.left, winW - 285));
        const topPos = Math.max(8, Math.min(rect.bottom + 6, winH - 320));
        menu.style.left = leftPos + 'px';
        menu.style.top = topPos + 'px';
      }
    }

    function applyMapScalePreset(scaleDenom, fitEstonia) {
      if (!map) return;
      if (fitEstonia && typeof safeFitBounds === 'function') {
        safeFitBounds([[57.48, 21.65], [59.70, 28.25]], { padding: [10, 10], maxZoom: 14, refreshAfterZoom: true });
        return;
      }
      const targetScale = Math.max(250, Math.min(10000000, Number(scaleDenom) || 500000));
      const targetRes = targetScale / 3779.52756;
      const targetZoom = Math.max(0, Math.min(14, Math.log2(4000 / targetRes)));
      if (typeof map.setZoom === 'function') {
        map.setZoom(targetZoom);
      }
      const sNow = computeMapScaleDenominator();
      updateMapScaleBadge(sNow, targetLodForScale(sNow));
      if (typeof scheduleMapRender === 'function') {
        scheduleMapRender({ skipAutoZoom: true });
      }
    }

    function applyManualMapScale() {
      const inp = document.getElementById('map-scale-manual-input');
      if (!inp) return;
      const raw = String(inp.value || '').trim().replace(/^1\s*:\s*/i, '').replace(/[\s,]+/g, '');
      const val = Number(raw);
      if (Number.isFinite(val) && val > 0) {
        closeMapScaleMenu();
        applyMapScalePreset(val, false);
      }
    }

    function buildDynamicViewportGrid(records, cellDeg, viewBox) {
      const cells = {};
      const step = Math.max(0.002, Number(cellDeg || 0.008));
      for (let i = 0; i < records.length; i++) {
        const r = records[i];
        const lon = Number(r._lon);
        const lat = Number(r._lat);
        if (!Number.isFinite(lon) || !Number.isFinite(lat)) continue;
        if (viewBox && (lon < viewBox[0] || lon > viewBox[2] || lat < viewBox[1] || lat > viewBox[3])) continue;
        const ix = Math.floor(lon / step);
        const iy = Math.floor(lat / step);
        const k = `${ix}_${iy}`;
        if (!cells[k]) {
          cells[k] = {
            x0: ix * step, y0: iy * step, x1: (ix + 1) * step, y1: (iy + 1) * step,
            count: 0, area: 0, sample: r
          };
        }
        cells[k].count++;
        cells[k].area += Number(r._geom_area_ha || r.area_ha || 0);
      }
      const feats = Object.values(cells).slice(0, 1800).map(c => ({
        type: 'Feature',
        properties: Object.assign({}, c.sample, { count: c.count, area_ha: Math.round(c.area * 10) / 10 }),
        geometry: {
          type: 'Polygon',
          coordinates: [[[c.x0, c.y0], [c.x1, c.y0], [c.x1, c.y1], [c.x0, c.y1], [c.x0, c.y0]]]
        }
      }));
      return { type: 'FeatureCollection', features: feats };
    }

    function getFeatureGeometry(layerName, fidStr) {
      const exact = (LAYER_GEOMETRIES[layerName] || {})[fidStr];
      if (exact) return exact;
      const packedMap = LAYER_PYRAMID_LOD1[layerName];
      if (packedMap && packedMap[fidStr]) {
        const g = decodePackedEntry(packedMap[fidStr]);
        if (g) {
          if (!LAYER_GEOMETRIES[layerName]) LAYER_GEOMETRIES[layerName] = {};
          if (!LAYER_GEOM_LOD[layerName]) LAYER_GEOM_LOD[layerName] = {};
          LAYER_GEOMETRIES[layerName][fidStr] = g;
          if (!LAYER_GEOM_LOD[layerName][fidStr]) LAYER_GEOM_LOD[layerName][fidStr] = 1;
          if (packedMap[fidStr][1]) {
            if (!LAYER_GEOM_BBOXES[layerName]) LAYER_GEOM_BBOXES[layerName] = {};
            LAYER_GEOM_BBOXES[layerName][fidStr] = packedMap[fidStr][1];
          }
          return g;
        }
      }
      return null;
    }

    const _RECORD_BBOX_INDEX = {};

    function getFeatureBbox(layerName, fidStr) {
      const cached = (LAYER_GEOM_BBOXES[layerName] || {})[fidStr];
      if (cached) return cached;
      const packedMap = LAYER_PYRAMID_LOD1[layerName];
      if (packedMap && packedMap[fidStr] && Array.isArray(packedMap[fidStr][1])) {
        return packedMap[fidStr][1];
      }
      const exact = (LAYER_GEOMETRIES[layerName] || {})[fidStr];
      if (exact && typeof geomBbox === 'function') {
        const bb = geomBbox(exact);
        if (bb) {
          if (!LAYER_GEOM_BBOXES[layerName]) LAYER_GEOM_BBOXES[layerName] = {};
          LAYER_GEOM_BBOXES[layerName][fidStr] = bb;
        }
        return bb;
      }
      if (!_RECORD_BBOX_INDEX[layerName] && Array.isArray(LAYER_RECORDS[layerName])) {
        const idxMap = new Map();
        const recs = LAYER_RECORDS[layerName];
        for (let i = 0; i < recs.length; i++) {
          const r = recs[i];
          if (r && r._feature_id !== undefined && r._feature_id !== null && Array.isArray(r._bbox) && r._bbox.length === 4) {
            idxMap.set(String(r._feature_id), r._bbox.map(Number));
          }
        }
        _RECORD_BBOX_INDEX[layerName] = idxMap;
      }
      const recMap = _RECORD_BBOX_INDEX[layerName];
      if (recMap && recMap.has(fidStr)) {
        return recMap.get(fidStr);
      }
      return null;
    }

    function bboxIntersects(bb, viewBox) {
      if (!bb || !viewBox) return true;
      return !(bb[2] < viewBox[0] || bb[0] > viewBox[2] || bb[3] < viewBox[1] || bb[1] > viewBox[3]);
    }

    function _hashFidList(fids) {
      let h = 2166136261;
      for (let i = 0; i < fids.length; i++) {
        const s = String(fids[i]);
        for (let j = 0; j < s.length; j++) {
          h ^= s.charCodeAt(j);
          h = Math.imul(h, 16777619);
        }
        h ^= 44;
        h = Math.imul(h, 16777619);
      }
      return (h >>> 0).toString(36);
    }

    function escapeHtml(val) {
      if (val === null || val === undefined) return '';
      return String(val)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    function safeFitBounds(boundsOrPoints, opts) {
      if (!map || !boundsOrPoints) return;
      const options = opts || { padding: [32, 32], maxZoom: 14 };
      IS_PROGRAMMATIC_MOVE = true;
      try {
        map.fitBounds(boundsOrPoints, options);
      } finally {
        setTimeout(() => {
          IS_PROGRAMMATIC_MOVE = false;
          if (options.refreshAfterZoom && typeof renderMapFeatures === 'function') {
            renderMapFeatures({ skipAutoZoom: true, fromAsyncFetch: true });
          }
        }, 160);
      }
    }

    function safeSetView(center, zoom) {
      if (!map || !center) return;
      IS_PROGRAMMATIC_MOVE = true;
      try {
        map.setView(center, zoom);
      } finally {
        setTimeout(() => {
          IS_PROGRAMMATIC_MOVE = false;
          if (typeof syncZoomVisibilityImmediate === 'function') syncZoomVisibilityImmediate();
          if (typeof renderMapFeatures === 'function') {
            renderMapFeatures({ skipAutoZoom: true, fromAsyncFetch: true });
          }
        }, 140);
      }
    }

    function _currentViewportSnapshot() {
      if (!map || typeof map.getBounds !== 'function') return null;
      const mb = map.getBounds();
      if (!mb || typeof mb.isValid !== 'function' || !mb.isValid()) return null;
      const sDenom = computeMapScaleDenominator();
      const lod = targetLodForScale(sDenom);
      const zoomNow = typeof map.getZoom === 'function' ? Number(map.getZoom()) : 7;
      const w = Number(mb.getWest()), s = Number(mb.getSouth()), e = Number(mb.getEast()), n = Number(mb.getNorth());
      const zoomVis = {};
      if (typeof orderedMapLayerNames === 'function' && typeof isLayerVisibleAtZoom === 'function') {
        orderedMapLayerNames().forEach(ln => {
          zoomVis[ln] = isLayerVisibleAtZoom(ln, zoomNow, sDenom);
        });
      }
      return {
        lod,
        zoom: zoomNow,
        scale: sDenom,
        zoomVis,
        bbox: [w, s, e, n],
        cLon: (w + e) * 0.5,
        cLat: (s + n) * 0.5,
        spanLon: Math.max(1e-6, Math.abs(e - w)),
        spanLat: Math.max(1e-6, Math.abs(n - s)),
      };
    }

    function _allVisibleLayersSelfManagedAtLod(lod, scaleDenom) {
      if (EXTENT_FILTER_ENABLED || Object.keys(ACTIVE_FILTERS).length > 0) return false;
      const visible = orderedMapLayerNames().filter(ln => MAP_LAYER_VISIBILITY[ln] !== false);
      if (!visible.length) return false;
      return visible.every(ln => {
        const st = LAYER_STATS[ln] || {};
        const rows = LAYER_RECORDS[ln] || [];
        const isLarge = rows.length > 2500 || Number(st.feature_count || 0) > 2500;
        if (!isLarge) return false;
        const vp = VECTOR_PYRAMIDS[ln];
        const hasLod0 = Boolean(vp && vp.lod0 && Array.isArray(vp.lod0.features) && vp.lod0.features.length > 0);
        if (lod === 0 && hasLod0) return true;
        if (
          HAS_PREVIEW_API
          && st.has_qgis_layer === true
          && typeof L !== 'undefined'
          && L.tileLayer
          && typeof L.tileLayer.wms === 'function'
          && lod >= 1
          && scaleDenom > 55000
          && (scaleDenom <= 750000 || !hasLod0)
        ) {
          return true;
        }
        return false;
      });
    }

    function shouldSkipMinorViewportRefresh() {
      const cur = _currentViewportSnapshot();
      const prev = LAST_RENDER_VIEWPORT;
      if (!cur || !prev) return false;
      if (cur.lod !== prev.lod) return false;
      if (Math.floor(cur.zoom) !== Math.floor(prev.zoom)) return false;
      if (cur.zoomVis && prev.zoomVis) {
        for (const ln of Object.keys(cur.zoomVis)) {
          if (cur.zoomVis[ln] !== prev.zoomVis[ln]) return false;
        }
      }
      if (_allVisibleLayersSelfManagedAtLod(cur.lod, cur.scale)) return true;
      const dLon = Math.abs(cur.cLon - prev.cLon) / Math.max(cur.spanLon, prev.spanLon);
      const dLat = Math.abs(cur.cLat - prev.cLat) / Math.max(cur.spanLat, prev.spanLat);
      if (cur.lod >= 3) {
        return Math.abs(cur.zoom - prev.zoom) <= 0.35 && dLon < 0.10 && dLat < 0.10;
      }
      if (Math.abs(cur.zoom - prev.zoom) > 0.85) return false;
      return dLon < 0.26 && dLat < 0.26;
    }

    function scheduleMapRefreshOnViewport() {
      if (VIEWPORT_REFRESH_TIMER) clearTimeout(VIEWPORT_REFRESH_TIMER);
      VIEWPORT_REFRESH_TIMER = setTimeout(() => {
        VIEWPORT_REFRESH_TIMER = null;
        if (IS_MAP_INTERACTING) return;
        scheduleMapRender({ skipAutoZoom: true });
      }, VIEWPORT_REFRESH_DEBOUNCE_MS);
    }

    function scheduleExtentFilterRefresh() {
      if (EXTENT_REFRESH_TIMER) clearTimeout(EXTENT_REFRESH_TIMER);
      EXTENT_REFRESH_TIMER = setTimeout(() => {
        EXTENT_REFRESH_TIMER = null;
        if (IS_MAP_INTERACTING) return;
        renderAll({ skipAutoZoom: true });
      }, EXTENT_REFRESH_DEBOUNCE_MS);
    }

    async function unpackLod1Pyramid(layerName) {
      if (LAYER_PYRAMID_LOD1[layerName]) return LAYER_PYRAMID_LOD1[layerName];
      if (LOD1_UNPACKING[layerName]) return LOD1_UNPACKING[layerName];
      const vp = VECTOR_PYRAMIDS[layerName];
      const lod1 = vp && vp.lod1;
      if (!lod1 || !lod1.data_b64) return null;

      LOD1_UNPACKING[layerName] = (async () => {
        try {
          const bin = atob(lod1.data_b64);
          const bytes = new Uint8Array(bin.length);
          for (let i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);
          if (typeof DecompressionStream === 'undefined') return null;
          const ds = new DecompressionStream('gzip');
          const stream = new Blob([bytes]).stream().pipeThrough(ds);
          const jsonText = await new Response(stream).text();
          const packed = JSON.parse(jsonText);
          LAYER_PYRAMID_LOD1[layerName] = packed;
          if (!LAYER_GEOM_TYPES[layerName] && packed) {
            const firstKey = Object.keys(packed)[0];
            if (firstKey && packed[firstKey] && packed[firstKey][0]) {
              LAYER_GEOM_TYPES[layerName] = PYRAMID_TYPE_MAP[packed[firstKey][0]] || '';
            }
          }
          return packed;
        } catch (err) {
          console.warn('LOD-1 pyramid decode error for', layerName, err);
          return null;
        } finally {
          delete LOD1_UNPACKING[layerName];
        }
      })();
      return LOD1_UNPACKING[layerName];
    }

    function findLiveWfsService(layerName) {
      if (!layerName) return null;
      return (BUNDLE.ogc_services || []).find(s => s && s.type === 'wfs' && s.name === layerName && s.geojson_url) || null;
    }

    function _computeWfsFetchBbox(layerName, fids, viewBbox) {
      if (Array.isArray(fids) && fids.length > 0 && Array.isArray(LAYER_RECORDS[layerName])) {
        const fidSet = new Set(fids.map(String));
        let minX = Infinity, minY = Infinity, maxX = -Infinity, maxY = -Infinity;
        let hit = false;
        const recs = LAYER_RECORDS[layerName];
        for (let i = 0; i < recs.length; i++) {
          const r = recs[i];
          if (!r || !fidSet.has(String(r._feature_id))) continue;
          const bb = Array.isArray(r._bbox) && r._bbox.length === 4 ? r._bbox.map(Number) : getFeatureBbox(layerName, String(r._feature_id));
          if (bb && bb.length === 4 && bb.every(Number.isFinite)) {
            minX = Math.min(minX, bb[0]); minY = Math.min(minY, bb[1]);
            maxX = Math.max(maxX, bb[2]); maxY = Math.max(maxY, bb[3]);
            hit = true;
          } else if (r._lon !== undefined && r._lat !== undefined) {
            const x = Number(r._lon), y = Number(r._lat);
            if (Number.isFinite(x) && Number.isFinite(y)) {
              minX = Math.min(minX, x); minY = Math.min(minY, y);
              maxX = Math.max(maxX, x); maxY = Math.max(maxY, y);
              hit = true;
            }
          }
        }
        if (hit) {
          const spanX = maxX - minX, spanY = maxY - minY;
          if ((spanX <= 0.85 && spanY <= 0.85) || !Array.isArray(viewBbox) || viewBbox.length !== 4) {
            return [minX - 0.004, minY - 0.004, maxX + 0.004, maxY + 0.004];
          }
        }
      }
      return (Array.isArray(viewBbox) && viewBbox.length === 4) ? viewBbox : null;
    }

    function _buildWfsBboxUrl(wfsSvc, bboxWgs84, maxFeatures) {
      if (!wfsSvc || !wfsSvc.geojson_url) return '';
      const rawUrl = String(wfsSvc.geojson_url);
      const isAbs = /^https?:/i.test(rawUrl);
      const parsed = new URL(rawUrl, isAbs ? undefined : 'https://placeholder.local');
      if (parsed.searchParams.has('version') && String(parsed.searchParams.get('version')).startsWith('1.')) {
        parsed.searchParams.set('maxFeatures', String(maxFeatures || 2500));
      } else {
        parsed.searchParams.set('count', String(maxFeatures || 2500));
      }
      parsed.searchParams.set('srsName', 'EPSG:4326');
      parsed.searchParams.set('outputFormat', 'application/json');
      if (Array.isArray(bboxWgs84) && bboxWgs84.length === 4) {
        const w = bboxWgs84[0].toFixed(5), s = bboxWgs84[1].toFixed(5);
        const e = bboxWgs84[2].toFixed(5), n = bboxWgs84[3].toFixed(5);
        parsed.searchParams.set('bbox', `${s},${w},${n},${e},urn:ogc:def:crs:EPSG::4326`);
      }
      return isAbs ? parsed.toString() : (parsed.pathname + parsed.search + parsed.hash);
    }

    async function requestMissingFeatures(layerName, opts) {
      const options = opts || {};
      const reqLod = Number.isFinite(options.lod) ? Number(options.lod) : 2;
      const scaleDenom = Number.isFinite(options.scale) ? Math.round(options.scale) : 120000;
      const vp = VECTOR_PYRAMIDS[layerName];
      if (vp && vp.lod1 && vp.lod1.data_b64 && !LAYER_PYRAMID_LOD1[layerName]) {
        beginMapRenderLoader(t('map_rendering_layers'));
        try {
          const unpacked = await unpackLod1Pyramid(layerName);
          if (unpacked && typeof renderMapFeatures === 'function') {
            if (typeof _CROSS_LAYER_FID_CACHE !== 'undefined') _CROSS_LAYER_FID_CACHE.clear();
          if (typeof _CROSS_LAYER_AREA_CACHE !== 'undefined') _CROSS_LAYER_AREA_CACHE.clear();
            renderMapFeatures({
              skipAutoZoom: Boolean(options.skipAutoZoom),
              forceZoom: Boolean(options.forceZoom),
              fromAsyncFetch: true
            });
            if (typeof renderWidgetsOnly === 'function') renderWidgetsOnly();
          }
        } finally {
          endMapRenderLoader(false);
        }
      }
      const wfsSvc = HAS_PREVIEW_API ? null : findLiveWfsService(layerName);
      if (!HAS_PREVIEW_API && !wfsSvc) return;

      const fids = Array.isArray(options.fids) ? options.fids.map(String).filter(Boolean) : [];
      const bbox = Array.isArray(options.bbox) ? options.bbox : null;
      const hasCompactViewBbox = Boolean(
        !HAS_PREVIEW_API
        && reqLod >= 3
        && bbox
        && bbox.length === 4
        && (Number(bbox[2]) - Number(bbox[0])) <= 0.85
        && (Number(bbox[3]) - Number(bbox[1])) <= 0.85
      );
      const fetchBbox = HAS_PREVIEW_API
        ? bbox
        : (hasCompactViewBbox ? bbox : _computeWfsFetchBbox(layerName, fids, bbox));
      if (!HAS_PREVIEW_API && !fetchBbox) return;
      const zoom = Number.isFinite(options.zoom) ? Math.round(options.zoom) : 12;

      const fidKeyPart = fids.length
        ? `fids:${fids.length}:${_hashFidList(fids)}`
        : '';
      const keyBbox = fetchBbox || bbox;
      const bboxKeyPart = (keyBbox && keyBbox.length === 4)
        ? `bbox:${keyBbox.map(v => Number(v).toFixed(3)).join(',')}|z${zoom}`
        : '';
      const key = (fidKeyPart || bboxKeyPart)
        ? `${layerName}|${[fidKeyPart, bboxKeyPart].filter(Boolean).join('|')}|lod${reqLod}`
        : '';
      const nowMs = Date.now();
      if (
        !key
        || FEATURE_FETCH_INFLIGHT[key]
        || LAYER_LAST_MISSING_KEY[layerName] === key
        || (LAYER_FETCH_COOLDOWN[key] && nowMs < LAYER_FETCH_COOLDOWN[key])
      ) return;
      FEATURE_FETCH_INFLIGHT[key] = true;

      beginMapRenderLoader(t('map_rendering_layers'));
      try {
        if (FETCH_ABORT_CONTROLLERS[layerName]) {
          try { FETCH_ABORT_CONTROLLERS[layerName].abort(); } catch (_ab) {}
        }
        const controller = (typeof AbortController !== 'undefined') ? new AbortController() : null;
        if (controller) FETCH_ABORT_CONTROLLERS[layerName] = controller;
        let fetchUrl = '';
        const fetchOpts = {};
        if (controller) fetchOpts.signal = controller.signal;
        if (HAS_PREVIEW_API) {
          const params = new URLSearchParams();
          params.set('layer', layerName);
          params.set('zoom', String(zoom));
          params.set('lod', String(reqLod));
          params.set('scale', String(scaleDenom));
          params.set('max', '4500');

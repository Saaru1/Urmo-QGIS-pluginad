      const minZ = (stCfg && Number(stCfg.min_zoom) > 0) ? Number(stCfg.min_zoom) : 0;
      if (minZ <= 0) return true;
      const hasZoom = zoomVal !== undefined && zoomVal !== null && Number.isFinite(Number(zoomVal));
      const zNum = hasZoom ? Number(zoomVal) : null;
      if (zNum !== null && zNum < minZ) return false;
      let effScale = (scaleDenom !== undefined && scaleDenom !== null && Number.isFinite(Number(scaleDenom)))
        ? Number(scaleDenom)
        : null;
      if (effScale === null && map && typeof map.getZoom === 'function') {

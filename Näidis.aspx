          if (PREVIEW_WMS_OVERLAY && map.hasLayer(PREVIEW_WMS_OVERLAY)) {
            map.removeLayer(PREVIEW_WMS_OVERLAY);
          }
        } finally {
          IS_SYNCING_MAP_LAYERS -= 1;
        }
      }
      PREVIEW_WMS_RUN_OVERLAYS = [];
      PREVIEW_WMS_OVERLAY = null;
      PREVIEW_WMS_KEY = '';
    }

    function updatePreviewWmsOverlay(layerNames, scaleDenom) {
      if (!HAS_PREVIEW_API || !map || typeof L === 'undefined') return;
      const canUseTileLayer = Boolean(L.tileLayer && typeof L.tileLayer.wms === 'function');
      if (!canUseTileLayer && typeof L.imageOverlay !== 'function') return;

      const hasAnyFilter = Object.keys(ACTIVE_FILTERS).length > 0;
      const targetLod = typeof targetLodForScale === 'function' ? targetLodForScale(scaleDenom) : 1;

      if (canUseTileLayer) {
        // Preserve exact layerNames[0]=top draw order even when large raster layers are interleaved with vector layers
        const runs = [];
        let curRun = null;
        layerNames.forEach((ln, idx) => {
          if (_canLayerUsePreviewTile(ln, targetLod, scaleDenom, hasAnyFilter)) {
            const paneName = ensureLayerPane(ln, idx, layerNames.length);
            if (!curRun) {
              curRun = { layers: [ln], pane: paneName };
              runs.push(curRun);
            } else {
              curRun.layers.push(ln);
            }
          } else {
            curRun = null;
          }
        });

        if (!runs.length) {
          _clearPreviewWmsRunOverlays();
          return;
        }

        try {
          const revParam = 'v' + Number(BUNDLE.preview_cache_rev || 1);
          const nextOverlays = [];
          let anyLoading = false;
          runs.forEach((run, rIdx) => {
            const layersParam = run.layers.join(',');
            let ov = PREVIEW_WMS_RUN_OVERLAYS[rIdx] || null;
            const desiredPane = run.pane || 'overlayPane';
            const samePane = Boolean(ov && ov._qdashPane === desiredPane);
            if (ov && samePane && typeof ov.setParams === 'function') {
              if (ov._qdashLayers !== layersParam || ov._qdashRev !== revParam) {
                ov._qdashLayers = layersParam;
                ov._qdashRev = revParam;
                anyLoading = true;
                ov.setParams({ layers: layersParam, styles: revParam });
              }
              if (!map.hasLayer(ov)) {
                IS_SYNCING_MAP_LAYERS += 1;
                try { ov.addTo(map); } finally { IS_SYNCING_MAP_LAYERS -= 1; }
              }
            } else {
              if (ov && map.hasLayer(ov)) {
                IS_SYNCING_MAP_LAYERS += 1;
                try { map.removeLayer(ov); } finally { IS_SYNCING_MAP_LAYERS -= 1; }
              }

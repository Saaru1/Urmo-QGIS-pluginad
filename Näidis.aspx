                const arr = byCentroidBucket.get(`${cLat + dLat}_${cLon + dLon}`);
                if (!arr) continue;
                for (let bi = 0; bi < arr.length; bi++) {
                  const cand = arr[bi];
                  const dist = Math.hypot(Number(cand._lat) - jlat, Number(cand._lon) - jlon);
                  const candBb = (Array.isArray(cand._bbox) && cand._bbox.length === 4)
                    ? cand._bbox
                    : getFeatureBbox(layerName, String(cand._feature_id));
                  const overlaps = Boolean(
                    ib && ib.length === 4 && candBb && candBb.length === 4
                    && Number(candBb[0]) <= ib[2] && Number(candBb[2]) >= ib[0]
                    && Number(candBb[1]) <= ib[3] && Number(candBb[3]) >= ib[1]
                  );
                  if (dist > 0.006 && !overlaps) continue;
                  const sameType = (jrec.pohityyp === undefined || cand.pohityyp === undefined || String(jrec.pohityyp) === String(cand.pohityyp))
                    && (jrec.nimi === undefined || cand.nimi === undefined || String(jrec.nimi) === String(cand.nimi))
                    && (jrec.parandniidu_tyyp === undefined || cand.parandniidu_tyyp === undefined || String(jrec.parandniidu_tyyp) === String(cand.parandniidu_tyyp));
                  const penalty = dist + (sameType ? 0 : 1.0) + (overlaps ? 0 : 0.004);
                  if (penalty < bestScore) { bestScore = penalty; best = cand; }
                }
              }
            }
            if (best && bestScore < 0.01) existing = best;
          }

          const targetFid = existing && existing._feature_id !== undefined && existing._feature_id !== null
            ? String(existing._feature_id)
            : k;
          if (item.geometry && targetFid) {
            const curLod = Number(LAYER_GEOM_LOD[layerName][targetFid] || 0);
            if (!LAYER_GEOMETRIES[layerName][targetFid] || incomingLod >= curLod) {
              LAYER_GEOMETRIES[layerName][targetFid] = item.geometry;
              LAYER_GEOM_LOD[layerName][targetFid] = incomingLod;
            }
            if (item.bbox) {
              LAYER_GEOM_BBOXES[layerName][targetFid] = item.bbox;
            }
          }
          if (existing) {
            Object.keys(jrec).forEach(col => {
              if (col === '_feature_id') return;
              if (existing[col] === undefined || existing[col] === null || existing[col] === '') {
                existing[col] = jrec[col];
              }
            });
          } else if (!options.matchExistingOnly) {
            LAYER_RECORDS[layerName].push(jrec);
            if (targetFid) byId.set(targetFid, jrec);
          }
        });
      } else {
        parsed.forEach(item => {
          const fidStr = String(item.fid);
          if (item.geometry) {
            const curLod = Number(LAYER_GEOM_LOD[layerName][fidStr] || 0);
            if (!LAYER_GEOMETRIES[layerName][fidStr] || incomingLod >= curLod) {
              LAYER_GEOMETRIES[layerName][fidStr] = item.geometry;
              LAYER_GEOM_LOD[layerName][fidStr] = incomingLod;
            }
            if (item.bbox) {
              LAYER_GEOM_BBOXES[layerName][fidStr] = item.bbox;
            }
          }
        });
        LAYER_RECORDS[layerName] = joinedProps;
      }
    }

    function geomBbox(geom) {
      if (!geom || !geom.coordinates) return null;
      let minX = Infinity, minY = Infinity, maxX = -Infinity, maxY = -Infinity;
      const scan = arr => {
        if (!Array.isArray(arr)) return;
        if (typeof arr[0] === 'number' && typeof arr[1] === 'number') {
          if (arr[0] < minX) minX = arr[0];
          if (arr[1] < minY) minY = arr[1];
          if (arr[0] > maxX) maxX = arr[0];
          if (arr[1] > maxY) maxY = arr[1];
        } else {
          for (const child of arr) scan(child);
        }
      };
      scan(geom.coordinates);
      return minX <= maxX ? [minX, minY, maxX, maxY] : null;
    }

    function pointInRing(x, y, ring) {
      let inside = false;
      for (let i = 0, j = ring.length - 1; i < ring.length; j = i++) {
        const xi = ring[i][0], yi = ring[i][1], xj = ring[j][0], yj = ring[j][1];
        if (((yi > y) !== (yj > y)) && (x < (xj - xi) * (y - yi) / ((yj - yi) || 1e-18) + xi)) {
          inside = !inside;
        }
      }
      return inside;
    }

    function pointInGeom(x, y, geom) {
      if (!geom || !geom.coordinates) return false;
      const polys = geom.type === 'Polygon' ? [geom.coordinates] : (geom.type === 'MultiPolygon' ? geom.coordinates : []);
      for (const poly of polys) {
        if (!poly.length || !pointInRing(x, y, poly[0])) continue;
        let inHole = false;
        for (let h = 1; h < poly.length; h++) {
          if (pointInRing(x, y, poly[h])) { inHole = true; break; }
        }
        if (!inHole) return true;
      }
      return false;
    }

    function computeBrowserNaturaPriaOverlap(opts) {
      const forceRecompute = Boolean(opts && opts.force);
      const lnames = Object.keys(LAYER_RECORDS);
      const natName = lnames.find(k => (LAYER_RECORDS[k] || []).some(r => r.pohityyp !== undefined));
      const priaName = lnames.find(k => (LAYER_RECORDS[k] || []).some(r => r.parandniidu_tyyp !== undefined));
      if (!natName || !priaName) return;
      const natRecs = LAYER_RECORDS[natName] || [];
      const priaRecs = LAYER_RECORDS[priaName] || [];
      if (!natRecs.length || !priaRecs.length) return;
      if (!forceRecompute && natRecs.every(r => r.overlap_pria_ha !== undefined)) return;

      const natGeoms = LAYER_GEOMETRIES[natName] || {};
      const priaGeoms = LAYER_GEOMETRIES[priaName] || {};
      const priaIndex = [];
      priaRecs.forEach(pr => {
        const pfid = String(pr._feature_id ?? '');
        if (!pfid) return;
        const g = (typeof getFeatureGeometry === 'function') ? getFeatureGeometry(priaName, pfid) : priaGeoms[pfid];
        const b = ((typeof getFeatureBbox === 'function') ? getFeatureBbox(priaName, pfid) : null) || geomBbox(g);
        if (b && g) priaIndex.push({ fid: pfid, bbox: b, geom: g });
      });
      if (!priaIndex.length) return;

      const N = 12;
      natRecs.forEach(nr => {
        if (!forceRecompute && nr.overlap_pria_ha !== undefined) return;
        const nfid = String(nr._feature_id ?? '');
        const g = nfid && (typeof getFeatureGeometry === 'function') ? getFeatureGeometry(natName, nfid) : natGeoms[nfid];
        const b = (nfid && (typeof getFeatureBbox === 'function') ? getFeatureBbox(natName, nfid) : null) || geomBbox(g);
        const areaHa = Number(nr.area_ha || nr._geom_area_ha || 0);
        if (!b || !g || areaHa <= 0) {
          nr.overlap_pria_ha = 0;
          nr.overlap_pct = 0;
          delete nr._pria_ov;
          return;
        }
        const cands = priaIndex.filter(p => !(p.bbox[2] < b[0] || p.bbox[0] > b[2] || p.bbox[3] < b[1] || p.bbox[1] > b[3]));
        if (!cands.length) {
          nr.overlap_pria_ha = 0;
          nr.overlap_pct = 0;
          delete nr._pria_ov;
          return;
        }
        let inNat = 0, inPria = 0;
        const candHits = new Array(cands.length).fill(0);
        const dx = (b[2] - b[0]) / N, dy = (b[3] - b[1]) / N;
        for (let ix = 0; ix < N; ix++) {
          const px = b[0] + (ix + 0.5) * dx;
          for (let iy = 0; iy < N; iy++) {
            const py = b[1] + (iy + 0.5) * dy;
            if (!pointInGeom(px, py, g)) continue;
            inNat++;
            let anyHit = false;
            for (let ci = 0; ci < cands.length; ci++) {
              const c = cands[ci];
              if (px >= c.bbox[0] && px <= c.bbox[2] && py >= c.bbox[1] && py <= c.bbox[3] && pointInGeom(px, py, c.geom)) {
                candHits[ci]++;
                anyHit = true;
              }
            }
            if (anyHit) inPria++;
          }
        }
        const ratio = inNat > 0 ? (inPria / inNat) : 0;
        const totOv = Math.round(areaHa * ratio * 100) / 100;
        nr.overlap_pria_ha = totOv;
        nr.overlap_pct = Math.round(ratio * 1000) / 10;
        const pairs = [];
        if (inNat > 0 && totOv > 0) {
          for (let ci = 0; ci < cands.length; ci++) {
            if (candHits[ci] > 0) {
              const pHa = Math.round(areaHa * (candHits[ci] / inNat) * 10000) / 10000;
              if (pHa > 0) pairs.push([cands[ci].fid, pHa]);
            }
          }
        }
        if (pairs.length) {
          nr._pria_ov = pairs;
        } else {
          delete nr._pria_ov;
        }
      });
    }

    let DATA_CATALOG = [];
    let CATALOG_SEARCH_QUERY = '';
    let CATALOG_SOURCE_FILTER = '__all__';
    let CATALOG_ADD_OPEN = false;
    let CATALOG_ADD_TAB = 'ogc';
    let CATALOG_ADD_MSG = '';
    let CATALOG_CAP_LOADING = false;

    function initDataCatalog() {
      const servers = [];
      const byKey = new Map();
      const addSrv = (srv) => {
        if (!srv || !srv.url) return;
        const stype = String(srv.service_type || srv.type || 'wfs').toLowerCase();
        const url = String(srv.url).trim();
        const key = `${stype}|${url.toLowerCase()}`;
        let entry = byKey.get(key);
        if (!entry) {
          entry = {
            id: 'cat_srv_' + servers.length,
            name: String(srv.name || url),
            service_type: stype,
            url: url,
            crs: String(srv.crs || 'EPSG:3301'),
            layers: [],
            custom: Boolean(srv.custom),
          };
          byKey.set(key, entry);
          servers.push(entry);
        }
        const seenL = new Set(entry.layers.map(l => String(l.name || '')));
        (srv.layers || []).forEach(l => {
          const ln = String((l && l.name) || '').trim();
          if (!ln || seenL.has(ln)) return;
          seenL.add(ln);
          entry.layers.push({
            name: ln,
            title: String((l && l.title) || ln).trim(),
            service_type: String((l && l.service_type) || stype).toLowerCase(),
            crs: String((l && l.crs) || entry.crs || 'EPSG:3301'),
          });
        });
      };

      const rawCat = Array.isArray(BUNDLE.data_catalog) ? BUNDLE.data_catalog : [];
      rawCat.forEach(addSrv);
      if (EELIS_CATALOG.length) {
        addSrv({
          name: 'EELIS (Avalik / Keskkonnaagentuur)',
          service_type: 'wfs',
          url: BUNDLE.default_eelis_wfs_url || 'https://gsavalik.envir.ee/geoserver/eelis/ows',
          crs: 'EPSG:3301',
          layers: EELIS_CATALOG.map(x => ({ name: x.name, title: x.title || x.name, service_type: 'wfs' })),
        });
      }
      (BUNDLE.ogc_services || []).forEach(svc => {
        if (!svc || svc.is_basemap || !svc.url) return;
        const ln = svc.typename || svc.layers || svc.name;
        if (!ln) return;
        addSrv({
          name: svc.server_name || svc.name || svc.url,
          service_type: svc.type || 'wfs',
          url: svc.url,
          crs: svc.crs || 'EPSG:3301',
          layers: [{ name: ln, title: svc.name || ln, service_type: svc.type || 'wfs' }],
        });
      });
      DATA_CATALOG = servers;
      updateCatalogButtonLabel();
    }

    function totalCatalogLayerCount() {
      let total = 0;
      (DATA_CATALOG || []).forEach(srv => { total += Array.isArray(srv.layers) ? srv.layers.length : 0; });
      Object.keys(LAYER_RECORDS || {}).forEach(ln => {
        const alreadyListed = (DATA_CATALOG || []).some(srv =>
          (srv.layers || []).some(l => l.title === ln || l.name === ln)
        );
        if (!alreadyListed) total += 1;
      });
      return total;
    }

    function updateCatalogButtonLabel() {
      const btn = document.getElementById('btn-map-catalog');
      if (!btn) return;
      const cnt = totalCatalogLayerCount();
      btn.textContent = (cnt > 0 ? t('html_catalog_btn_count', { count: cnt }) : t('html_catalog_btn')) + ' ▾';
    }

    function _parseOgcCapabilitiesXml(xmlText, serviceType) {
      if (typeof DOMParser === 'undefined' || !xmlText) return [];
      const doc = new DOMParser().parseFromString(xmlText, 'text/xml');
      const nodes = doc.getElementsByTagName('*');
      const found = [];
      const seen = new Set();
      if (String(serviceType || 'wfs').toLowerCase() === 'wms') {
        for (let i = 0; i < nodes.length; i++) {
          if (nodes[i].localName !== 'Layer') continue;
          let name = '', title = '';
          for (let j = 0; j < nodes[i].children.length; j++) {
            const c = nodes[i].children[j];
            if (c.localName === 'Name' && !name) name = (c.textContent || '').trim();
            if (c.localName === 'Title' && !title) title = (c.textContent || '').trim();
          }
          if (name && !seen.has(name)) {
            seen.add(name);
            found.push({ name, title: title || name, service_type: 'wms' });
          }
        }
      } else {
        for (let i = 0; i < nodes.length; i++) {
          if (nodes[i].localName !== 'FeatureType') continue;
          let name = '', title = '';
          for (let j = 0; j < nodes[i].children.length; j++) {
            const c = nodes[i].children[j];
            if (c.localName === 'Name') name = (c.textContent || '').trim();
            if (c.localName === 'Title') title = (c.textContent || '').trim();
          }
          if (name && !seen.has(name)) {
            seen.add(name);
            found.push({ name, title: title || name, service_type: 'wfs' });
          }
        }
      }
      found.sort((a, b) => a.title.localeCompare(b.title));
      return found;
    }

    async function loadCatalogCapabilities(forceAll) {
      if (!DATA_CATALOG.length) initDataCatalog();
      CATALOG_CAP_LOADING = true;
      renderDataCatalogDrawer();
      const targets = forceAll
        ? DATA_CATALOG.filter(s => s && s.url && (s.service_type === 'wfs' || s.service_type === 'wms'))
        : DATA_CATALOG.filter(s => s && s.url && s.url.includes('eelis'));
      await Promise.all(targets.map(async (srv) => {
        const stype = String(srv.service_type || 'wfs').toLowerCase();
        const sep = srv.url.includes('?') ? '&' : '?';
        const capUrl = stype === 'wms'
          ? `${srv.url}${sep}service=WMS&request=GetCapabilities`
          : `${srv.url}${sep}service=WFS&version=2.0.0&request=GetCapabilities`;
        try {
          const resp = await fetch(capUrl);
          if (!resp.ok) return;
          const xmlText = await resp.text();
          const parsed = _parseOgcCapabilitiesXml(xmlText, stype);
          if (parsed.length > 0) {
            srv.layers = parsed.map(x => ({
              name: x.name,
              title: x.title || x.name,
              service_type: stype,
              crs: srv.crs || 'EPSG:3301',
            }));
            if (srv.url.includes('eelis')) {
              EELIS_CATALOG.length = 0;
              parsed.forEach(x => EELIS_CATALOG.push({ name: x.name, title: x.title }));
              EELIS_CAPS_LOADED = true;
              EELIS_CAPS_COUNT = parsed.length;
            }
          }
        } catch (_err) {}
      }));
      CATALOG_CAP_LOADING = false;
      EELIS_CAPS_LOADED = true;
      EELIS_CAPS_COUNT = totalCatalogLayerCount();
      updateCatalogButtonLabel();
      const catDrawer = document.getElementById('map-catalog-drawer');
      if (catDrawer && catDrawer.style.display === 'flex') {
        renderDataCatalogListOnly();
      }
    }

    function toggleMapCatalogPanel() {
      const drawer = document.getElementById('map-catalog-drawer');
      if (!drawer) return;
      const show = drawer.style.display === 'none' || !drawer.style.display;
      if (show) {
        const layDrawer = document.getElementById('map-layers-drawer');
        if (layDrawer) layDrawer.style.display = 'none';
        if (!DATA_CATALOG.length) initDataCatalog();
        renderDataCatalogDrawer();
      }
      drawer.style.display = show ? 'flex' : 'none';
      const btn = document.getElementById('btn-map-catalog');
      if (btn && btn.classList) btn.classList.toggle('active', show);
      if (map) setTimeout(() => map.invalidateSize(), 40);
    }

    function renderDataCatalogDrawer() {
      const drawer = document.getElementById('map-catalog-drawer');
      if (!drawer) return;
      if (!DATA_CATALOG.length) initDataCatalog();
      drawer.innerHTML = '';

      const activeLayerNames = new Set(orderedMapLayerNames());
      const q = String(CATALOG_SEARCH_QUERY || '').trim().toLowerCase();

      // 1. Controls row: Search + Source filter + Sync + Add Data button
      const ctrlRow = document.createElement('div');
      ctrlRow.className = 'cat-controls-row';

      const searchInp = document.createElement('input');
      searchInp.id = 'map-catalog-search';
      searchInp.type = 'search';
      searchInp.placeholder = t('html_catalog_search_ph');
      searchInp.value = CATALOG_SEARCH_QUERY;
      searchInp.oninput = (ev) => {
        CATALOG_SEARCH_QUERY = ev.target.value || '';
        renderDataCatalogListOnly();
      };
      ctrlRow.appendChild(searchInp);

      const srcSel = document.createElement('select');
      srcSel.id = 'map-catalog-source-filter';
      const optAll = document.createElement('option');
      optAll.value = '__all__';
      optAll.textContent = t('html_catalog_all_sources');
      srcSel.appendChild(optAll);
      const optAdded = document.createElement('option');
      optAdded.value = '__inmap__';
      optAdded.textContent = t('html_catalog_source_added');
      srcSel.appendChild(optAdded);
      DATA_CATALOG.forEach(srv => {
        const o = document.createElement('option');
        o.value = srv.id;
        o.textContent = `${srv.name} (${(srv.layers || []).length})`;
        srcSel.appendChild(o);
      });
      srcSel.value = CATALOG_SOURCE_FILTER;
      srcSel.onchange = (ev) => {
        CATALOG_SOURCE_FILTER = ev.target.value || '__all__';
        renderDataCatalogListOnly();
      };
      ctrlRow.appendChild(srcSel);

      const refBtn = document.createElement('button');
      refBtn.type = 'button';
      refBtn.className = 'btn-mini-icon';
      refBtn.title = t('html_catalog_refresh_tip');
      refBtn.textContent = CATALOG_CAP_LOADING ? '⏳' : '🔄';
      refBtn.disabled = Boolean(CATALOG_CAP_LOADING);
      refBtn.onclick = () => loadCatalogCapabilities(true);
      ctrlRow.appendChild(refBtn);

      const addToggleBtn = document.createElement('button');
      addToggleBtn.type = 'button';
      addToggleBtn.className = 'btn-mini-icon' + (CATALOG_ADD_OPEN ? ' active' : '');
      addToggleBtn.textContent = t('html_catalog_add_data_btn');
      addToggleBtn.onclick = () => {
        CATALOG_ADD_OPEN = !CATALOG_ADD_OPEN;
        renderDataCatalogDrawer();
      };
      ctrlRow.appendChild(addToggleBtn);
      drawer.appendChild(ctrlRow);

      // 2. Collapsible "Add Additional Data" panel (OGC WFS/WMS URL or Local GeoJSON/CSV)
      if (CATALOG_ADD_OPEN) {
        const addBox = document.createElement('div');
        addBox.id = 'cat-add-data-panel';
        addBox.className = 'cat-add-panel';
        addBox.style.display = 'flex';

        const tabsRow = document.createElement('div');
        tabsRow.className = 'cat-add-tabs';
        ['ogc', 'file'].forEach(tabKey => {
          const tb = document.createElement('button');
          tb.type = 'button';
          tb.className = 'btn-mini-icon' + (CATALOG_ADD_TAB === tabKey ? ' active' : '');
          tb.textContent = t(tabKey === 'ogc' ? 'html_catalog_tab_ogc' : 'html_catalog_tab_file');
          tb.onclick = () => { CATALOG_ADD_TAB = tabKey; renderDataCatalogDrawer(); };
          tabsRow.appendChild(tb);
        });
        addBox.appendChild(tabsRow);

        if (CATALOG_ADD_TAB === 'ogc') {
          const r1 = document.createElement('div');
          r1.className = 'cat-add-row';
          const tpSel = document.createElement('select');
          tpSel.id = 'cat-ogc-type';
          tpSel.style.maxWidth = '78px';
          ['wfs', 'wms'].forEach(k => {
            const op = document.createElement('option');
            op.value = k; op.textContent = k.toUpperCase();
            tpSel.appendChild(op);
          });
          const urlInp = document.createElement('input');
          urlInp.id = 'cat-ogc-url';
          urlInp.type = 'url';
          urlInp.placeholder = t('html_catalog_ogc_url_ph');
          r1.appendChild(tpSel);
          r1.appendChild(urlInp);
          addBox.appendChild(r1);

          const r2 = document.createElement('div');
          r2.className = 'cat-add-row';
          const nameInp = document.createElement('input');
          nameInp.id = 'cat-ogc-name';
          nameInp.type = 'text';
          nameInp.placeholder = t('html_catalog_ogc_name_ph');
          const lyrInp = document.createElement('input');
          lyrInp.id = 'cat-ogc-layer';
          lyrInp.type = 'text';
          lyrInp.placeholder = t('html_catalog_ogc_layer_ph');
          const discBtn = document.createElement('button');
          discBtn.type = 'button';
          discBtn.className = 'btn-mini-icon';
          discBtn.textContent = t('html_catalog_discover_btn');
          discBtn.onclick = () => discoverOrAddCustomOgcService(true);
          const addOgcBtn = document.createElement('button');
          addOgcBtn.type = 'button';
          addOgcBtn.className = 'btn-mini-icon';
          addOgcBtn.textContent = t('html_catalog_add_ogc_btn');
          addOgcBtn.onclick = () => discoverOrAddCustomOgcService(false);
          r2.appendChild(nameInp);
          r2.appendChild(lyrInp);
          r2.appendChild(discBtn);
          r2.appendChild(addOgcBtn);
          addBox.appendChild(r2);
        } else {
          const lbl = document.createElement('div');
          lbl.style.fontSize = '0.72rem';
          lbl.style.color = 'var(--text-secondary)';
          lbl.textContent = t('html_catalog_file_lbl');
          addBox.appendChild(lbl);

          const rf = document.createElement('div');
          rf.className = 'cat-add-row';
          const fileInp = document.createElement('input');
          fileInp.id = 'cat-local-file-input';
          fileInp.type = 'file';
          fileInp.accept = '.geojson,.json,.csv,.tsv,.txt';
          const lnInp = document.createElement('input');
          lnInp.id = 'cat-local-layer-name';
          lnInp.type = 'text';
          lnInp.placeholder = t('html_catalog_file_name_ph');
          const goFileBtn = document.createElement('button');
          goFileBtn.type = 'button';
          goFileBtn.className = 'btn-mini-icon';
          goFileBtn.textContent = t('html_catalog_file_btn');
          goFileBtn.onclick = () => addLocalDataFileToMap();
          rf.appendChild(fileInp);
          rf.appendChild(lnInp);
          rf.appendChild(goFileBtn);
          addBox.appendChild(rf);
        }

        if (CATALOG_ADD_MSG) {
          const msgDiv = document.createElement('div');
          msgDiv.id = 'cat-add-status-msg';
          msgDiv.style.fontSize = '0.72rem';
          msgDiv.style.color = CATALOG_ADD_MSG.startsWith('✓') ? 'var(--accent-emerald)' : 'var(--accent-amber)';
          msgDiv.textContent = CATALOG_ADD_MSG;
          addBox.appendChild(msgDiv);
        }
        drawer.appendChild(addBox);
      }

      // 3. Status metadata & scrollable grouped layer list
      const metaRow = document.createElement('div');
      metaRow.className = 'cat-controls-meta';
      const metaLeft = document.createElement('span');
      metaLeft.id = 'map-catalog-meta-txt';
      metaRow.appendChild(metaLeft);
      drawer.appendChild(metaRow);

      const listEl = document.createElement('div');
      listEl.id = 'map-catalog-list';
      listEl.className = 'cat-list-scroll';
      drawer.appendChild(listEl);
      renderDataCatalogListOnly();
    }

    function renderDataCatalogListOnly() {
      const listEl = document.getElementById('map-catalog-list');
      const metaEl = document.getElementById('map-catalog-meta-txt');
      if (!listEl) return;
      listEl.innerHTML = '';

      const q = String(CATALOG_SEARCH_QUERY || '').trim().toLowerCase();
      const srcFilter = String(CATALOG_SOURCE_FILTER || '__all__');
      const activeSet = new Set(orderedMapLayerNames());
      const groups = [];
      let totalAvail = 0;

      DATA_CATALOG.forEach((srv, srvIdx) => {
        const srvLayers = Array.isArray(srv.layers) ? srv.layers : [];
        totalAvail += srvLayers.length;
        if (srcFilter !== '__all__' && srcFilter !== '__inmap__' && srv.id !== srcFilter) return;
        const matched = [];
        srvLayers.forEach((lyr, lyrIdx) => {
          const title = String(lyr.title || lyr.name || '');
          const name = String(lyr.name || '');
          const inMap = activeSet.has(title) || activeSet.has(name);
          if (srcFilter === '__inmap__' && !inMap) return;
          if (q) {
            const hay = `${title} ${name} ${srv.name} ${lyr.service_type || srv.service_type}`.toLowerCase();
            if (!hay.includes(q)) return;
          }
          matched.push({ srv, srvIdx, lyr, lyrIdx, inMap });
        });
        if (matched.length) groups.push({ title: srv.name, items: matched });
      });

      // Include any dynamic local/file layers already loaded into LAYER_RECORDS not listed under a server
      const localItems = [];
      Object.keys(LAYER_RECORDS || {}).forEach(ln => {
        const listed = DATA_CATALOG.some(s => (s.layers || []).some(l => l.title === ln || l.name === ln));
        if (listed) return;
        totalAvail += 1;
        if (srcFilter !== '__all__' && srcFilter !== '__inmap__') return;
        const inMap = activeSet.has(ln);
        if (srcFilter === '__inmap__' && !inMap) return;
        if (q && !`${ln} local fail geojson csv`.toLowerCase().includes(q)) return;
        localItems.push({
          srv: { name: t('html_catalog_source_added'), url: '', service_type: 'file' },
          srvIdx: -1,
          lyr: { name: ln, title: ln, service_type: 'file' },
          lyrIdx: -1,
          inMap,
        });
      });
      if (localItems.length) groups.unshift({ title: t('html_catalog_source_added'), items: localItems });

      const totalMatched = groups.reduce((acc, g) => acc + g.items.length, 0);
      const maxRender = q ? 120 : 60;
      let rendered = 0;

      groups.forEach(grp => {
        if (rendered >= maxRender) return;
        const gh = document.createElement('div');
        gh.className = 'cat-group-hdr';
        gh.textContent = `${grp.title} (${grp.items.length})`;
        listEl.appendChild(gh);

        for (let i = 0; i < grp.items.length && rendered < maxRender; i++) {
          const it = grp.items[i];
          rendered++;
          const row = document.createElement('div');
          row.className = 'cat-item-row';

          const info = document.createElement('div');
          info.className = 'cat-item-main';
          const titleEl = document.createElement('div');
          titleEl.className = 'cat-item-title';
          titleEl.textContent = it.lyr.title || it.lyr.name;
          titleEl.title = `${it.lyr.title || ''} (${it.lyr.name || ''})`;
          const subEl = document.createElement('div');
          subEl.className = 'cat-item-sub';
          subEl.textContent = it.lyr.name;
          info.appendChild(titleEl);
          if (it.lyr.name && it.lyr.name !== it.lyr.title) info.appendChild(subEl);

          const pill = document.createElement('span');
          pill.className = 'cat-type-pill';
          pill.textContent = String(it.lyr.service_type || it.srv.service_type || 'WFS').toUpperCase();

          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'btn-mini-icon' + (it.inMap ? ' active' : '');
          btn.textContent = it.inMap ? t('html_catalog_in_map') : t('html_catalog_add_layer');
          btn.onclick = () => {
            if (it.inMap) {
              MAP_LAYER_VISIBILITY[it.lyr.title] = true;
              MAP_LAYER_VISIBILITY[it.lyr.name] = true;
              if (LAYER_RECORDS[it.lyr.title] || LAYER_RECORDS[it.lyr.name]) {
                const keyName = LAYER_RECORDS[it.lyr.title] ? it.lyr.title : it.lyr.name;
                zoomToLayerExtent(keyName);
              }
              renderAll({ skipAutoZoom: true });
            } else {
              addCatalogItemToMap(it.srvIdx, it.lyrIdx);
            }
          };

          row.appendChild(info);
          row.appendChild(pill);
          row.appendChild(btn);
          listEl.appendChild(row);
        }
      });

      if (!totalMatched) {
        const empty = document.createElement('div');
        empty.style.opacity = '0.72';
        empty.style.padding = '8px 4px';
        empty.textContent = t('html_catalog_empty');
        listEl.appendChild(empty);
      } else if (totalMatched > rendered) {
        const hint = document.createElement('div');
        hint.style.opacity = '0.75';
        hint.style.fontSize = '0.71rem';
        hint.style.padding = '4px';
        hint.textContent = t('html_catalog_more_hint', { shown: rendered, total: totalMatched });
        listEl.appendChild(hint);
      }
      if (metaEl) {
        metaEl.textContent = t('html_catalog_status', { shown: totalMatched, total: totalAvail });
      }
    }

    function zoomToLayerExtent(layerName) {
      if (!map || !layerName || typeof safeFitBounds !== 'function') return;
      const pts = [];
      (LAYER_RECORDS[layerName] || []).forEach(r => {
        const bb = getFeatureBbox(layerName, String(r._feature_id));
        if (bb && bb.length === 4) pts.push([bb[1], bb[0]], [bb[3], bb[2]]);
        else if (r._lat !== undefined && r._lon !== undefined) pts.push([Number(r._lat), Number(r._lon)]);
      });
      if (pts.length) safeFitBounds(pts, { padding: [24, 24], maxZoom: 13 });
    }

    async function addCatalogItemToMap(srvIdx, lyrIdx) {
      const srv = DATA_CATALOG[srvIdx];
      const lyr = srv && srv.layers ? srv.layers[lyrIdx] : null;
      if (!srv || !lyr) return;
      const stype = String(lyr.service_type || srv.service_type || 'wfs').toLowerCase();
      const label = lyr.title || lyr.name;
      const typename = lyr.name;
      const baseUrl = srv.url;
      const sep = baseUrl.includes('?') ? '&' : '?';

      if (stype === 'wms') {
        let svc = (BUNDLE.ogc_services || []).find(s => s.type === 'wms' && s.layers === typename && s.url === baseUrl);
        if (!svc) {
          svc = {
            id: 'wms_' + typename.replace(/[^a-zA-Z0-9_]/g, '_'),
            name: label,
            type: 'wms',
            url: baseUrl,
            layers: typename,
            format: 'image/png',
            version: '1.1.1',
            is_basemap: false,
            crs: srv.crs || 'EPSG:3301',
          };
          BUNDLE.ogc_services = BUNDLE.ogc_services || [];
          BUNDLE.ogc_services.push(svc);
        }
        if (!INITIAL_DATA_LAYER_NAMES.has(svc.name) && !INITIAL_OGC_SERVICES.some(s => s && s.name === svc.name)) {
          DYNAMIC_ADDED_LAYERS.add(svc.name);
        }
        if (!LAYER_RECORDS[svc.name]) LAYER_RECORDS[svc.name] = [];
        MAP_LAYER_VISIBILITY[svc.name] = true;
        const curOrder = ensureCustomMapLayerOrder().filter(n => n !== svc.name);
        curOrder.unshift(svc.name);
        CUSTOM_MAP_LAYERS = curOrder.slice();
        const mapWidget = (DASHBOARD.widgets || []).find(w => w.widget_type === 'map');
        if (mapWidget) mapWidget.map_layers = CUSTOM_MAP_LAYERS.slice();
        if (map && typeof L !== 'undefined' && L.tileLayer && typeof L.tileLayer.wms === 'function') {
          const wmsLyr = L.tileLayer.wms(baseUrl, {
            version: '1.1.1',
            layers: typename,
            format: 'image/png',
            transparent: true,
            attribution: '&copy; OGC WMS'
          });
          LAYER_WMS_OVERLAYS[svc.name] = wmsLyr;
          if (!LAYER_OVERLAYS[svc.name]) LAYER_OVERLAYS[svc.name] = L.layerGroup().addTo(map);
          wmsLyr.addTo(map);
        }
        renderMapLayersDrawer();
        renderDataCatalogListOnly();
        renderAll({ skipAutoZoom: true });
        updateCatalogButtonLabel();
        return;
      }

      const geojsonUrl = `${baseUrl}${sep}service=WFS&version=2.0.0&request=GetFeature&typeNames=${encodeURIComponent(typename)}&outputFormat=application/json&srsName=EPSG:4326&count=5000`;
      let svc = (BUNDLE.ogc_services || []).find(s => s.typename === typename || s.name === label);
      if (!svc) {
        svc = {
          id: 'wfs_' + typename.replace(/[^a-zA-Z0-9_]/g, '_'),
          name: label,
          type: 'wfs',
          url: baseUrl,
          geojson_url: geojsonUrl,
          typename: typename,
          crs: srv.crs || 'EPSG:3301',
          page_size: 5000,
          restrict_to_bbox: /(kataster|ky_kehtiv|etak|kitsendus)/i.test(typename),
          layer_color: /kaitseala|loodusala|hoiuala|linnuala|püsielupaik/i.test(typename + ' ' + label)
            ? '#f97316'
            : (/natura|elupaik/i.test(typename + ' ' + label) ? '#10b981' : '#0ea5e9')
        };
        BUNDLE.ogc_services = BUNDLE.ogc_services || [];
        BUNDLE.ogc_services.push(svc);
      }
      if (!INITIAL_DATA_LAYER_NAMES.has(svc.name) && !INITIAL_OGC_SERVICES.some(s => s && s.name === svc.name)) {
        DYNAMIC_ADDED_LAYERS.add(svc.name);
      }
      MAP_LAYER_VISIBILITY[svc.name] = true;
      const curOrder = ensureCustomMapLayerOrder().filter(n => n !== svc.name);
      curOrder.unshift(svc.name);
      CUSTOM_MAP_LAYERS = curOrder.slice();
      const mapWidget = (DASHBOARD.widgets || []).find(w => w.widget_type === 'map');
      if (mapWidget) mapWidget.map_layers = CUSTOM_MAP_LAYERS.slice();
      if (!LAYER_OVERLAYS[svc.name] && map) {
        IS_SYNCING_MAP_LAYERS += 1;
        try {
          const grp = L.layerGroup().addTo(map);
          LAYER_OVERLAYS[svc.name] = grp;
          if (layerControl && typeof layerControl.addOverlay === 'function') {
            layerControl.addOverlay(grp, svc.name);
          }
        } finally {
          IS_SYNCING_MAP_LAYERS -= 1;
        }
        syncLeafletLayerControlActions();
      }
      await fetchSingleWfsService(svc);
      renderMapLayersDrawer();
      renderDataCatalogListOnly();
      buildSlicers();
      renderAll({ skipAutoZoom: true });
      updateCatalogButtonLabel();
    }

    async function discoverOrAddCustomOgcService(forceDiscover) {
      const stypeEl = document.getElementById('cat-ogc-type');
      const urlEl = document.getElementById('cat-ogc-url');
      const nameEl = document.getElementById('cat-ogc-name');
      const lyrEl = document.getElementById('cat-ogc-layer');
      const rawUrl = urlEl ? String(urlEl.value || '').trim() : '';
      if (!rawUrl) return;
      const stype = stypeEl ? String(stypeEl.value || 'wfs').toLowerCase() : 'wfs';
      const srvName = (nameEl && String(nameEl.value || '').trim()) || rawUrl.replace(/^https?:\/\//i, '').split('/')[0];
      const explicitLayer = lyrEl ? String(lyrEl.value || '').trim() : '';

      let srv = DATA_CATALOG.find(s => s.service_type === stype && s.url.toLowerCase() === rawUrl.toLowerCase());
      if (!srv) {
        srv = {
          id: 'cat_custom_' + DATA_CATALOG.length,
          name: srvName,
          service_type: stype,
          url: rawUrl,
          crs: 'EPSG:3301',
          layers: [],
          custom: true,
        };
        DATA_CATALOG.unshift(srv);
      }

      if (explicitLayer && !forceDiscover) {
        let idx = srv.layers.findIndex(l => l.name === explicitLayer);
        if (idx < 0) {
          srv.layers.unshift({
            name: explicitLayer,
            title: (nameEl && String(nameEl.value || '').trim()) || explicitLayer,
            service_type: stype,
            crs: 'EPSG:3301',
          });
          idx = 0;
        }
        CATALOG_ADD_MSG = `✓ ${explicitLayer}`;
        updateCatalogButtonLabel();
        await addCatalogItemToMap(DATA_CATALOG.indexOf(srv), idx);
        renderDataCatalogDrawer();
        return;
      }

      const sep = rawUrl.includes('?') ? '&' : '?';
      const capUrl = stype === 'wms'
        ? `${rawUrl}${sep}service=WMS&request=GetCapabilities`
        : `${rawUrl}${sep}service=WFS&version=2.0.0&request=GetCapabilities`;
      try {
        const resp = await fetch(capUrl);
        if (!resp.ok) throw new Error('HTTP ' + resp.status);
        const xmlText = await resp.text();
        const found = _parseOgcCapabilitiesXml(xmlText, stype);
        if (!found.length) throw new Error('No layers returned');
        srv.layers = found.map(x => ({ name: x.name, title: x.title || x.name, service_type: stype, crs: 'EPSG:3301' }));
        CATALOG_SOURCE_FILTER = srv.id;
        CATALOG_ADD_MSG = t('html_catalog_discovered', { count: found.length, name: srv.name });
      } catch (err) {
        CATALOG_ADD_MSG = t('html_catalog_err', { msg: (err && err.message) ? err.message : String(err) });
      }
      updateCatalogButtonLabel();
      renderDataCatalogDrawer();
    }

    function _normalizeGeoJsonCoordsWgs84(coords) {
      if (!Array.isArray(coords)) return coords;
      if (coords.length >= 2 && typeof coords[0] === 'number' && typeof coords[1] === 'number') {
        const x = Number(coords[0]), y = Number(coords[1]);
        if (Math.abs(x) > 1000 && Math.abs(y) > 1000000) {
          return estonia3301ToWgs84(x, y);
        }
        return coords;
      }
      return coords.map(_normalizeGeoJsonCoordsWgs84);
    }

    function _parseDelimitedRows(text) {
      const lines = String(text || '').replace(/^\uFEFF/, '').split(/\r?\n/).filter(l => l.trim() !== '');
      if (lines.length < 2) return [];
      const first = lines[0];
      const delim = (first.split(';').length > first.split(',').length)
        ? ';'
        : ((first.split('\t').length > first.split(',').length) ? '\t' : ',');
      const splitLine = (ln) => {
        const out = [];
        let cur = '', inQ = false;
        for (let i = 0; i < ln.length; i++) {
          const ch = ln[i];
          if (ch === '"') {
            if (inQ && ln[i + 1] === '"') { cur += '"'; i++; }
            else inQ = !inQ;
          } else if (ch === delim && !inQ) {
            out.push(cur.trim()); cur = '';
          } else {
            cur += ch;
          }
        }
        out.push(cur.trim());
        return out;
      };
      const headers = splitLine(lines[0]);
      const rows = [];
      for (let i = 1; i < lines.length; i++) {
        const vals = splitLine(lines[i]);
        const obj = {};
        headers.forEach((h, hi) => {
          if (h) obj[h] = vals[hi] !== undefined ? vals[hi] : '';
        });
        rows.push(obj);
      }
      return rows;
    }

    function ingestCustomBrowserGeoJson(layerName, features) {
      if (!layerName || !Array.isArray(features) || !features.length) return 0;
      const normalized = features.map(f => {
        if (!f || !f.geometry || !f.geometry.coordinates) return f;
        return Object.assign({}, f, {
          geometry: Object.assign({}, f.geometry, {
            coordinates: _normalizeGeoJsonCoordsWgs84(f.geometry.coordinates)
          })
        });
      });
      if (!LAYER_RECORDS[layerName]) LAYER_RECORDS[layerName] = [];
      ingestGeoJsonFeatures(layerName, normalized, { mergeExisting: true, lod: 3 });
      DYNAMIC_ADDED_LAYERS.add(layerName);
      MAP_LAYER_VISIBILITY[layerName] = true;
      const curOrder = ensureCustomMapLayerOrder().filter(n => n !== layerName);
      curOrder.unshift(layerName);
      CUSTOM_MAP_LAYERS = curOrder.slice();
      const mapWidget = (DASHBOARD.widgets || []).find(w => w.widget_type === 'map');
      if (mapWidget) mapWidget.map_layers = CUSTOM_MAP_LAYERS.slice();
      if (!LAYER_OVERLAYS[layerName] && map) {
        IS_SYNCING_MAP_LAYERS += 1;
        try {
          const grp = L.layerGroup().addTo(map);
          LAYER_OVERLAYS[layerName] = grp;
          if (layerControl && typeof layerControl.addOverlay === 'function') layerControl.addOverlay(grp, layerName);
        } finally { IS_SYNCING_MAP_LAYERS -= 1; }
        syncLeafletLayerControlActions();
      }
      updateCatalogButtonLabel();
      renderMapLayersDrawer();
      buildSlicers();
      renderAll({ skipAutoZoom: true });
      zoomToLayerExtent(layerName);
      return normalized.length;
    }

    async function addLocalDataFileToMap() {
      const fileInp = document.getElementById('cat-local-file-input');
      const nameInp = document.getElementById('cat-local-layer-name');
      const file = fileInp && fileInp.files ? fileInp.files[0] : null;
      if (!file) return;
      const fallbackName = String(file.name || 'Lisakiht').replace(/\.[^.]+$/, '');
      const layerName = (nameInp && String(nameInp.value || '').trim()) || fallbackName;
      try {
        const rawText = (typeof file.text === 'function')
          ? await file.text()
          : await new Promise((res, rej) => {
              const fr = new FileReader();
              fr.onload = () => res(String(fr.result || ''));
              fr.onerror = () => rej(fr.error || new Error('File read error'));
              fr.readAsText(file);
            });
        let feats = [];
        if (/\.json$/i.test(file.name) || rawText.trim().startsWith('{') || rawText.trim().startsWith('[')) {
          const parsed = JSON.parse(rawText);
          if (parsed && parsed.type === 'FeatureCollection' && Array.isArray(parsed.features)) feats = parsed.features;
          else if (parsed && parsed.type === 'Feature') feats = [parsed];
          else if (Array.isArray(parsed)) feats = parsed;
        } else {
          const rows = _parseDelimitedRows(rawText);
          if (rows.length) {
            const cols = Object.keys(rows[0]);
            const xCol = cols.find(c => /^(lon|lng|longitude|x|east|e)$/i.test(c.trim()));
            const yCol = cols.find(c => /^(lat|latitude|y|north|n)$/i.test(c.trim()));
            if (!xCol || !yCol) throw new Error('CSV requires X/Lon & Y/Lat columns');
            rows.forEach((r, idx) => {
              const xv = Number(String(r[xCol] || '').replace(',', '.'));
              const yv = Number(String(r[yCol] || '').replace(',', '.'));
              if (!Number.isFinite(xv) || !Number.isFinite(yv)) return;
              feats.push({
                type: 'Feature',
                id: `${layerName}_${idx}`,
                properties: r,
                geometry: { type: 'Point', coordinates: [xv, yv] }
              });
            });
          }
        }
        if (!feats.length) throw new Error('No spatial features parsed');
        const nAdded = ingestCustomBrowserGeoJson(layerName, feats);
        CATALOG_ADD_MSG = t('html_catalog_file_added', { count: nAdded, name: layerName });
      } catch (err) {
        CATALOG_ADD_MSG = t('html_catalog_err', { msg: (err && err.message) ? err.message : String(err) });
      }
      renderDataCatalogDrawer();
    }


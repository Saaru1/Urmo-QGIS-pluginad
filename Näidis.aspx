            if (isFinite(cMinX)) {
              fetchBb = [
                Math.max(viewBb[0], cMinX - 0.001),
                Math.max(viewBb[1], cMinY - 0.001),
                Math.min(viewBb[2], cMaxX + 0.001),
                Math.min(viewBb[3], cMaxY + 0.001)
              ];
            }
            layerCandidates.push({ ln, cands, needsFullFetch, fetchBb });
          }
        }

        if (!layerCandidates.length) {
          alert(t('gpkg_empty_view'));
          return;
        }

        const layersNeedingFull = layerCandidates.filter(lc => lc.needsFullFetch && (HAS_PREVIEW_API || findLiveWfsService(lc.ln)));
        if (layersNeedingFull.length > 0) {
          beginBusyOp(t('gpkg_fetching_full'));
          try {
            await Promise.all(layersNeedingFull.map(lc => _fetchFullViewportGeometriesForGpkg(lc.ln, lc.fetchBb)));
          } finally {
            endBusyOp();
          }
        }

        let skippedNoFullCount = 0;
        const layersSpec = [];
        for (const lc of layerCandidates) {
          const ln = lc.ln;
          const hasLiveSource = Boolean(HAS_PREVIEW_API || findLiveWfsService(ln));
          const colsSet = new Set();
          const feats = [];
          for (const item of lc.cands) {
            const row = item.row;
            const fidStr = item.fidStr;
            const curLod = fidStr ? Number(((LAYER_GEOM_LOD[ln] || {})[fidStr]) || 0) : 0;
            let geom = null;
            if (fidStr && LAYER_GEOMETRIES[ln] && LAYER_GEOMETRIES[ln][fidStr] && curLod >= 3) {
              geom = LAYER_GEOMETRIES[ln][fidStr];
            } else if (item.isPurePoint) {
              geom = { type: 'Point', coordinates: [Number(row._lon), Number(row._lat)] };
            } else if (!hasLiveSource) {
              // Static non-WFS offline layer: allow decoded real polygon/line geometry only, NEVER a synthetic bbox rectangle
              const realCached = fidStr ? getFeatureGeometry(ln, fidStr) : null;
              if (realCached) geom = realCached;
            }
            if (!geom) {
              skippedNoFullCount++;
              continue;
            }
            const fb = (fidStr && getFeatureBbox(ln, fidStr)) || geomBbox(geom) || item.bb;
            const insideView = fb && fb[0] >= viewBb[0] && fb[1] >= viewBb[1] && fb[2] <= viewBb[2] && fb[3] <= viewBb[3];
            if (!insideView && viewGeom && !geomIntersectsGeom(geom, viewGeom)) continue;
            const props = {};
            Object.entries(row).forEach(([k, v]) => {
              if (!k.startsWith('_')) {
                colsSet.add(k);
                props[k] = v;
              }
            });
            feats.push({ geometry: geom, properties: props });
          }
          if (feats.length > 0) {
            layersSpec.push({
              name: ln,
              label: ln,
              columns: Array.from(colsSet).slice(0, 60),
              features: feats
            });
          }
        }

        if (!layersSpec.length) {
          alert(skippedNoFullCount > 0 ? t('gpkg_no_full_geom') : t('gpkg_empty_view'));
          return;
        }
        const gpkgBytes = buildGeoPackageUint8Array(layersSpec);
        const totalSaved = layersSpec.reduce((s, l) => s + l.features.length, 0);
        const doneStatusKey = skippedNoFullCount > 0 ? 'gpkg_skipped_approx' : 'gpkg_saved_status';
        const doneStatusVars = { count: totalSaved, skipped: skippedNoFullCount };
        const rawTitle = String(DASHBOARD.title || 'dashboard').normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/[^a-zA-Z0-9_-]+/g, '_').replace(/^_+|_+$/g, '') || 'dashboard';
        const fname = `${rawTitle}_viewport.gpkg`;

        if (typeof window.showSaveFilePicker === 'function') {
          try {
            const handle = await window.showSaveFilePicker({
              suggestedName: fname,
              types: [{ description: 'OGC GeoPackage', accept: { 'application/geopackage+sqlite3': ['.gpkg'] } }]
            });
            const writable = await handle.createWritable();
            await writable.write(gpkgBytes);
            await writable.close();
            setLiveStatus(doneStatusKey, doneStatusVars);
            return;
          } catch (pickErr) {
            if (pickErr && pickErr.name === 'AbortError') return;
          }
        }
        const blob = new Blob([gpkgBytes], { type: 'application/geopackage+sqlite3' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = fname;
        document.body.appendChild(a);
        a.click();
        setTimeout(() => {
          URL.revokeObjectURL(url);
          if (a.parentNode) a.parentNode.removeChild(a);
        }, 1000);
        setLiveStatus(doneStatusKey, doneStatusVars);
      } catch (err) {
        console.error('GeoPackage export failed', err);
      } finally {
        endBusyOp();
      }
    }

    function setHostExtentFilter(enabled) {
      const next = Boolean(enabled);
      EXTENT_FILTER_ENABLED = next;
      if (typeof DASHBOARD === 'object' && DASHBOARD) DASHBOARD.filter_by_map_extent = next;
      saveDashboardSessionState();
      updateExtentButtonUI();
      triggerRenderWithBusyFeedback({ skipAutoZoom: true });
      return EXTENT_FILTER_ENABLED;
    }

    function toggleExtentFilter() {
      return setHostExtentFilter(!EXTENT_FILTER_ENABLED);
    }

    function updateExtentButtonUI() {
      const btn = document.getElementById('btn-extent-filter');
      if (!btn) return;
      btn.textContent = EXTENT_FILTER_ENABLED ? t('html_extent_on') : t('html_extent_off');
      btn.classList.toggle('active', EXTENT_FILTER_ENABLED);
    }

    function setHostTheme(nextTheme) {
      const norm = String(nextTheme || '').toLowerCase() === 'light' ? 'light' : 'dark';
      const html = document.documentElement;
      html.dataset.theme = norm;
      if (typeof DASHBOARD === 'object' && DASHBOARD) DASHBOARD.theme = norm;
      renderAll({ skipAutoZoom: true });
      return norm;
    }

    function toggleTheme() {
      const html = document.documentElement;
      const next = html.dataset.theme === 'light' ? 'dark' : 'light';
      return setHostTheme(next);
    }

    function buildSlicers() {
      const bar = document.getElementById('slicer-bar');
      if (!bar) return;
      document.querySelectorAll('#workspace-main > .slicer-group').forEach(el => el.remove());
      bar.innerHTML = '';
      (DASHBOARD.slicers || []).forEach(sl => {
        if (sl.page_id && !sl.is_global && String(sl.page_id) !== String(ACTIVE_PAGE_ID || 'page_1')) return;
        const group = document.createElement('div');
        group.className = 'slicer-group';
        group.dataset.slicerId = sl.id;
        const hdr = document.createElement('div');
        hdr.style.display = 'flex';
        hdr.style.alignItems = 'center';
        hdr.style.justifyContent = 'space-between';
        hdr.style.gap = '6px';
        hdr.style.width = '100%';
        const lbl = document.createElement('span');
        lbl.className = 'slicer-label';
        lbl.textContent = localizedTitle(sl) + ':';
        hdr.appendChild(lbl);
        const hasSlFilter = Object.keys(ACTIVE_FILTERS).some(k => k === sl.id || k.startsWith(sl.id + '__pane_'));
        if (hasSlFilter) {
          const clrBtn = document.createElement('button');
          clrBtn.type = 'button';
          clrBtn.className = 'btn-clear-widget';
          clrBtn.textContent = '✕';
          clrBtn.title = t('btn_clear_filter');
          clrBtn.onclick = () => clearWidgetFilter(sl.id);
          hdr.appendChild(clrBtn);
        }
        group.appendChild(hdr);

        const _triggerSlicerRender = () => {
          if (typeof renderActiveFiltersBanner === 'function') renderActiveFiltersBanner();
          if (typeof triggerRenderWithBusyFeedback === 'function') triggerRenderWithBusyFeedback();
          else renderAll();
        };

        if (Array.isArray(sl.panes) && sl.panes.length > 0) {
          const panesWrap = document.createElement('div');
          panesWrap.className = 'slicer-multi-panes';
          sl.panes.forEach((pane, pi) => {
            const paneId = `${sl.id}__pane_${pi}`;
            const paneEl = document.createElement('div');
            paneEl.className = 'slicer-subpane';
            const pTitle = document.createElement('div');
            pTitle.className = 'slicer-subpane-hdr';
            pTitle.textContent = pane.title || pane.field_name || (pane.type === 'address' ? t('addr_pane_title') : `Pane ${pi + 1}`);
            paneEl.appendChild(pTitle);

            if (pane.type === 'address') {
              const addrRow = document.createElement('div');
              addrRow.style.display = 'flex';
              addrRow.style.gap = '4px';
              const aInp = document.createElement('input');
              aInp.type = 'search';
              aInp.className = 'slicer-search';
              aInp.placeholder = t('addr_search_ph');
              const curPaneFlt = ACTIVE_FILTERS[paneId];
              if (curPaneFlt && curPaneFlt.display_label) aInp.value = curPaneFlt.display_label;
              const aBtn = document.createElement('button');
              aBtn.type = 'button';
              aBtn.className = 'btn-mini-icon';
              aBtn.textContent = '🔍';
              const aRes = document.createElement('div');
              aRes.className = 'map-addr-results';
              aRes.style.position = 'static';
              aRes.style.maxHeight = '120px';

              const runPaneAddr = async () => {
                const q = String(aInp.value || '').trim();
                if (q.length < 2) return;
                const url = 'https://inaadress.maaamet.ee/inaadress/gazetteer?address=' + encodeURIComponent(q) + '&results=8&features=KATASTRIYKSUS,EHITISHOONE,Kinnistu,TANAV,ASULAKOHT';
                try {
                  const resp = await fetch(url);
                  const data = await resp.json();
                  const cands = Array.isArray(data && data.addresses) ? data.addresses : [];
                  aRes.innerHTML = '';
                  aRes.style.display = cands.length ? 'block' : 'none';
                  cands.slice(0, 8).forEach(cand => {
                    const optBtn = document.createElement('button');
                    optBtn.type = 'button';
                    optBtn.className = 'map-addr-opt';
                    const disp = cand.ipikkaadress || cand.taisaadress || cand.koodaadress || q;
                    optBtn.textContent = disp;
                    optBtn.onclick = () => {
                      const geomWgs = cand.geometry ? _convertEstGeomToWgs84(cand.geometry) : null;
                      let bb = geomWgs ? geomBbox(geomWgs) : null;
                      let geom = geomWgs;
                      if (!geom && cand.viitepunkt_b && cand.viitepunkt_l) {
                        const buf = _pointWgs84BufferGeom(Number(cand.viitepunkt_b), Number(cand.viitepunkt_l));
                        geom = buf.geometry;
                        bb = buf.bbox;
                      } else if (!geom && cand.viitepunkt_x && cand.viitepunkt_y) {
                        const ll = _toWgs84Coord(cand.viitepunkt_x, cand.viitepunkt_y);
                        if (ll) {
                          const buf = _pointWgs84BufferGeom(ll[0], ll[1]);
                          geom = buf.geometry;
                          bb = buf.bbox;
                        }
                      }
                      ACTIVE_FILTERS[paneId] = {
                        layer_name: '__spatial__',
                        field_name: 'address',
                        type: 'spatial_geom',
                        geometry: geom,
                        bbox: bb,
                        display_label: disp,
                        page_id: sl.page_id || ACTIVE_PAGE_ID,
                        is_global: Boolean(sl.is_global)
                      };
                      LAST_INTERACTED_FILTER_SOURCE = paneId;
                      saveDashboardSessionState();
                      buildSlicers();
                      _triggerSlicerRender();
                    };
                    aRes.appendChild(optBtn);
                  });
                } catch (_e) {}
              };
              aBtn.onclick = runPaneAddr;
              aInp.onkeydown = ev => { if (ev.key === 'Enter') { ev.preventDefault(); runPaneAddr(); } };
              addrRow.appendChild(aInp);
              addrRow.appendChild(aBtn);
              if (curPaneFlt) {
                const xBtn = document.createElement('button');
                xBtn.type = 'button';
                xBtn.className = 'btn-mini-icon';
                xBtn.textContent = '✕';
                xBtn.onclick = () => { delete ACTIVE_FILTERS[paneId]; saveDashboardSessionState(); buildSlicers(); _triggerSlicerRender(); };
                addrRow.appendChild(xBtn);
              }
              paneEl.appendChild(addrRow);
              paneEl.appendChild(aRes);
            } else {
              const pLayer = pane.layer_name || sl.layer_name;
              const pField = pane.field_name || sl.field_name;
              const pRows = filterRecords(pLayer, paneId, null);
              const cats = Array.from(new Set(
                pRows.map(r => r[pField]).filter(v => v !== null && v !== undefined && String(v).trim() !== '').map(String)
              )).sort();
              const curVals = ((ACTIVE_FILTERS[paneId] && ACTIVE_FILTERS[paneId].values) || []).map(String);
              const sel = document.createElement('select');
              sel.className = 'slicer-select';
              const noneOpt = document.createElement('option');
              noneOpt.value = '';
              noneOpt.textContent = t('slicer_no_filter');
              sel.appendChild(noneOpt);
              cats.forEach(c => {
                const opt = document.createElement('option');
                opt.value = c; opt.textContent = c;
                sel.appendChild(opt);
              });
              sel.value = curVals[0] || '';
              sel.onchange = () => {
                if (!sel.value) delete ACTIVE_FILTERS[paneId];
                else {
                  ACTIVE_FILTERS[paneId] = {
                    layer_name: pLayer,
                    field_name: pField,
                    type: 'category',
                    multi: false,
                    values: [sel.value],
                    page_id: sl.page_id || ACTIVE_PAGE_ID,
                    is_global: Boolean(sl.is_global)
                  };
                }
                LAST_INTERACTED_FILTER_SOURCE = paneId;
                saveDashboardSessionState();
                buildSlicers();
                _triggerSlicerRender();
              };
              paneEl.appendChild(sel);
            }
            panesWrap.appendChild(paneEl);
          });
          group.appendChild(panesWrap);
          bar.appendChild(group);
          return;
        }

        const allLayerRows = LAYER_RECORDS[sl.layer_name] || Object.values(LAYER_RECORDS)[0] || [];
        const slType = String(sl.slicer_type || 'category').toLowerCase();
        const rows = (sl.cascade_filters !== false && typeof filterRecords === 'function')
          ? filterRecords(sl.layer_name, sl.id, null)
          : allLayerRows;

        if (slType === 'numeric_range') {
          const nums = (rows.length ? rows : allLayerRows)
            .map(r => (r && r[sl.field_name] !== null && r[sl.field_name] !== undefined && r[sl.field_name] !== '') ? Number(r[sl.field_name]) : NaN)
            .filter(n => Number.isFinite(n));
          const dMin = nums.length ? Math.min(...nums) : 0;
          const dMax = nums.length ? Math.max(...nums) : 100;
          const curFlt = ACTIVE_FILTERS[sl.id];
          const curMin = (curFlt && curFlt.min !== undefined && curFlt.min !== null) ? curFlt.min : dMin;
          const curMax = (curFlt && curFlt.max !== undefined && curFlt.max !== null) ? curFlt.max : dMax;

          const rangeRow = document.createElement('div');
          rangeRow.className = 'slicer-range-row';
          const minIn = document.createElement('input');
          minIn.type = 'number';
          minIn.autocomplete = 'off';
          minIn.step = 'any';
          minIn.className = 'slicer-range-input';
          minIn.placeholder = t('range_min');
          minIn.value = String(curMin);
          const maxIn = document.createElement('input');
          maxIn.type = 'number';
          maxIn.autocomplete = 'off';
          maxIn.step = 'any';
          maxIn.className = 'slicer-range-input';
          maxIn.placeholder = t('range_max');
          maxIn.value = String(curMax);

          const applyNumRange = () => {
            const rawLo = minIn.value === '' ? null : Number(minIn.value);
            const rawHi = maxIn.value === '' ? null : Number(maxIn.value);
            const lo = (rawLo !== null && Number.isFinite(rawLo)) ? rawLo : null;
            const hi = (rawHi !== null && Number.isFinite(rawHi)) ? rawHi : null;
            const effLo = (lo !== null && hi !== null) ? Math.min(lo, hi) : lo;
            const effHi = (lo !== null && hi !== null) ? Math.max(lo, hi) : hi;
            if (effLo === null && effHi === null) {
              delete ACTIVE_FILTERS[sl.id];
            } else {
              ACTIVE_FILTERS[sl.id] = {
                layer_name: sl.layer_name,
                field_name: sl.field_name,
                type: 'numeric_range',
                min: effLo,
                max: effHi,
                page_id: sl.page_id || ACTIVE_PAGE_ID,
                is_global: Boolean(sl.is_global)
              };
            }
            saveDashboardSessionState();
            buildSlicers();
            _triggerSlicerRender();
          };
          const resetNumRange = () => {
            delete ACTIVE_FILTERS[sl.id];
            saveDashboardSessionState();
            buildSlicers();
            _triggerSlicerRender();
          };
          minIn.onchange = applyNumRange;
          maxIn.onchange = applyNumRange;
          const btnApply = document.createElement('button');
          btnApply.type = 'button';
          btnApply.className = 'slicer-range-btn slicer-range-btn-primary';
          btnApply.textContent = t('range_apply');
          btnApply.onclick = applyNumRange;
          const btnAll = document.createElement('button');
          btnAll.type = 'button';
          btnAll.className = 'slicer-range-btn';
          btnAll.textContent = t('slicer_all');
          btnAll.onclick = resetNumRange;
          const sep = document.createElement('span');
          sep.textContent = '–';
          rangeRow.appendChild(minIn);
          rangeRow.appendChild(sep);
          rangeRow.appendChild(maxIn);
          rangeRow.appendChild(btnApply);
          rangeRow.appendChild(btnAll);
          group.appendChild(rangeRow);
          bar.appendChild(group);
          return;
        }

        if (slType === 'date_range') {
          const dates = (rows.length ? rows : allLayerRows)
            .map(r => (r && r[sl.field_name] !== null && r[sl.field_name] !== undefined) ? String(r[sl.field_name]).trim() : '')
            .filter(s => s.length >= 10)
            .map(s => s.slice(0, 10).replace('/', '-').replace('/', '-'))
            .sort();
          const dMin = dates.length ? dates[0] : '';
          const dMax = dates.length ? dates[dates.length - 1] : '';
          const curFlt = ACTIVE_FILTERS[sl.id];
          const curMin = (curFlt && curFlt.min !== undefined && curFlt.min !== null) ? String(curFlt.min).slice(0, 10) : dMin;
          const curMax = (curFlt && curFlt.max !== undefined && curFlt.max !== null) ? String(curFlt.max).slice(0, 10) : dMax;

          const rangeRow = document.createElement('div');
          rangeRow.className = 'slicer-range-row';
          const minIn = document.createElement('input');
          minIn.type = 'date';
          minIn.autocomplete = 'off';
          minIn.className = 'slicer-range-input';
          minIn.title = t('range_from');
          minIn.value = curMin;
          const maxIn = document.createElement('input');
          maxIn.type = 'date';
          maxIn.autocomplete = 'off';
          maxIn.className = 'slicer-range-input';
          maxIn.title = t('range_to');
          maxIn.value = curMax;

          const applyDateRange = () => {
            const lo = minIn.value ? String(minIn.value).trim() : null;
            const hi = maxIn.value ? String(maxIn.value).trim() : null;
            const effLo = (lo && hi && lo > hi) ? hi : lo;
            const effHi = (lo && hi && lo > hi) ? lo : hi;
            if (!effLo && !effHi) {
              delete ACTIVE_FILTERS[sl.id];
            } else {
              ACTIVE_FILTERS[sl.id] = {
                layer_name: sl.layer_name,
                field_name: sl.field_name,
                type: 'date_range',
                min: effLo,
                max: effHi,
                page_id: sl.page_id || ACTIVE_PAGE_ID,
                is_global: Boolean(sl.is_global)
              };
            }
            saveDashboardSessionState();
            buildSlicers();
            _triggerSlicerRender();
          };
          const resetDateRange = () => {
            delete ACTIVE_FILTERS[sl.id];
            saveDashboardSessionState();
            buildSlicers();
            _triggerSlicerRender();
          };
          minIn.onchange = applyDateRange;
          maxIn.onchange = applyDateRange;
          const btnApply = document.createElement('button');
          btnApply.type = 'button';
          btnApply.className = 'slicer-range-btn slicer-range-btn-primary';
          btnApply.textContent = t('range_apply');
          btnApply.onclick = applyDateRange;
          const btnAll = document.createElement('button');
          btnAll.type = 'button';
          btnAll.className = 'slicer-range-btn';
          btnAll.textContent = t('slicer_all');
          btnAll.onclick = resetDateRange;
          const sep = document.createElement('span');
          sep.textContent = '→';
          rangeRow.appendChild(minIn);
          rangeRow.appendChild(sep);
          rangeRow.appendChild(maxIn);
          rangeRow.appendChild(btnApply);
          rangeRow.appendChild(btnAll);
          group.appendChild(rangeRow);
          bar.appendChild(group);
          return;
        }

        const activeVals = ((ACTIVE_FILTERS[sl.id] && ACTIVE_FILTERS[sl.id].values) || []).map(v => String(v));
        const catSet = new Set(
          rows
            .map(r => r[sl.field_name])
            .filter(v => v !== null && v !== undefined && String(v).trim() !== '')
            .map(v => String(v))
        );
        activeVals.forEach(v => { if (v !== '') catSet.add(v); });
        const cats = Array.from(catSet).sort();

        const toggleCat = val => {
          if (!ACTIVE_FILTERS[sl.id]) {
            ACTIVE_FILTERS[sl.id] = { layer_name: sl.layer_name, field_name: sl.field_name, type: 'category', multi: Boolean(sl.multi_select), values: [], page_id: sl.page_id || ACTIVE_PAGE_ID, is_global: Boolean(sl.is_global) };
          }
          toggleCategoryFilter(sl.id, sl.layer_name, sl.field_name, String(val));
        };

        // Synchronized dropdown showing No filter + ALL distinct category values (matches Design Mode SlicerCardWidget)
        const sel = document.createElement('select');
        sel.className = 'slicer-select';
        sel.autocomplete = 'off';
        const allOpt = document.createElement('option');
        allOpt.value = '';
        allOpt.textContent = t('slicer_no_filter');
        sel.appendChild(allOpt);
        cats.forEach(cat => {
          const opt = document.createElement('option');
          opt.value = String(cat);
          opt.textContent = String(cat);
          sel.appendChild(opt);
        });
        sel.value = activeVals.length ? String(activeVals[0]) : '';
        sel.onchange = () => {
          if (!sel.value) {
            delete ACTIVE_FILTERS[sl.id];
            if (LAST_INTERACTED_FILTER_SOURCE === sl.id) LAST_INTERACTED_FILTER_SOURCE = null;
            saveDashboardSessionState();
            buildSlicers();
            renderAll();
          } else {
            ACTIVE_FILTERS[sl.id] = {
              layer_name: sl.layer_name,
              field_name: sl.field_name,
              type: 'category',
              multi: false,
              values: [sel.value],
              page_id: sl.page_id || ACTIVE_PAGE_ID,
              is_global: Boolean(sl.is_global)
            };
            LAST_INTERACTED_FILTER_SOURCE = sl.id;
            saveDashboardSessionState();
            buildSlicers();
            renderActiveFiltersBanner();
            renderAll();
          }
        };
        group.appendChild(sel);

        const clearSlicerOpt = () => {
          delete ACTIVE_FILTERS[sl.id];
          saveDashboardSessionState();
          buildSlicers();
          _triggerSlicerRender();
        };

        const countEl = document.createElement('div');
        countEl.className = 'slicer-count-meta';
        const prevQuery = SLICER_SEARCH_QUERIES[sl.id] || '';
        const srch = (sl.show_search !== false) ? document.createElement('input') : null;
        if (srch) {
          srch.type = 'search';
          srch.autocomplete = 'off';
          srch.className = 'slicer-search';
          srch.placeholder = t('ph_slicer_search');
          srch.value = prevQuery;
          group.appendChild(srch);
        }

        if (sl.display_mode === 'list') {
          const box = document.createElement('div');
          box.className = 'slicer-list-box';
          const listDiv = document.createElement('div');
          listDiv.className = 'slicer-list-scroll';

          const renderOpts = needle => {
            const n = (needle || '').trim().toLowerCase();
            listDiv.innerHTML = '';
            const noneLbl = document.createElement('label');
            noneLbl.className = 'slicer-list-item slicer-no-filter-item';
            const noneCb = document.createElement('input');
            noneCb.type = 'checkbox';
            noneCb.autocomplete = 'off';
            noneCb.checked = activeVals.length === 0;
            noneCb.onchange = () => clearSlicerOpt();
            const noneTxt = document.createElement('span');
            noneTxt.textContent = t('slicer_no_filter');
            noneLbl.appendChild(noneCb);
            noneLbl.appendChild(noneTxt);
            listDiv.appendChild(noneLbl);

            const matched = cats.filter(c => !n || String(c).toLowerCase().includes(n));
            countEl.textContent = t('slicer_matches_count', { shown: matched.length, total: cats.length });
            matched.forEach(cat => {
              const rowLbl = document.createElement('label');
              rowLbl.className = 'slicer-list-item';
              const cb = document.createElement('input');
              cb.type = 'checkbox';
              cb.autocomplete = 'off';
              cb.checked = activeVals.includes(String(cat));
              cb.onchange = () => toggleCat(cat);
              const txt = document.createElement('span');
              txt.textContent = String(cat);
              rowLbl.appendChild(cb);
              rowLbl.appendChild(txt);
              listDiv.appendChild(rowLbl);
            });
          };
          if (srch) {
            srch.oninput = () => {
              SLICER_SEARCH_QUERIES[sl.id] = srch.value;
              renderOpts(srch.value);
            };
          }
          renderOpts(prevQuery);
          box.appendChild(listDiv);
          box.appendChild(countEl);
          group.appendChild(box);
        } else {
          let chipNeedle = prevQuery;
          const chipWrap = document.createElement('div');
          chipWrap.className = 'slicer-chips-scroll';
          const drawChips = () => {
            chipWrap.innerHTML = '';
            const n = chipNeedle.trim().toLowerCase();
            const matched = cats.filter(c => !n || String(c).toLowerCase().includes(n));
            countEl.textContent = t('slicer_matches_count', { shown: matched.length, total: cats.length });
            matched.forEach(cat => {
              const chip = document.createElement('span');
              chip.className = 'chip' + (activeVals.includes(String(cat)) ? ' selected' : '');
              chip.textContent = String(cat);
              chip.onclick = () => toggleCat(cat);
              chipWrap.appendChild(chip);
            });
          };
          if (srch) {
            srch.oninput = () => {
              chipNeedle = srch.value;
              SLICER_SEARCH_QUERIES[sl.id] = srch.value;
              drawChips();
            };
          }
          drawChips();
          group.appendChild(chipWrap);
          group.appendChild(countEl);
        }
        bar.appendChild(group);
      });
      if (typeof renderActiveFiltersBanner === 'function') renderActiveFiltersBanner();
      if (typeof applyArtboardLayout === 'function') applyArtboardLayout();
    }

    function styleFeatureForLayer(layerName, row, rendererOverride, paneOverride) {
      const svc = (BUNDLE.ogc_services || []).find(s => s.name === layerName);
      const spec = getEffectiveLayerStyleSpec(layerName);
      const custom = spec.custom;
      const qgisStyle = spec.qgisStyle;
      const props = (row && row.properties) ? row.properties : (row || {});
      let color = defaultUniformColor(layerName, custom, svc);
      const outlineOnly = Boolean(custom && custom.outline_only);
      let fillOpacity = outlineOnly
        ? 0.0
        : ((custom && custom.opacity !== undefined)
            ? Number(custom.opacity)
            : ((qgisStyle && qgisStyle.opacity !== undefined) ? Number(qgisStyle.opacity) : 0.42));
      let weight = (custom && custom.stroke_width !== undefined)
        ? Number(custom.stroke_width)
        : ((qgisStyle && qgisStyle.stroke_width !== undefined) ? Number(qgisStyle.stroke_width) : 1.5);
      let dashArray = null;

      const mode = spec.mode;
      const styleFields = spec.styleFields;
      if (mode !== 'single' && styleFields.length > 0) {
        const parts = styleFields.map(f => props[f]).filter(v => v !== null && v !== undefined && String(v).trim() !== '').map(v => String(v));
        if (parts.length) {
          color = resolveCategoryColor(parts.join(' | '), qgisStyle);
        }
      }
      const strokeColor = (custom && custom.border_color && String(custom.border_color).trim())
        ? String(custom.border_color).trim()
        : ((mode === 'single' && (!custom || !custom.color) && qgisStyle && qgisStyle.stroke_color)
            ? qgisStyle.stroke_color
            : color);
      const st = { color: strokeColor, fillColor: color, weight, fillOpacity, opacity: 0.95 };
      const effRenderer = rendererOverride || LAYER_CANVAS_RENDERERS[layerName] || vectorCanvasRenderer;
      if (effRenderer) st.renderer = effRenderer;
      if (paneOverride) st.pane = paneOverride;
      if (dashArray) st.dashArray = dashArray;
      return st;
    }

    function buildPopupHtml(layerName, row) {
      const rowsHtml = Object.entries(row)
        .filter(([k]) => !k.startsWith('_'))
        .slice(0, 14)
        .map(([k, v]) => `<b>${escapeHtml(k)}:</b> ${escapeHtml(v ?? '')}`)
        .join('<br/>');
      return `<div style="font-size:12px;line-height:1.45;"><b>[${escapeHtml(layerName)}]</b><hr style="margin:4px 0"/>${rowsHtml}</div>`;
    }

    function _layerGeomSortRank(ln) {
      const gt = String(LAYER_GEOM_TYPES[ln] || (LAYER_STATS[ln] && LAYER_STATS[ln].geom_type) || '').toLowerCase();
      if (gt.includes('point')) return 0;
      if (gt.includes('line')) return 1;
      if (gt.includes('poly')) return 2;
      return 3;
    }

    function _layerFeatureCountEst(ln) {
      const st = LAYER_STATS[ln] || {};
      const rows = LAYER_RECORDS[ln] || [];
      return Number(st.feature_count || rows.length || 0);
    }

    function orderedMapLayerNames() {
      const mapWidget = (DASHBOARD.widgets || []).find(w => w.widget_type === 'map');
      const allNames = Object.keys(LAYER_RECORDS);
      const preferred = (Array.isArray(CUSTOM_MAP_LAYERS) && CUSTOM_MAP_LAYERS.length)
        ? CUSTOM_MAP_LAYERS
        : ((mapWidget && Array.isArray(mapWidget.map_layers) && mapWidget.map_layers.length) ? mapWidget.map_layers : null);
      if (preferred && preferred.length) {
        const seen = new Set();
        const out = [];
        preferred.forEach(ln => {
          if (ln && LAYER_RECORDS[ln] && !seen.has(ln)) {
            seen.add(ln);
            out.push(ln);
          }
        });
        return out;
      }
      // Smart auto-order (#7): Point < Line < Polygon, ascending feature count (smaller layers on top)
      return allNames.slice().sort((a, b) => {
        const ra = _layerGeomSortRank(a);
        const rb = _layerGeomSortRank(b);
        if (ra !== rb) return ra - rb;
        const ca = _layerFeatureCountEst(a);
        const cb = _layerFeatureCountEst(b);
        if (ca !== cb) return ca - cb;
        return a.localeCompare(b);
      });
    }

    function ensureCustomMapLayerOrder() {
      const order = orderedMapLayerNames();
      CUSTOM_MAP_LAYERS = order.slice();
      const mapWidget = (DASHBOARD.widgets || []).find(w => w.widget_type === 'map');
      if (mapWidget) mapWidget.map_layers = CUSTOM_MAP_LAYERS.slice();
      return CUSTOM_MAP_LAYERS;
    }

    function toggleMapLayersPanel() {
      const drawer = document.getElementById('map-layers-drawer');
      if (!drawer) return;
      const show = drawer.style.display === 'none' || !drawer.style.display;
      if (show) {
        const catDrawer = document.getElementById('map-catalog-drawer');
        if (catDrawer) catDrawer.style.display = 'none';
        const catBtn = document.getElementById('btn-map-catalog');
        if (catBtn && catBtn.classList) catBtn.classList.remove('active');
        renderMapLayersDrawer();
      }
      drawer.style.display = show ? 'flex' : 'none';
      if (map) setTimeout(() => map.invalidateSize(), 40);
    }

    function moveMapLayerOrder(layerName, delta) {
      const order = ensureCustomMapLayerOrder();
      const idx = order.indexOf(layerName);
      const nxt = idx + Number(delta || 0);
      if (idx < 0 || nxt < 0 || nxt >= order.length) return;
      const tmp = order[idx];
      order[idx] = order[nxt];
      order[nxt] = tmp;
      CUSTOM_MAP_LAYERS = order.slice();
      const mapWidget = (DASHBOARD.widgets || []).find(w => w.widget_type === 'map');
      if (mapWidget) {
        mapWidget.map_layers = CUSTOM_MAP_LAYERS.slice();
        mapWidget.map_layers_custom_order = true;
      }
      renderMapLayersDrawer();
      scheduleMapRender({ skipAutoZoom: true });
    }

    function toggleMapLayerVisible(layerName, isVisible) {
      MAP_LAYER_VISIBILITY[layerName] = Boolean(isVisible);
      const grp = LAYER_OVERLAYS[layerName];
      if (grp && map) {
        IS_SYNCING_MAP_LAYERS += 1;
        try {
          if (MAP_LAYER_VISIBILITY[layerName]) {
            if (!map.hasLayer(grp)) grp.addTo(map);
          } else {
            if (map.hasLayer(grp)) map.removeLayer(grp);
            if (LAYER_WMS_OVERLAYS[layerName] && map.hasLayer(LAYER_WMS_OVERLAYS[layerName])) {
              map.removeLayer(LAYER_WMS_OVERLAYS[layerName]);
            }
          }
        } finally {
          IS_SYNCING_MAP_LAYERS -= 1;
        }
      }
      if (layerControl && typeof layerControl._update === 'function') layerControl._update();
      syncLeafletLayerControlActions();
      scheduleMapRender({ skipAutoZoom: true });
    }

    function syncLeafletLayerControlActions() {
      if (!layerControl || typeof layerControl.getContainer !== 'function') return;
      const lc = layerControl.getContainer();
      if (!lc || typeof lc.querySelectorAll !== 'function') return;
      const labels = lc.querySelectorAll('.leaflet-control-layers-overlays label');
      if (!labels || typeof labels.forEach !== 'function') return;
      labels.forEach(lbl => {
        const prevBtn = lbl.querySelector ? lbl.querySelector('.leaflet-layer-remove-btn') : null;
        if (prevBtn && typeof prevBtn.remove === 'function') prevBtn.remove();
        const span = lbl.querySelector ? lbl.querySelector('span') : null;
        const lname = span ? String(span.textContent || '').trim() : '';
        if (!lname || !DYNAMIC_ADDED_LAYERS.has(lname)) return;
        if (lbl.style) {
          lbl.style.display = 'flex';
          lbl.style.alignItems = 'center';
          lbl.style.justifyContent = 'space-between';
          lbl.style.gap = '6px';
        }
        const rmBtn = document.createElement('button');
        rmBtn.type = 'button';
        rmBtn.className = 'leaflet-layer-remove-btn';
        rmBtn.title = t('html_remove_layer');
        rmBtn.textContent = '×';
        rmBtn.onclick = ev => {
          if (ev && ev.preventDefault) ev.preventDefault();
          if (ev && ev.stopPropagation) ev.stopPropagation();
          removeDynamicMapLayer(lname);
        };
        lbl.appendChild(rmBtn);
      });
    }

    function removeDynamicMapLayer(layerName, skipRender) {
      if (!layerName || !DYNAMIC_ADDED_LAYERS.has(layerName)) return;
      DYNAMIC_ADDED_LAYERS.delete(layerName);
      const grp = LAYER_OVERLAYS[layerName];
      const wms = LAYER_WMS_OVERLAYS[layerName];
      IS_SYNCING_MAP_LAYERS += 1;
      try {
        if (grp) {
          if (map && typeof map.hasLayer === 'function' && map.hasLayer(grp)) map.removeLayer(grp);
          if (layerControl && typeof layerControl.removeLayer === 'function') layerControl.removeLayer(grp);
        }
        if (wms) {
          if (map && typeof map.hasLayer === 'function' && map.hasLayer(wms)) map.removeLayer(wms);
          if (layerControl && typeof layerControl.removeLayer === 'function') layerControl.removeLayer(wms);
        }
      } finally {
        IS_SYNCING_MAP_LAYERS -= 1;
      }
      delete LAYER_OVERLAYS[layerName];
      delete LAYER_WMS_OVERLAYS[layerName];
      delete LAYER_RECORDS[layerName];
      delete LAYER_GEOMETRIES[layerName];
      delete LAYER_GEOM_BBOXES[layerName];
      delete LAYER_GEOM_TYPES[layerName];
      delete LAYER_GEOM_LOD[layerName];
      delete LAYER_STATS[layerName];
      delete LAYER_PYRAMID_LOD1[layerName];
      delete VECTOR_PYRAMIDS[layerName];
      delete MAP_LAYER_VISIBILITY[layerName];
      delete LAYER_LAST_MISSING_KEY[layerName];
      const cooldownPrefix = `${layerName}|`;
      Object.keys(LAYER_FETCH_COOLDOWN).forEach(k => {
        if (k.startsWith(cooldownPrefix)) delete LAYER_FETCH_COOLDOWN[k];
      });
      if (Array.isArray(BUNDLE.ogc_services)) {
        BUNDLE.ogc_services = BUNDLE.ogc_services.filter(s => s && s.name !== layerName);
      }
      if (Array.isArray(CUSTOM_MAP_LAYERS)) {
        CUSTOM_MAP_LAYERS = CUSTOM_MAP_LAYERS.filter(n => n !== layerName);
      }
      const mapWidget = (DASHBOARD.widgets || []).find(w => w.widget_type === 'map');
      if (mapWidget && Array.isArray(mapWidget.map_layers)) {
        mapWidget.map_layers = mapWidget.map_layers.filter(n => n !== layerName);
      }
      Object.entries(ACTIVE_FILTERS).forEach(([k, flt]) => {
        if (flt && flt.layer_name === layerName) delete ACTIVE_FILTERS[k];
      });
      if (layerControl && typeof layerControl._update === 'function') layerControl._update();
      syncLeafletLayerControlActions();
      renderMapLayersDrawer();
      if (!skipRender) {
        buildSlicers();
        renderAll({ skipAutoZoom: true });
      }
    }

    function resetDashboardToHome() {
      if (VIEWPORT_REFRESH_TIMER) {
        clearTimeout(VIEWPORT_REFRESH_TIMER);
        VIEWPORT_REFRESH_TIMER = null;
      }
      Array.from(DYNAMIC_ADDED_LAYERS).forEach(ln => removeDynamicMapLayer(ln, true));
      BUNDLE.ogc_services = JSON.parse(JSON.stringify(INITIAL_OGC_SERVICES));
      Object.keys(ACTIVE_FILTERS).forEach(k => delete ACTIVE_FILTERS[k]);
      LAST_INTERACTED_FILTER_SOURCE = null;
      EXTENT_FILTER_ENABLED = false;
      clearDashboardSessionState();
      updateExtentButtonUI();
      clearAddressSearchResult();

      const mapWidget = (DASHBOARD.widgets || []).find(w => w.widget_type === 'map');
      CUSTOM_MAP_LAYERS = INITIAL_LAYER_ORDER ? INITIAL_LAYER_ORDER.slice() : null;
      if (mapWidget) mapWidget.map_layers = INITIAL_LAYER_ORDER ? INITIAL_LAYER_ORDER.slice() : [];
      Object.keys(LOCAL_LAYER_STYLES).forEach(k => delete LOCAL_LAYER_STYLES[k]);
      ACTIVE_STYLE_LAYER = '';
      Object.keys(MAP_LAYER_VISIBILITY).forEach(k => delete MAP_LAYER_VISIBILITY[k]);
      const initVis = computeInitialLayerVisibility(Object.keys(LAYER_OVERLAYS));
      Object.assign(MAP_LAYER_VISIBILITY, initVis);
      _clearPreviewWmsRunOverlays();

      if (map) {
        IS_SYNCING_MAP_LAYERS += 1;
        try {
          Object.values(BASE_MAP_LAYERS).forEach(bl => {
            if (bl && bl !== DEFAULT_BASEMAP_LAYER && map.hasLayer(bl)) map.removeLayer(bl);
          });
          if (DEFAULT_BASEMAP_LAYER && !map.hasLayer(DEFAULT_BASEMAP_LAYER)) DEFAULT_BASEMAP_LAYER.addTo(map);
          if (HYBRID_LAYER_REF) {
            if (INITIAL_HYBRID_ENABLED && !map.hasLayer(HYBRID_LAYER_REF)) HYBRID_LAYER_REF.addTo(map);
            else if (!INITIAL_HYBRID_ENABLED && map.hasLayer(HYBRID_LAYER_REF)) map.removeLayer(HYBRID_LAYER_REF);
          }
          Object.entries(LAYER_OVERLAYS).forEach(([ln, grp]) => {
            if (!grp) return;
            if (MAP_LAYER_VISIBILITY[ln] !== false) {
              if (!map.hasLayer(grp)) grp.addTo(map);
            } else {
              if (map.hasLayer(grp)) map.removeLayer(grp);
            }
          });
        } finally {
          IS_SYNCING_MAP_LAYERS -= 1;
        }
        if (layerControl && typeof layerControl._update === 'function') layerControl._update();
      }
      syncLeafletLayerControlActions();
      resetMapHomeView();
      renderMapLayersDrawer();
      renderPagesBar();
      renderActiveFiltersBanner();
      buildSlicers();
      triggerRenderWithBusyFeedback({ skipAutoZoom: true });
    }

    function reorderMapLayerDrag(srcName, targetName) {
      if (!srcName || !targetName || srcName === targetName) return;
      const order = ensureCustomMapLayerOrder().slice();
      const fromIdx = order.indexOf(srcName);
      const toIdx = order.indexOf(targetName);
      if (fromIdx < 0 || toIdx < 0) return;
      order.splice(fromIdx, 1);
      order.splice(toIdx, 0, srcName);
      CUSTOM_MAP_LAYERS = order.slice();
      const mapWidget = (DASHBOARD.widgets || []).find(w => w.widget_type === 'map');
      if (mapWidget) {
        mapWidget.map_layers = CUSTOM_MAP_LAYERS.slice();
        mapWidget.map_layers_custom_order = true;
      }
      renderMapLayersDrawer();
      scheduleMapRender({ skipAutoZoom: true });
    }

    function setLocalLayerStyle(layerName, patch) {
      if (!layerName) return;
      LOCAL_LAYER_STYLES[layerName] = Object.assign({}, LOCAL_LAYER_STYLES[layerName] || {}, patch || {});
      const mapWidget = (DASHBOARD.widgets || []).find(w => w.widget_type === 'map');
      if (mapWidget) {
        mapWidget.map_layer_styles = mapWidget.map_layer_styles || {};
        mapWidget.map_layer_styles[layerName] = Object.assign({}, mapWidget.map_layer_styles[layerName] || {}, LOCAL_LAYER_STYLES[layerName]);
      }
      updateMapLegend();
      scheduleMapRender({ skipAutoZoom: true });
    }

    function renderMapLayersDrawer() {
      const drawer = document.getElementById('map-layers-drawer');
      if (!drawer) return;
      const order = orderedMapLayerNames();
      drawer.innerHTML = '';
      const hint = document.createElement('div');
      hint.className = 'map-layers-hint';
      hint.textContent = t('map_layers_order_short');
      drawer.appendChild(hint);

      order.forEach((ln, idx) => {
        const row = document.createElement('div');
        row.className = 'map-layer-row';
        row.dataset.layerName = ln;
        row.draggable = true;
        row.ondragstart = ev => {
          DRAG_LAYER_NAME = ln;
          row.classList.add('dragging');
          if (ev && ev.dataTransfer) {
            ev.dataTransfer.effectAllowed = 'move';
            ev.dataTransfer.setData('text/plain', ln);
          }
        };
        row.ondragover = ev => {
          if (ev && ev.preventDefault) ev.preventDefault();
          row.classList.add('drag-over');
        };
        row.ondragleave = () => row.classList.remove('drag-over');
        row.ondrop = ev => {
          if (ev && ev.preventDefault) ev.preventDefault();
          row.classList.remove('drag-over');
          const src = DRAG_LAYER_NAME || (ev && ev.dataTransfer && ev.dataTransfer.getData('text/plain')) || '';
          DRAG_LAYER_NAME = '';
          reorderMapLayerDrag(src, ln);
        };
        row.ondragend = () => {
          DRAG_LAYER_NAME = '';
          row.classList.remove('dragging');
          drawer.querySelectorAll('.drag-over').forEach(el => el.classList.remove('drag-over'));
        };

        const lbl = document.createElement('label');
        const dragGrip = document.createElement('span');
        dragGrip.textContent = '⋮⋮';
        dragGrip.style.opacity = '0.55';
        dragGrip.style.cursor = 'grab';
        const cb = document.createElement('input');
        cb.type = 'checkbox';
        cb.autocomplete = 'off';
        cb.checked = MAP_LAYER_VISIBILITY[ln] !== false;
        cb.onchange = () => toggleMapLayerVisible(ln, cb.checked);
        const span = document.createElement('span');
        const lyrCfg = getMapLayerStyleCfg(ln);
        const lyrMinZ = (lyrCfg && Number(lyrCfg.min_zoom) > 0) ? Number(lyrCfg.min_zoom) : 0;
        span.textContent = lyrMinZ > 0 ? `${ln} (Z≥${lyrMinZ})` : ln;
        lbl.appendChild(dragGrip);
        lbl.appendChild(cb);
        lbl.appendChild(span);

        const btns = document.createElement('div');
        btns.className = 'map-layer-order-btns';
        const styleBtn = document.createElement('button');
        styleBtn.textContent = '🎨';
        styleBtn.title = t('layer_style_btn');
        if (ACTIVE_STYLE_LAYER === ln) styleBtn.classList.add('active');
        styleBtn.onclick = () => {
          ACTIVE_STYLE_LAYER = (ACTIVE_STYLE_LAYER === ln) ? '' : ln;
          renderMapLayersDrawer();
        };
        btns.appendChild(styleBtn);

        const upBtn = document.createElement('button');
        upBtn.textContent = '↑';
        upBtn.disabled = idx === 0;
        upBtn.onclick = () => moveMapLayerOrder(ln, -1);
        const dnBtn = document.createElement('button');
        dnBtn.textContent = '↓';
        dnBtn.disabled = idx === order.length - 1;
        dnBtn.onclick = () => moveMapLayerOrder(ln, 1);
        btns.appendChild(upBtn);
        btns.appendChild(dnBtn);
        if (DYNAMIC_ADDED_LAYERS.has(ln)) {
          const rmBtn = document.createElement('button');
          rmBtn.className = 'remove-btn';
          rmBtn.textContent = '×';
          rmBtn.title = t('html_remove_layer');
          rmBtn.onclick = () => removeDynamicMapLayer(ln);
          btns.appendChild(rmBtn);
        }

        row.appendChild(lbl);
        row.appendChild(btns);
        drawer.appendChild(row);
      });

      if (ACTIVE_STYLE_LAYER && LAYER_RECORDS[ACTIVE_STYLE_LAYER]) {
        const ln = ACTIVE_STYLE_LAYER;
        const spec = getEffectiveLayerStyleSpec(ln);
        const custom = spec.custom || {};
        const svc = (BUNDLE.ogc_services || []).find(s => s.name === ln);
        const curFill = custom.color || defaultUniformColor(ln, custom, svc) || '#10b981';
        const curBorder = custom.border_color || curFill;
        const curOp = custom.opacity !== undefined ? Math.round(Number(custom.opacity) * 100) : 42;
        const curW = custom.stroke_width !== undefined ? Number(custom.stroke_width) : 1.5;
        const curField = (spec.styleFields && spec.styleFields[0]) || '';

        const panel = document.createElement('div');
        panel.id = 'map-layer-style-panel';
        panel.className = 'map-layer-style-panel';

        const hdrLbl = document.createElement('b');
        hdrLbl.textContent = `${ln}:`;
        panel.appendChild(hdrLbl);

        const fillLbl = document.createElement('label');
        fillLbl.textContent = t('style_fill') + ' ';
        const fillIn = document.createElement('input');
        fillIn.type = 'color';
        fillIn.value = /^#[0-9a-f]{6}$/i.test(curFill) ? curFill : '#10b981';
        fillIn.oninput = () => setLocalLayerStyle(ln, { color: fillIn.value });
        fillLbl.appendChild(fillIn);
        panel.appendChild(fillLbl);

        const opLbl = document.createElement('label');
        opLbl.textContent = t('style_opacity') + ' ';
        const opIn = document.createElement('input');
        opIn.type = 'range';
        opIn.min = '0'; opIn.max = '100'; opIn.value = String(curOp);
        opIn.style.width = '65px';
        opIn.oninput = () => setLocalLayerStyle(ln, { opacity: Number(opIn.value) / 100.0 });
        opLbl.appendChild(opIn);
        panel.appendChild(opLbl);

        const brdLbl = document.createElement('label');
        brdLbl.textContent = t('style_border') + ' ';
        const brdIn = document.createElement('input');
        brdIn.type = 'color';
        brdIn.value = /^#[0-9a-f]{6}$/i.test(curBorder) ? curBorder : '#10b981';
        brdIn.oninput = () => setLocalLayerStyle(ln, { border_color: brdIn.value });
        brdLbl.appendChild(brdIn);
        panel.appendChild(brdLbl);

        const wLbl = document.createElement('label');
        wLbl.textContent = t('style_width') + ' ';
        const wIn = document.createElement('input');
        wIn.type = 'number';
        wIn.min = '0'; wIn.max = '6'; wIn.step = '0.5'; wIn.value = String(curW);
        wIn.style.width = '46px';
        wIn.onchange = () => setLocalLayerStyle(ln, { stroke_width: Number(wIn.value) });
        wLbl.appendChild(wIn);
        panel.appendChild(wLbl);

        const mzLbl = document.createElement('label');
        mzLbl.textContent = t('style_min_zoom') + ' ';
        mzLbl.title = t('style_min_zoom_tip');
        const mzIn = document.createElement('input');
        mzIn.type = 'number';
        mzIn.min = '0'; mzIn.max = '14'; mzIn.step = '1';
        mzIn.value = String(Math.max(0, Math.min(14, Number(custom.min_zoom || 0))));
        mzIn.style.width = '44px';
        mzIn.title = t('style_min_zoom_tip');
        mzIn.onchange = () => setLocalLayerStyle(ln, { min_zoom: Math.max(0, Math.min(14, Number(mzIn.value) || 0)) });
        mzLbl.appendChild(mzIn);
        panel.appendChild(mzLbl);

        const outLbl = document.createElement('label');
        const outCb = document.createElement('input');
        outCb.type = 'checkbox';
        outCb.checked = Boolean(custom.outline_only);
        outCb.onchange = () => setLocalLayerStyle(ln, { outline_only: outCb.checked });
        outLbl.appendChild(outCb);
        outLbl.appendChild(document.createTextNode(' ' + t('style_outline_only')));
        panel.appendChild(outLbl);

        const sampleRow = (LAYER_RECORDS[ln] || [])[0] || {};
        const flds = Object.keys(sampleRow).filter(k => !k.startsWith('_'));
        const catLbl = document.createElement('label');
        catLbl.textContent = t('style_categorized') + ' ';
        const catSel = document.createElement('select');
        const noneOpt = document.createElement('option');
        noneOpt.value = ''; noneOpt.textContent = '— ' + t('style_single') + ' —';
        catSel.appendChild(noneOpt);
        flds.forEach(fn => {
          const o = document.createElement('option');
          o.value = fn; o.textContent = fn;
          catSel.appendChild(o);
        });
        catSel.value = curField;
        catSel.onchange = () => setLocalLayerStyle(ln, {
          style_mode: catSel.value ? 'categorized' : 'single',
          style_field: catSel.value
        });
        catLbl.appendChild(catSel);
        panel.appendChild(catLbl);

        drawer.appendChild(panel);
      }
    }

    function renderMapFeatures(opts) {
      const options = opts || {};
      let totalActive = 0;
      let renderedSimplifiedPoly = 0;
      let renderedFullPoly = 0;
      let missingViewportGeomsTotal = 0;
      let fetchingUpgrade = false;
      const filteredBoundsPoints = [];
      const allBoundsPoints = [];
      const layerNames = orderedMapLayerNames();
      renderMapLayersDrawer();

      let mapZoom = 7;
      let mapBbox = null;
      if (map && typeof map.getZoom === 'function') {
        const z = Number(map.getZoom());
        if (Number.isFinite(z)) mapZoom = z;
      }
      const scaleDenom = computeMapScaleDenominator();
      const targetLod = targetLodForScale(scaleDenom);
      updateMapScaleBadge(scaleDenom, targetLod);

      if (map && typeof map.getBounds === 'function') {
        try {
          const mb = map.getBounds();
          if (mb && mb.isValid && mb.isValid()) {
            const w = mb.getWest(), s = mb.getSouth(), e = mb.getEast(), n = mb.getNorth();
            const padX = Math.max(0.01, (e - w) * 0.15);
            const padY = Math.max(0.01, (n - s) * 0.15);
            mapBbox = [w - padX, s - padY, e + padX, n + padY];
          }
        } catch (_err) {}
      }

      const mSet = mapTargetIdSet();

      // Pre-compute dedicated Leaflet panes & per-layer Canvas renderers matching layerNames[0]=TOP..bottom
      const layerPaneByName = {};
      const layerRendererByName = {};
      layerNames.forEach((ln, idx) => {
        const pName = ensureLayerPane(ln, idx, layerNames.length);
        if (pName) layerPaneByName[ln] = pName;
        const rInst = getLayerCanvasRenderer(ln, pName);
        if (rInst) layerRendererByName[ln] = rInst;
      });

      // Draw from bottom layer to top layer (layerNames[0] renders visually on top)
      const drawOrder = layerNames.slice().reverse();
      drawOrder.forEach(ln => {
        const layerPane = layerPaneByName[ln] || undefined;
        const layerRenderer = layerRendererByName[ln] || vectorCanvasRenderer || undefined;
        let grp = LAYER_OVERLAYS[ln];
        if (!grp && map) {
          IS_SYNCING_MAP_LAYERS += 1;
          try {
            grp = L.layerGroup().addTo(map);
            LAYER_OVERLAYS[ln] = grp;
            if (layerControl && typeof layerControl.addOverlay === 'function') layerControl.addOverlay(grp, ln);
          } finally {
            IS_SYNCING_MAP_LAYERS -= 1;
          }
          syncLeafletLayerControlActions();
        }
        if (!grp) return;
        grp.clearLayers();

        if (MAP_LAYER_VISIBILITY[ln] === false) {
          IS_SYNCING_MAP_LAYERS += 1;
          try {
            if (map && map.hasLayer(grp)) map.removeLayer(grp);
            if (LAYER_WMS_OVERLAYS[ln] && map && map.hasLayer(LAYER_WMS_OVERLAYS[ln])) map.removeLayer(LAYER_WMS_OVERLAYS[ln]);
          } finally {
            IS_SYNCING_MAP_LAYERS -= 1;
          }
          return;
        }
        if (!isLayerVisibleAtZoom(ln, mapZoom, scaleDenom)) {
          IS_SYNCING_MAP_LAYERS += 1;
          try {
            if (typeof grp.clearLayers === 'function') grp.clearLayers();
            if (LAYER_WMS_OVERLAYS[ln] && map && map.hasLayer(LAYER_WMS_OVERLAYS[ln])) map.removeLayer(LAYER_WMS_OVERLAYS[ln]);
          } finally {
            IS_SYNCING_MAP_LAYERS -= 1;
          }
          return;
        }
        if (map && !map.hasLayer(grp)) {
          IS_SYNCING_MAP_LAYERS += 1;
          try { grp.addTo(map); } finally { IS_SYNCING_MAP_LAYERS -= 1; }
        }

        const filtered = filterRecords(ln, null, '__map__');
        totalActive += filtered.length;
        const activeEntries = Object.entries(ACTIVE_FILTERS);
        const activeFilterList = activeEntries.map(([, f]) => f);
        const hasAnyFilter = activeFilterList.length > 0;
        const layerMatchesFilter = hasAnyFilter && activeEntries.some(([srcId, f]) => shouldFilterApply(srcId, f, '__map__', ln));
        const geoms = LAYER_GEOMETRIES[ln] || {};
        const geomLods = LAYER_GEOM_LOD[ln] || {};
        const layerRows = LAYER_RECORDS[ln] || [];
        const statMeta = LAYER_STATS[ln] || {};
        const vp = VECTOR_PYRAMIDS[ln] || null;
        const geomTypeHint = String(LAYER_GEOM_TYPES[ln] || statMeta.geom_type || '');
        const isPolyOrLineLayer = (geomTypeHint && !/Point/i.test(geomTypeHint))
          || Object.values(geoms).some(g => g && g.type && !/Point/i.test(g.type))
          || Boolean(vp && vp.lod1)
          || layerRows.some(rec => rec && rec._geom_area_ha !== undefined && rec._geom_area_ha !== null);

        const isLargeLayer = layerRows.length > 2500
          || Number(statMeta.feature_count || 0) > 2500;
        const vpLod0Features = (vp && vp.lod0 && Array.isArray(vp.lod0.features)) ? vp.lod0.features : [];
        const canRasterTileLayer = _canLayerUsePreviewTile(ln, targetLod, scaleDenom, hasAnyFilter);
        if (canRasterTileLayer) {
          renderedFullPoly++;
          return;
        }

        // Toggle companion GeoServer WMS tile layer in Standalone HTML for lag-free wide-scale overview
        const wmsLyr = LAYER_WMS_OVERLAYS[ln];
        if (wmsLyr && map) {
          if (isLargeLayer && scaleDenom > 55000 && !hasAnyFilter) {
            if (layerPane && wmsLyr.options && wmsLyr.options.pane !== layerPane) {
              IS_SYNCING_MAP_LAYERS += 1;
              try {
                if (map.hasLayer(wmsLyr)) map.removeLayer(wmsLyr);
                wmsLyr.options.pane = layerPane;
              } finally {
                IS_SYNCING_MAP_LAYERS -= 1;
              }
            }
            if (!map.hasLayer(wmsLyr)) wmsLyr.addTo(map);
          } else if (map.hasLayer(wmsLyr)) {
            map.removeLayer(wmsLyr);
          }
        }

        // Stage 0 (> 1:750,000): detailed simplified polygon overview on Canvas (falls back to points only for point layers)
        const vpLod0IsPointOnly = vpLod0Features.length > 0
          && vpLod0Features.slice(0, 20).every(f => f && f.geometry && /Point/i.test(String(f.geometry.type || '')));
        if (!hasAnyFilter && !EXTENT_FILTER_ENABLED && targetLod === 0 && isLargeLayer && vpLod0Features.length > 0 && !(isPolyOrLineLayer && vpLod0IsPointOnly)) {
          const lod0Opts = {
            pointToLayer: (feat, latlng) => {
              const props = feat.properties || {};
              const base = styleFeatureForLayer(ln, props, layerRenderer, layerPane);
              const cnt = Number(props.count || 1);
              const mOpts = {
                radius: Math.min(6, Math.max(2, 1.5 + Math.log10(cnt + 1) * 1.8)),
                color: base.color,
                fillColor: base.fillColor,
                weight: 0.8,
                opacity: 0.75,
                fillOpacity: 0.55,
              };
              if (layerPane) mOpts.pane = layerPane;
              if (layerRenderer) mOpts.renderer = layerRenderer;
              return L.circleMarker(latlng, mOpts);
            },
            style: feat => {
              const props = feat.properties || {};
              const base = styleFeatureForLayer(ln, props, layerRenderer, layerPane);
              return Object.assign({}, base, {
                weight: 1.0,
                opacity: 0.88,
                fillOpacity: Math.max(0.32, Number(base.fillOpacity || 0.42))
              });
            },
            onEachFeature: (feat, lyr) => {
              const p = feat.properties || {};
              const areaVal = p.area_ha !== undefined ? p.area_ha : (p._geom_area_ha || 0);
              let pop = `<b>${escapeHtml(ln)}</b> (LOD-0)<br/><b>Pindala:</b> ${escapeHtml(areaVal)} ha`;
              if (p.count) pop += `<br/><b>Objekte:</b> ${escapeHtml(p.count)}`;
              if (p.pohityyp) pop += `<br/><b>Põhitüüp:</b> ${escapeHtml(p.pohityyp)}`;
              if (p.uldine_lk) pop += `<br/><b>Seisund:</b> ${escapeHtml(p.uldine_lk)}`;
              if (p.parandniidu_tyyp) pop += `<br/><b>Pärandniit:</b> ${escapeHtml(p.parandniidu_tyyp)}`;
              lyr.bindPopup(pop);
            }
          };
          if (layerPane) lod0Opts.pane = layerPane;
          if (layerRenderer) lod0Opts.renderer = layerRenderer;
          const gjLod0 = L.geoJSON(vp.lod0, lod0Opts);
          grp.addLayer(gjLod0);
          if (gjLod0.bringToFront) gjLod0.bringToFront();
          return;
        }

        const geoFeatures = [];
        const missingFids = [];
        const upgradeFids = [];
        let missingViewportGeoms = 0;
        const maxDrawFeatures = targetLod >= 3 ? 6000 : 3500;
        const useViewportCull = Boolean(filtered.length > maxDrawFeatures && mapBbox);

        for (let i = 0; i < filtered.length; i++) {
          const r = filtered[i];
          const fidStr = String(r._feature_id);
          const geom = getFeatureGeometry(ln, fidStr);
          const bb = geom
            ? getFeatureBbox(ln, fidStr)
            : ((LAYER_PYRAMID_LOD1[ln] && LAYER_PYRAMID_LOD1[ln][fidStr]) ? LAYER_PYRAMID_LOD1[ln][fidStr][1] : null);

          if (hasAnyFilter && (layerMatchesFilter || !activeFilterList.some(f => f.layer_name))) {
            if (bb && bb.length === 4) {
              (layerMatchesFilter ? filteredBoundsPoints : allBoundsPoints).push([bb[1], bb[0]], [bb[3], bb[2]]);
            } else if (r._lat !== undefined && r._lon !== undefined) {
              const lat = Number(r._lat), lon = Number(r._lon);
              if (!isNaN(lat) && !isNaN(lon)) {
                (layerMatchesFilter ? filteredBoundsPoints : allBoundsPoints).push([lat, lon]);
              }
            }
          }

          let inViewport = true;
          if (mapBbox) {
            if (bb) {
              inViewport = bboxIntersects(bb, mapBbox);
            } else if (r._lat !== undefined && r._lon !== undefined) {
              const lat = Number(r._lat), lon = Number(r._lon);
              if (!isNaN(lat) && !isNaN(lon)) {
                inViewport = !(lon < mapBbox[0] || lon > mapBbox[2] || lat < mapBbox[1] || lat > mapBbox[3]);
              }
            }
          }
          if (useViewportCull && !inViewport) continue;

          if (geom) {
            const freshLods = LAYER_GEOM_LOD[ln] || geomLods;
            const curLod = Number(freshLods[fidStr] || (LAYER_PYRAMID_LOD1[ln] && LAYER_PYRAMID_LOD1[ln][fidStr] ? 1 : 2));
            if (inViewport) {
              if (curLod >= 3) renderedFullPoly++;
              else if (isPolyOrLineLayer) renderedSimplifiedPoly++;
              if (targetLod >= 3 && curLod < 3 && upgradeFids.length < 1500) {
                upgradeFids.push(fidStr);
              }
            }
            if (geoFeatures.length < maxDrawFeatures) {
              geoFeatures.push({ type: 'Feature', geometry: geom, properties: r });
            }
          } else if (isPolyOrLineLayer) {
            if (inViewport && missingFids.length < 1200) missingFids.push(fidStr);
            if (inViewport) missingViewportGeoms++;
          } else if (r._lat !== undefined && r._lon !== undefined) {
            const lat = Number(r._lat), lon = Number(r._lon);
            if (!isNaN(lat) && !isNaN(lon)) {
              const st = styleFeatureForLayer(ln, r, layerRenderer, layerPane);
              const mOpts = {
                radius: 6, fillColor: st.fillColor, color: '#0f172a', weight: 1.2, fillOpacity: 0.88,
              };
              if (layerPane) mOpts.pane = layerPane;
              if (layerRenderer) mOpts.renderer = layerRenderer;
              const marker = L.circleMarker([lat, lon], mOpts);
              marker.bindPopup(buildPopupHtml(ln, r));
              grp.addLayer(marker);
              if (marker.bringToFront) marker.bringToFront();
            }
          }
        }

        if (geoFeatures.length) {
          const gjOpts = {
            style: feat => styleFeatureForLayer(ln, feat.properties || {}, layerRenderer, layerPane),
            onEachFeature: (feat, lyr) => {
              lyr.bindPopup(buildPopupHtml(ln, feat.properties || {}));
            }
          };
          if (layerPane) gjOpts.pane = layerPane;
          if (layerRenderer) gjOpts.renderer = layerRenderer;
          const gjLayer = L.geoJSON({ type: 'FeatureCollection', features: geoFeatures }, gjOpts);
          grp.addLayer(gjLayer);
          if (gjLayer.bringToFront) gjLayer.bringToFront();
        } else if (missingViewportGeoms > 0 && isPolyOrLineLayer && !HAS_PREVIEW_API && !(LAYER_WMS_OVERLAYS[ln] && map && map.hasLayer(LAYER_WMS_OVERLAYS[ln]))) {
          // Offline non-WMS subtle centroid dots while LOD-1 unpacks / WFS loads
          for (let j = 0; j < filtered.length && j < 1800; j++) {
            const r = filtered[j];
            const lat = Number(r._lat), lon = Number(r._lon);
            if (!Number.isFinite(lat) || !Number.isFinite(lon)) continue;
            if (mapBbox && (lon < mapBbox[0] || lon > mapBbox[2] || lat < mapBbox[1] || lat > mapBbox[3])) continue;
            const st = styleFeatureForLayer(ln, r, layerRenderer, layerPane);
            const dotOpts = {
              radius: 2.5, fillColor: st.fillColor, color: st.color, weight: 0.5, fillOpacity: 0.65,
            };
            if (layerPane) dotOpts.pane = layerPane;
            if (layerRenderer) dotOpts.renderer = layerRenderer;
            const dot = L.circleMarker([lat, lon], dotOpts);
            grp.addLayer(dot);
          }
        }

        missingViewportGeomsTotal += missingViewportGeoms;
        const needHydration = (missingFids.length > 0 || missingViewportGeoms > 0);
        if (needHydration && vp && vp.lod1 && vp.lod1.data_b64 && !LAYER_PYRAMID_LOD1[ln]) {
          const initFids = (missingFids.length > 0 && (layerMatchesFilter || filtered.length <= 1200))
            ? missingFids
            : undefined;
          requestMissingFeatures(ln, {
            fids: initFids,
            bbox: mapBbox || undefined,
            zoom: mapZoom,
            lod: targetLod,
            scale: scaleDenom,
            skipAutoZoom: Boolean(options.skipAutoZoom),
            forceZoom: Boolean(options.forceZoom)
          });
        } else if ((needHydration || upgradeFids.length > 0) && (HAS_PREVIEW_API || Boolean(findLiveWfsService(ln)))) {
          const reqFids = missingFids.length > 0 ? missingFids : upgradeFids;
          if (upgradeFids.length > 0 && targetLod >= 3) fetchingUpgrade = true;
          if (reqFids.length > 0 && (layerMatchesFilter || filtered.length <= 1200 || upgradeFids.length > 0)) {
            requestMissingFeatures(ln, {
              fids: reqFids,
              bbox: mapBbox || undefined,
              zoom: mapZoom,
              lod: targetLod,
              scale: scaleDenom,
              skipAutoZoom: Boolean(options.skipAutoZoom),
              forceZoom: Boolean(options.forceZoom)
            });
          } else if (mapBbox) {
            requestMissingFeatures(ln, {
              bbox: mapBbox,
              zoom: mapZoom,
              lod: targetLod,
              scale: scaleDenom,
              skipAutoZoom: Boolean(options.skipAutoZoom),
              forceZoom: Boolean(options.forceZoom)
            });
          }
        }
      });

      if (targetLod >= 3) {
        updateMapScaleBadge(scaleDenom, targetLod, {
          hasExactDetail: (renderedSimplifiedPoly === 0 && missingViewportGeomsTotal === 0),
          actualLod: (renderedSimplifiedPoly > 0) ? 1 : ((missingViewportGeomsTotal > 0) ? 0 : 3),
          fetchingUpgrade
        });
      } else {
        updateMapScaleBadge(scaleDenom, targetLod);
      }
      updatePreviewWmsOverlay(layerNames, scaleDenom);
      updateMapLegend();
      if (typeof _currentViewportSnapshot === 'function') {
        LAST_RENDER_VIEWPORT = _currentViewportSnapshot();
      }

      // Collect zoom target bounds from zoom_only or connected filters whose target is Map,
      // prioritizing the most recently interacted filter source and intersecting all active filters.
      const connZoomPts = [];
      const specificConnZoomPts = [];
      const activeEntriesZoom = Object.entries(ACTIVE_FILTERS);
      const lastNormSrc = LAST_INTERACTED_FILTER_SOURCE ? normalizeWidgetSourceId(LAST_INTERACTED_FILTER_SOURCE) : '';
      activeEntriesZoom.forEach(([srcId, flt]) => {
        const outgoing = getConnectionsFrom(srcId);
        if (!outgoing.some(c => mSet.has(c.target_id) && (c.action === 'filter_and_zoom' || c.action === 'zoom_only'))) return;
        const isLastInteracted = Boolean(LAST_INTERACTED_FILTER_SOURCE) && (
          srcId === LAST_INTERACTED_FILTER_SOURCE || normalizeWidgetSourceId(srcId) === lastNormSrc
        );
        const destArr = isLastInteracted ? specificConnZoomPts : connZoomPts;
        const baseRecs = (flt.layer_name && flt.layer_name !== '__spatial__' ? filterRecords(flt.layer_name, null, '__map__') : []) || [];
        const srcRecs = baseRecs.length ? baseRecs : ((flt.layer_name && flt.layer_name !== '__spatial__' ? LAYER_RECORDS[flt.layer_name] : []) || []);
        srcRecs.forEach(r => {
          if (!r || !_filterRowMatchesAttr(r, flt, flt.layer_name)) return;
          const bb = getFeatureBbox(flt.layer_name, String(r._feature_id));
          if (bb && bb.length === 4) {
            destArr.push([bb[1], bb[0]], [bb[3], bb[2]]);
          } else if (r._lat !== undefined && r._lon !== undefined) {
            const lat = Number(r._lat), lon = Number(r._lon);
            if (!isNaN(lat) && !isNaN(lon)) destArr.push([lat, lon]);
          }
        });
      });

      const badge = document.getElementById('feature-count-badge');
      if (badge) badge.textContent = t('html_active_features', { count: totalActive, layers: layerNames.length });

      const hasActiveFilters = Object.keys(ACTIVE_FILTERS).length > 0;
      const effectiveConnPts = specificConnZoomPts.length ? specificConnZoomPts : connZoomPts;
      const zoomTargetPts = effectiveConnPts.length ? effectiveConnPts : (filteredBoundsPoints.length ? filteredBoundsPoints : allBoundsPoints);
      const explicitWantsZoom = effectiveConnPts.length > 0;
      const autoZoomOn = DASHBOARD.auto_zoom_on_filter !== false || explicitWantsZoom;
      if ((autoZoomOn || Boolean(options.forceZoom)) && hasActiveFilters && zoomTargetPts.length > 0 && !EXTENT_FILTER_ENABLED && !options.skipAutoZoom && map) {
        safeFitBounds(zoomTargetPts, { padding: [32, 32], maxZoom: 14, refreshAfterZoom: true });
      }
    }

    function _renderFallbackSvgChart(plotEl, w, pairs, textColor, multiData) {
      if (!plotEl) return;
      if (multiData && Array.isArray(multiData.categories) && Array.isArray(multiData.series) && multiData.categories.length && multiData.series.length) {
        const cats = multiData.categories.slice(0, 12);
        const seriesList = multiData.series;
        const colors = multiData.colors || ['#38bdf8', '#34d399', '#fbbf24', '#f87171', '#a78bfa'];
        const stackMode = String(multiData.stackMode || 'group');
        const legendHtml = `<div style="display:flex;flex-wrap:wrap;gap:8px;margin-bottom:6px;font-size:10px;color:${textColor};">` +
          seriesList.map((sn, i) => `<span style="display:inline-flex;align-items:center;gap:4px;"><span style="width:8px;height:8px;border-radius:2px;background:${colors[i % colors.length]};display:inline-block;"></span>${escapeHtml(sn)}</span>`).join('') +
          `</div>`;
        let maxTotal = 1e-9;
        cats.forEach((_, ci) => {
          if (stackMode === 'percent') {
            maxTotal = 100;
          } else if (stackMode === 'stack') {
            const s = seriesList.reduce((acc, sn, si) => acc + Math.max(0, Number((multiData.matrix[si] || [])[ci] || 0)), 0);
            if (s > maxTotal) maxTotal = s;
          } else {
            seriesList.forEach((_, si) => {
              const v = Math.abs(Number((multiData.matrix[si] || [])[ci] || 0));
              if (v > maxTotal) maxTotal = v;
            });
          }
        });
        const rowHtml = cats.map((cat, ci) => {
          if (stackMode === 'stack' || stackMode === 'percent') {
            const segs = seriesList.map((sn, si) => {
              const val = Math.max(0, Number((multiData.matrix[si] || [])[ci] || 0));
              const wPct = Math.max(0, Math.min(100, (val / maxTotal) * 100));
              return `<div title="${escapeHtml(sn + ': ' + val.toFixed(1))}" style="width:${wPct.toFixed(1)}%;height:100%;background:${colors[si % colors.length]};"></div>`;
            }).join('');
            const rowSum = seriesList.reduce((acc, _, si) => acc + Number((multiData.matrix[si] || [])[ci] || 0), 0);
            return `<div style="display:flex;align-items:center;gap:8px;margin:3px 0;font-size:11px;color:${textColor};"><span style="width:92px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="${escapeHtml(cat)}">${escapeHtml(cat)}</span><div style="flex:1;height:12px;display:flex;background:rgba(148,163,184,0.18);border-radius:4px;overflow:hidden;">${segs}</div><span style="min-width:44px;text-align:right;">${escapeHtml(stackMode === 'percent' ? '100%' : rowSum.toLocaleString(undefined, { maximumFractionDigits: 1 }))}</span></div>`;
          }
          const subBars = seriesList.map((sn, si) => {
            const val = Number((multiData.matrix[si] || [])[ci] || 0);
            const pct = Math.max(1, Math.min(100, Math.round((Math.abs(val) / maxTotal) * 100)));
            return `<div style="height:5px;width:${pct}%;background:${colors[si % colors.length]};border-radius:2px;margin:1px 0;"></div>`;
          }).join('');
          return `<div style="display:flex;align-items:center;gap:8px;margin:4px 0;font-size:11px;color:${textColor};"><span style="width:92px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="${escapeHtml(cat)}">${escapeHtml(cat)}</span><div style="flex:1;">${subBars}</div></div>`;
        }).join('');
        plotEl.innerHTML = `<div style="padding:8px 12px;overflow:auto;height:100%;">${legendHtml}${rowHtml}</div>`;
        return;
      }
      const cleanPairs = Array.isArray(pairs) ? pairs.filter(p => p && p[0] !== undefined) : [];
      if (!cleanPairs.length) {
        plotEl.innerHTML = `<div style="display:flex;align-items:center;justify-content:center;height:100%;padding:16px;text-align:center;color:var(--text-secondary);font-size:0.86rem;">${escapeHtml(t('no_matching'))}</div>`;
        return;
      }
      const items = cleanPairs.slice(0, 12);
      const maxVal = Math.max(1e-9, ...items.map(p => Math.abs(Number(p[1] || 0))));
      const accent = w.primary_color || '#38bdf8';
      const rows = items.map(([lbl, val]) => {
        const pct = Math.max(2, Math.min(100, Math.round((Math.abs(Number(val || 0)) / maxVal) * 100)));
        const numTxt = Number(val || 0).toLocaleString(undefined, { maximumFractionDigits: 1 });
        return `<div style="display:flex;align-items:center;gap:8px;margin:3px 0;font-size:11px;color:${textColor};"><span style="width:92px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="${escapeHtml(lbl)}">${escapeHtml(lbl)}</span><div style="flex:1;height:12px;background:rgba(148,163,184,0.18);border-radius:4px;overflow:hidden;"><div style="width:${pct}%;height:100%;background:${accent};"></div></div><span style="min-width:44px;text-align:right;font-variant-numeric:tabular-nums;">${escapeHtml(numTxt)}</span></div>`;
      }).join('');
      plotEl.innerHTML = `<div style="padding:8px 12px;overflow:auto;height:100%;">${rows}</div>`;
    }

    function _applyWidgetBorderStyle(el, w) {
      if (!el) return;
      const eff = String((w && w.border_style) || DASHBOARD.widget_border_style || 'solid').toLowerCase();
      if (eff === 'none') {
        el.style.border = 'none';
        el.style.boxShadow = 'none';
      } else if (eff === 'dashed') {
        el.style.borderStyle = 'dashed';
      } else if (eff === 'shadow') {
        el.style.boxShadow = '0 8px 24px rgba(15, 23, 42, 0.22)';
      } else if (eff === 'subtle') {
        el.style.borderColor = 'rgba(148, 163, 184, 0.22)';
      }
    }

    function renderWidgetsOnly() {
      const kpiGrid = document.getElementById('kpi-grid');
      const chartsGrid = document.getElementById('charts-grid');
      document.querySelectorAll('#workspace-main > [data-widget-id]:not(#map-card)').forEach(el => el.remove());
      if (kpiGrid) kpiGrid.innerHTML = '';
      if (chartsGrid) chartsGrid.innerHTML = '';
      if (typeof renderActiveFiltersBanner === 'function') renderActiveFiltersBanner();

      const activePg = String(ACTIVE_PAGE_ID || 'page_1');
      const mapCardEl = document.getElementById('map-card');
      const mapWidgets = (DASHBOARD.widgets || []).filter(w => w.widget_type === 'map');
      const mapOnActivePage = mapWidgets.find(w => !w.page_id || String(w.page_id) === activePg);
      const hasAnyPagedMap = mapWidgets.some(w => Boolean(w.page_id));
      if (mapCardEl) {
        if (!mapOnActivePage && hasAnyPagedMap && (DASHBOARD.pages || []).length > 1) {
          mapCardEl.dataset.hiddenPage = '1';
        } else {
          delete mapCardEl.dataset.hiddenPage;
          const mapBadgeTxt = mapOnActivePage ? _getIncomingFilterBadgeText(mapOnActivePage.id, mapOnActivePage.layer_name) : '';
          const mapStripEl = document.getElementById('map-filter-strip');
          const mapBadgeEl = document.getElementById('map-filter-badge');
          if (mapStripEl) {
            mapStripEl.style.display = mapBadgeTxt ? 'flex' : 'none';
          }
          if (mapBadgeEl) {
            mapBadgeEl.textContent = mapBadgeTxt;
            mapBadgeEl.title = mapBadgeTxt;
          }
        }
      }

      const isLight = document.documentElement.dataset.theme === 'light';
      const textColor = isLight ? '#0f172a' : '#f8fafc';
      const gridColor = isLight ? '#e2e8f0' : '#334155';

      (DASHBOARD.widgets || []).forEach(w => {
        if (w.widget_type === 'map') return;
        if (w.page_id && String(w.page_id) !== activePg) return;
        const wTitle = localizedTitle(w);
        const wTitleEsc = escapeHtml(wTitle);
        const badgeTxt = _getIncomingFilterBadgeText(w.id, w.layer_name);
        const badgeHtml = badgeTxt ? `<span class="widget-filter-badge" title="${escapeHtml(badgeTxt)}">${escapeHtml(badgeTxt)}</span>` : '';
        const hasOwnFlt = Object.keys(ACTIVE_FILTERS).some(k => normalizeWidgetSourceId(k) === normalizeWidgetSourceId(w.id));
        const clrBtnHtml = hasOwnFlt
          ? `<button type="button" class="btn-clear-widget" onclick="clearWidgetFilter('${escapeHtml(w.id)}')" title="${escapeHtml(t('btn_clear_filter'))}">✕</button>`
          : '';
        if (w.widget_type === 'image') {
          const card = document.createElement('div');
          card.className = 'widget-card image-widget-card' + (w.image_transparent_bg ? ' image-widget-transparent' : '');
          card.dataset.widgetId = w.id;
          _applyWidgetBorderStyle(card, w);
          const imgSrc = w.image_data_uri || w.image_source || '';
          const fit = w.image_fit || 'contain';
          const imgTag = imgSrc
            ? `<img src="${escapeHtml(imgSrc)}" alt="${wTitleEsc}" style="object-fit:${escapeHtml(fit)};" />`
            : `<div style="opacity:0.6;font-size:0.8rem;">${wTitleEsc}</div>`;
          const wrapped = (w.image_link_url && imgSrc)
            ? `<a href="${escapeHtml(w.image_link_url)}" target="_blank" rel="noopener" style="display:flex;width:100%;height:100%;align-items:center;justify-content:center;">${imgTag}</a>`
            : imgTag;
          const capHtml = w.image_caption ? `<div class="image-caption">${escapeHtml(w.image_caption)}</div>` : '';
          card.innerHTML = w.image_transparent_bg
            ? `<div class="image-body">${wrapped}${capHtml}</div>`
            : `<div class="card-header"><span>${wTitleEsc}</span></div><div class="image-body">${wrapped}${capHtml}</div>`;
          if (chartsGrid) chartsGrid.appendChild(card);
          return;
        }
        const baseRows = filterRecords(w.layer_name, w.ignore_self_filter ? w.id : null, w.id);
        const rows = w.spatial_join_layer ? resolveSpatialPivotRows(w, baseRows) : baseRows;
        if (w.widget_type === 'kpi') {
          const vals = w.aggregation === 'count' && !w.value_field ? rows.map(() => 1) : rows.map(r => resolveFieldVal(r, w.value_field));
          const val = computeMetric(vals, w.aggregation);
          const dec = (w.decimals === undefined || w.decimals === null) ? 1 : Number(w.decimals);
          const formatted = (w.prefix || '') + (w.aggregation === 'count' || dec === 0 ? Math.round(val).toLocaleString() : val.toLocaleString(undefined, { minimumFractionDigits: dec, maximumFractionDigits: dec })) + (w.suffix || '');
          let deltaHtml = `<span>${rows.length} ${escapeHtml(t('records'))}</span>`;
          if (w.target_value) {
            const pct = (((val - w.target_value) / Math.abs(w.target_value)) * 100).toFixed(1);
            const sign = pct >= 0 ? '+' : '';
            deltaHtml += `<span style="color:${pct >= 0 ? 'var(--accent-emerald)' : 'var(--accent-rose)'}">${sign}${escapeHtml(pct)}% ${escapeHtml(t('vs_target'))}</span>`;
          }
          const card = document.createElement('div');
          card.className = 'kpi-card';
          card.dataset.widgetId = w.id;
          _applyWidgetBorderStyle(card, w);
          card.style.borderLeftColor = w.primary_color || '#38bdf8';
          card.innerHTML = `
            <div style="display:flex;align-items:center;justify-content:space-between;gap:6px;"><div class="kpi-title">${wTitleEsc}</div>${clrBtnHtml}</div>
            ${badgeHtml}
            <div class="kpi-value">${escapeHtml(formatted)}</div>
            <div class="kpi-meta">${deltaHtml}</div>
          `;
          if (kpiGrid) kpiGrid.appendChild(card);
        } else if (w.widget_type === 'table') {
          const card = document.createElement('div');
          card.className = 'widget-card table-card';
          card.dataset.widgetId = w.id;
          _applyWidgetBorderStyle(card, w);
          const tbl = computeTableData(w, baseRows);
          const selTblVals = ((ACTIVE_FILTERS['tbl_' + w.id] && ACTIVE_FILTERS['tbl_' + w.id].values) || []).map(String);
          const dec = (w.decimals === undefined || w.decimals === null) ? 1 : Number(w.decimals);
          const ths = tbl.headers.map(c => `<th>${escapeHtml(c)}</th>`).join('');
          const trs = tbl.rows.map((rVals, idx) => {
            const meta = tbl.rowMeta[idx] || {};
            const isSelRow = Boolean(!meta.isTotal && meta.filterField && selTblVals.includes(String(meta.filterVal || '')));
            const rowCls = [];
            if (meta.isTotal) rowCls.push('pivot-total-row');
            if (isSelRow) rowCls.push('selected-row');
            const cls = rowCls.length ? ` class="${rowCls.join(' ')}"` : '';
            const tds = rVals.map(v => {
              if (typeof v === 'number' && !Number.isInteger(v)) {
                return `<td>${escapeHtml(v.toLocaleString(undefined, { minimumFractionDigits: dec, maximumFractionDigits: dec }))}</td>`;
              }
              return `<td>${escapeHtml(v ?? '')}</td>`;
            }).join('');
            const bboxStr = Array.isArray(meta.bbox) && meta.bbox.length === 4 ? meta.bbox.join(',') : '';
            return `<tr${cls} data-layer="${escapeHtml(w.layer_name || '')}" data-fid="${escapeHtml(meta.fid ?? '')}" data-lat="${escapeHtml(meta.lat ?? '')}" data-lon="${escapeHtml(meta.lon ?? '')}" data-bbox="${escapeHtml(bboxStr)}" data-filter-field="${escapeHtml(meta.filterField || '')}" data-filter-val="${escapeHtml(meta.filterVal || '')}">${tds}</tr>`;
          }).join('');
          const tblStripHtml = badgeTxt ? `<div class="card-filter-strip">${badgeHtml}</div>` : '';
          card.innerHTML = `
            <div class="card-header"><span>${wTitleEsc}</span><span style="display:flex;gap:6px;align-items:center;flex-wrap:wrap;justify-content:flex-end;">${clrBtnHtml}<button class="btn-mini-icon${tbl.transposed ? ' active' : ''}" onclick="toggleTableTranspose('${escapeHtml(w.id)}')" title="Transpose">⇄</button><span>${tbl.rows.length} ${escapeHtml(t('html_rows'))}</span></span></div>
            ${tblStripHtml}
            <div class="table-wrapper"><table><thead><tr>${ths}</tr></thead><tbody>${trs}</tbody></table></div>
          `;
          card.querySelectorAll('tbody tr').forEach(tr => {
            tr.onclick = () => {
              const ff = tr.dataset.filterField, fv = tr.dataset.filterVal;
              if (ff) {
                toggleCategoryFilter('tbl_' + w.id, w.layer_name, ff, fv, true);
                return;
              }
              if (w.drill_to_page_id) switchDashboardPage(w.drill_to_page_id);
              const ln = tr.dataset.layer, fid = tr.dataset.fid;
              const rawBbox = tr.dataset.bbox ? tr.dataset.bbox.split(',').map(Number).filter(Number.isFinite) : null;
              const fitFeatureBounds = () => {
                const gNow = getFeatureGeometry(ln, String(fid));
                if (gNow && map) {
                  const b = L.geoJSON(gNow).getBounds();
                  if (b.isValid()) { safeFitBounds(b, { padding: [40, 40], maxZoom: 15 }); return true; }
                }
                const bbNow = (rawBbox && rawBbox.length === 4) ? rawBbox : getFeatureBbox(ln, String(fid));
                if (bbNow && bbNow.length === 4 && map) {
                  safeFitBounds([[bbNow[1], bbNow[0]], [bbNow[3], bbNow[2]]], { padding: [40, 40], maxZoom: 15 });
                  return true;
                }
                return false;
              };
              const hasExactGeom = Boolean(getFeatureGeometry(ln, String(fid)));
              if (!fitFeatureBounds()) {
                const lat = parseFloat(tr.dataset.lat), lon = parseFloat(tr.dataset.lon);
                if (!isNaN(lat) && !isNaN(lon) && map) safeSetView([lat, lon], 14);
              }
              if (!hasExactGeom && ln && fid !== undefined && fid !== '') {
                requestMissingFeatures(ln, { fids: [String(fid)], zoom: 14, skipAutoZoom: true }).then(() => {
                  const g2 = getFeatureGeometry(ln, String(fid));
                  if (g2 && map) {
                    const b2 = L.geoJSON(g2).getBounds();
                    if (b2.isValid()) safeFitBounds(b2, { padding: [40, 40], maxZoom: 15 });
                  }
                });
              }
            };
          });
          if (chartsGrid) chartsGrid.appendChild(card);
        } else {
          const card = document.createElement('div');
          card.className = 'widget-card';
          card.dataset.widgetId = w.id;
          _applyWidgetBorderStyle(card, w);
          const plotId = 'plot_' + w.id;
          const chartStripHtml = badgeTxt ? `<div class="card-filter-strip">${badgeHtml}</div>` : '';
          card.innerHTML = `<div class="card-header"><span>${wTitleEsc}</span><span style="display:flex;align-items:center;gap:6px;flex-wrap:wrap;justify-content:flex-end;">${clrBtnHtml}<span class="chart-hint" title="${escapeHtml(t('html_click_filter'))}">ⓘ ${escapeHtml(t('html_click_filter'))}</span></span></div>${chartStripHtml}<div id="${plotId}" class="plot-container"></div>`;
          if (chartsGrid) chartsGrid.appendChild(card);

          const plotTargetEl = document.getElementById(plotId) || card.querySelector('.plot-container');
          if (w.widget_type === 'scatter') {
            const xs = [], ys = [], texts = [];
            rows.forEach(r => {
              const xv = Number(resolveFieldVal(r, w.category_field)), yv = Number(resolveFieldVal(r, w.value_field));
              if (!isNaN(xv) && !isNaN(yv)) {
                xs.push(xv); ys.push(yv); texts.push(String(resolveFieldVal(r, w.secondary_field || w.category_field) || ''));
              }
            });
            if (!xs.length) {
              if (plotTargetEl) {
                plotTargetEl.innerHTML = `<div style="display:flex;align-items:center;justify-content:center;height:100%;padding:16px;text-align:center;color:var(--text-secondary);font-size:0.86rem;">${escapeHtml(t('no_matching'))}</div>`;
              }
              return;
            }
            if (typeof Plotly === 'undefined' || !Plotly || typeof Plotly.newPlot !== 'function') {
              _renderFallbackSvgChart(plotTargetEl, w, xs.map((x, idx) => [String(x), ys[idx]]), textColor);
              return;
            }
            try {
              Plotly.newPlot(plotId, [{
                x: xs, y: ys, text: texts, mode: 'markers', type: 'scatter',
                marker: { color: w.primary_color || '#38bdf8', size: 10, opacity: 0.85 }
              }], {
                paper_bgcolor: 'transparent', plot_bgcolor: 'transparent',
                font: { color: textColor, size: 11 },
                margin: { t: 16, r: 16, b: 40, l: 48 },
                xaxis: { title: friendlyFieldLabel(w.category_field), gridcolor: gridColor },
                yaxis: { title: friendlyFieldLabel(w.value_field), gridcolor: gridColor }
              }, { responsive: true, displayModeBar: false });
            } catch (_plotlyErr) {
              _renderFallbackSvgChart(plotTargetEl, w, xs.map((x, idx) => [String(x), ys[idx]]), textColor);
            }
          } else {
            const secField = String(w.secondary_field || '').trim();
            const isMultiSeries = Boolean(secField && w.widget_type !== 'pie' && w.widget_type !== 'scatter');
            if (isMultiSeries) {
              const catBuckets = {};
              const cellBuckets = {};
              const seriesBuckets = {};
              rows.forEach(r => {
                const rawCat = resolveFieldVal(r, w.category_field);
                const k = (rawCat !== null && rawCat !== undefined && String(rawCat).trim() !== '') ? String(rawCat) : '(Unassigned)';
                const rawSer = resolveFieldVal(r, secField);
                const sKey = (rawSer !== null && rawSer !== undefined && String(rawSer).trim() !== '') ? String(rawSer) : '(Other Series)';
                const val = (w.aggregation === 'count' && !w.value_field) ? 1 : resolveFieldVal(r, w.value_field);
                if (!catBuckets[k]) catBuckets[k] = [];
                catBuckets[k].push(val);
                if (!cellBuckets[k]) cellBuckets[k] = {};
                if (!cellBuckets[k][sKey]) cellBuckets[k][sKey] = [];
                cellBuckets[k][sKey].push(val);
                if (!seriesBuckets[sKey]) seriesBuckets[sKey] = [];
                seriesBuckets[sKey].push(val);
              });

              let catPairs = Object.entries(catBuckets).map(([k, vals]) => [k, computeMetric(vals, w.aggregation)]);
              if (w.sort_by === 'value_asc') catPairs.sort((a, b) => a[1] - b[1]);
              else if (w.sort_by === 'category_asc') catPairs.sort((a, b) => a[0].localeCompare(b[0]));
              else catPairs.sort((a, b) => b[1] - a[1]);

              const topN = Math.max(1, Number(w.top_n || 15));
              let finalCats = catPairs.map(p => p[0]);
              if (finalCats.length > topN) {
                const headCats = finalCats.slice(0, topN - 1);
                const tailCats = finalCats.slice(topN - 1);
                const otherCells = {};
                tailCats.forEach(tc => {
                  const cells = cellBuckets[tc] || {};
                  Object.entries(cells).forEach(([sk, arr]) => {
                    if (!otherCells[sk]) otherCells[sk] = [];
                    otherCells[sk].push(...arr);
                  });
                });
                cellBuckets['Other'] = otherCells;
                headCats.push('Other');
                finalCats = headCats;
              }

              const seriesNames = Object.entries(seriesBuckets)
                .map(([sk, vals]) => [sk, computeMetric(vals, w.aggregation)])
                .sort((a, b) => b[1] - a[1])
                .slice(0, 12)
                .map(p => p[0]);

              if (!finalCats.length || !seriesNames.length) {
                if (plotTargetEl) {
                  plotTargetEl.innerHTML = `<div style="display:flex;align-items:center;justify-content:center;height:100%;padding:16px;text-align:center;color:var(--text-secondary);font-size:0.86rem;">${escapeHtml(t('no_matching'))}</div>`;
                }
                return;
              }

              const basePalette = ['#38bdf8', '#34d399', '#fbbf24', '#f87171', '#a78bfa', '#fb923c', '#22d3ee', '#f472b6', '#4ade80', '#e879f9', '#818cf8', '#facc15'];
              const pColor = w.primary_color || '#38bdf8';
              const palette = [pColor, ...basePalette.filter(c => c.toLowerCase() !== String(pColor).toLowerCase())];
              const stackMode = String(w.chart_stack_mode || 'group').toLowerCase();

              let matrix = seriesNames.map(sn => finalCats.map(cat => {
                const arr = (cellBuckets[cat] && cellBuckets[cat][sn]) ? cellBuckets[cat][sn] : [];
                return arr.length ? computeMetric(arr, w.aggregation) : 0;
              }));

              if (stackMode === 'percent' && w.widget_type !== 'line') {
                const colSums = finalCats.map((_, ci) => seriesNames.reduce((acc, _sn, si) => acc + Math.max(0, Number(matrix[si][ci] || 0)), 0));
                matrix = matrix.map(rowArr => rowArr.map((v, ci) => colSums[ci] > 0 ? (Math.max(0, Number(v || 0)) / colSums[ci]) * 100 : 0));
              }

              if (typeof Plotly === 'undefined' || !Plotly || typeof Plotly.newPlot !== 'function') {
                _renderFallbackSvgChart(plotTargetEl, w, null, textColor, {
                  categories: finalCats,
                  series: seriesNames,
                  matrix: matrix,
                  colors: palette,
                  stackMode: stackMode
                });
                return;
              }

              const traces = seriesNames.map((sn, si) => {
                const color = palette[si % palette.length];
                const vals = matrix[si];
                if (w.widget_type === 'line') {
                  return {
                    name: sn,
                    x: finalCats,
                    y: vals,
                    type: 'scatter',
                    mode: 'lines+markers',
                    line: { color, width: 2.5 },
                    marker: { color, size: 6 }
                  };
                }
                return {
                  name: sn,
                  x: w.horizontal ? vals : finalCats,
                  y: w.horizontal ? finalCats : vals,
                  orientation: w.horizontal ? 'h' : 'v',
                  type: 'bar',
                  marker: { color }
                };
              });

              const layout = {
                paper_bgcolor: 'transparent',
                plot_bgcolor: 'transparent',
                font: { color: textColor, size: 11 },
                margin: { t: 20, r: 16, b: 42, l: 58 },
                legend: { orientation: 'h', y: 1.12, font: { size: 10 } },
                xaxis: { gridcolor: gridColor, automargin: true },
                yaxis: { gridcolor: gridColor, automargin: true }
              };
              if (w.widget_type !== 'line') {
                layout.barmode = (stackMode === 'stack' || stackMode === 'percent') ? 'stack' : 'group';
                if (stackMode === 'percent') {
                  const valAxis = w.horizontal ? layout.xaxis : layout.yaxis;
                  valAxis.range = [0, 100];
                  valAxis.ticksuffix = '%';
                }
              }

              try {
                Plotly.newPlot(plotId, traces, layout, { responsive: true, displayModeBar: false });
              } catch (_plotlyErr) {
                _renderFallbackSvgChart(plotTargetEl, w, null, textColor, {
                  categories: finalCats,
                  series: seriesNames,
                  matrix: matrix,
                  colors: palette,
                  stackMode: stackMode
                });
                return;
              }

              const plotEl = document.getElementById(plotId);
              if (plotEl && typeof plotEl.on === 'function') {
                plotEl.on('plotly_click', data => {
                  if (!w.enable_cross_filter || !data.points.length) return;
                  const pt = data.points[0];
                  const clickedCat = w.horizontal ? pt.y : pt.x;
                  if (clickedCat !== 'Other') {
                    toggleCategoryFilter(w.id, w.layer_name, w.category_field, clickedCat);
                  }
                });
              }
              return;
            }

            const groups = {};
            rows.forEach(r => {
              const rawCat = resolveFieldVal(r, w.category_field);
              const k = (rawCat !== null && rawCat !== undefined && String(rawCat).trim() !== '') ? String(rawCat) : '(Unassigned)';
              if (!groups[k]) groups[k] = [];
              groups[k].push(w.aggregation === 'count' && !w.value_field ? 1 : resolveFieldVal(r, w.value_field));
            });
            let pairs = Object.entries(groups).map(([k, vals]) => [k, computeMetric(vals, w.aggregation)]);
            if (w.sort_by === 'value_asc') pairs.sort((a, b) => a[1] - b[1]);
            else if (w.sort_by === 'category_asc') pairs.sort((a, b) => a[0].localeCompare(b[0]));
            else pairs.sort((a, b) => b[1] - a[1]);

            const topN = Math.max(1, Number(w.top_n || 15));
            if (pairs.length > topN) {
              const head = pairs.slice(0, topN - 1);
              const tailSum = pairs.slice(topN - 1).reduce((s, p) => s + p[1], 0);
              head.push(['Other', tailSum]);
              pairs = head;
            }

            if (!pairs.length) {
              if (plotTargetEl) {
                plotTargetEl.innerHTML = `<div style="display:flex;align-items:center;justify-content:center;height:100%;padding:16px;text-align:center;color:var(--text-secondary);font-size:0.86rem;">${escapeHtml(t('no_matching'))}</div>`;
              }
              return;
            }
            if (typeof Plotly === 'undefined' || !Plotly || typeof Plotly.newPlot !== 'function') {
              _renderFallbackSvgChart(plotTargetEl, w, pairs, textColor);
              return;
            }

            const labels = pairs.map(p => p[0]);
            const values = pairs.map(p => p[1]);
            const selected = (ACTIVE_FILTERS[w.id] && ACTIVE_FILTERS[w.id].values) || [];

            let trace = {};
            if (w.widget_type === 'pie') {
              const totalPositive = values.reduce((s, v) => s + Math.max(0, Number(v) || 0), 0);
              if (labels.length && totalPositive <= 0) {
                trace = {
                  labels,
                  values: labels.map(() => 1),
                  customdata: values,
                  text: values.map(v => String(v ?? 0)),
                  textinfo: 'label+text',
                  hovertemplate: '%{label}: %{customdata}<extra></extra>',
                  type: 'pie',
                  hole: w.donut ? 0.45 : 0
                };
              } else {
                trace = { labels, values, type: 'pie', hole: w.donut ? 0.45 : 0 };
              }
            } else if (w.widget_type === 'line') {
              trace = { x: labels, y: values, type: 'scatter', mode: 'lines+markers', line: { color: w.primary_color || '#34d399', width: 3 } };
            } else if (w.widget_type === 'scatter') {
              trace = { x: labels, y: values, type: 'scatter', mode: 'markers', marker: { color: w.primary_color || '#38bdf8', size: 10 } };
            } else {
              const colors = labels.map(l => (!selected.length || selected.includes(l)) ? (w.primary_color || '#38bdf8') : '#475569');
              trace = {
                x: w.horizontal ? values : labels,
                y: w.horizontal ? labels : values,
                orientation: w.horizontal ? 'h' : 'v',
                type: 'bar',
                marker: { color: colors }
              };
            }

            try {
              Plotly.newPlot(plotId, [trace], {
                paper_bgcolor: 'transparent', plot_bgcolor: 'transparent',
                font: { color: textColor, size: 11 },
                margin: { t: 16, r: 16, b: 42, l: 58 },
                xaxis: { gridcolor: gridColor, automargin: true },
                yaxis: { gridcolor: gridColor, automargin: true }
              }, { responsive: true, displayModeBar: false });
            } catch (_plotlyErr) {
              _renderFallbackSvgChart(plotTargetEl, w, pairs, textColor);
              return;
            }

            const plotEl = document.getElementById(plotId);
            if (plotEl && typeof plotEl.on === 'function') {
              plotEl.on('plotly_click', data => {
                if (!w.enable_cross_filter || !data.points.length) return;
                const pt = data.points[0];
                const clickedCat = w.widget_type === 'pie' ? pt.label : (w.horizontal ? pt.y : pt.x);
                if (clickedCat !== 'Other') {
                  toggleCategoryFilter(w.id, w.layer_name, w.category_field, clickedCat);
                }
              });
            }
          }
        }
      });
      applyArtboardLayout();
    }

    function renderAll(opts) {
      renderMapFeatures(opts);
      renderWidgetsOnly();
    }

    function hasFreeformLayout() {
      const items = (DASHBOARD.widgets || []).concat(DASHBOARD.slicers || []);
      return items.some(it => Number(it.layout_w || 0) > 0 && Number(it.layout_h || 0) > 0 && (Number(it.layout_x || 0) > 0 || Number(it.layout_y || 0) > 0 || items.length > 0));
    }

    function applyArtboardLayout() {
      const ws = document.getElementById('workspace-main');
      const mapCard = document.getElementById('map-card');
      const wp = document.getElementById('widgets-panel');
      const slicerBar = document.getElementById('slicer-bar');
      if (!ws) return;

      const stackMobile = (typeof isMobileCardStackActive === 'function')
        ? isMobileCardStackActive()
        : Boolean(MOBILE_VIEW_ENABLED && !MOBILE_FIT_OVERVIEW);
      const positioned = (DASHBOARD.widgets || []).concat(DASHBOARD.slicers || [])
        .filter(it => Number(it.layout_w || 0) > 0 && Number(it.layout_h || 0) > 0 && (Number(it.layout_x || 0) > 0 || Number(it.layout_y || 0) > 0));
      if (typeof document !== 'undefined' && document.body && document.body.classList) {
        document.body.classList.toggle('mobile-view', stackMobile);
      }
      if (!positioned.length) {
        ws.classList.remove('freeform');
        if (slicerBar) slicerBar.style.display = '';
        if (mapCard) mapCard.style.display = mapCard.dataset.hiddenPage === '1' ? 'none' : 'flex';
        if (typeof updateMobileNavBar === 'function') updateMobileNavBar();
        return;
      }
      if (slicerBar) slicerBar.style.display = 'flex';

      ws.classList.add('freeform');
      if (wp) wp.style.display = 'contents';
      // Apply configured canvas border styles (v1.5.0)
      const borderStyle = String(DASHBOARD.canvas_border_style || (DASHBOARD.show_design_border === false ? 'none' : 'dashed')).toLowerCase();
      const borderColor = DASHBOARD.canvas_border_color || 'var(--border-color)';
      const borderWidth = Math.max(0, Number(DASHBOARD.canvas_border_width !== undefined ? DASHBOARD.canvas_border_width : 1));
      const borderRadius = Math.max(0, Number(DASHBOARD.canvas_border_radius !== undefined ? DASHBOARD.canvas_border_radius : 10));
      ws.style.borderRadius = borderRadius + 'px';
      if (DASHBOARD.show_design_border === false || borderStyle === 'none' || stackMobile) {
        ws.style.border = 'none';
        ws.style.boxShadow = 'none';
      } else if (borderStyle === 'shadow') {
        ws.style.border = `${Math.max(1, borderWidth)}px solid ${borderColor}`;
        ws.style.boxShadow = '0 10px 30px rgba(2, 132, 199, 0.16), 0 4px 12px rgba(15, 23, 42, 0.12)';
      } else {
        ws.style.border = `${Math.max(1, borderWidth)}px ${borderStyle} ${borderColor}`;
        ws.style.boxShadow = 'none';
      }
      let maxR = Number(DASHBOARD.canvas_width || 1280);
      let maxB = Number(DASHBOARD.canvas_height || 720);

      const activePg = String(ACTIVE_PAGE_ID || 'page_1');
      const mapWidget = (DASHBOARD.widgets || []).find(w => w.widget_type === 'map' && (!w.page_id || String(w.page_id) === activePg))
        || (DASHBOARD.widgets || []).find(w => w.widget_type === 'map');
      const rectItems = [];
      if (mapCard) {
        if (mapCard.dataset.hiddenPage !== '1' && mapWidget && Number(mapWidget.layout_w || 0) > 0) {
          mapCard.style.display = 'flex';
          mapCard.classList.add('freeform-card');
          const mx = Number(mapWidget.layout_x || 12);
          const my = Number(mapWidget.layout_y || 12);
          const mw = Number(mapWidget.layout_w || 520);
          const mh = Number(mapWidget.layout_h || 400);
          if (stackMobile) {
            mapCard.style.left = '';
            mapCard.style.top = '';
            mapCard.style.width = '';
            mapCard.style.height = '';
          } else {
            mapCard.style.left = mx + 'px';
            mapCard.style.top = my + 'px';
            mapCard.style.width = mw + 'px';
            mapCard.style.height = mh + 'px';
          }
          _applyWidgetBorderStyle(mapCard, mapWidget);
          rectItems.push({ el: mapCard, x: mx, y: my, w: mw, h: mh, r: mx + mw, b: my + mh });
          maxR = Math.max(maxR, mx + mw + 16);
          maxB = Math.max(maxB, my + mh + 16);
        } else {
          mapCard.style.display = 'none';
        }
      }

      (DASHBOARD.slicers || []).forEach(sl => {
        const el = document.querySelector(`.slicer-group[data-slicer-id="${sl.id}"]`);
        if (!el || Number(sl.layout_w || 0) <= 0) return;
        el.classList.add('freeform-card');
        const sx = Number(sl.layout_x || 12);
        const sy = Number(sl.layout_y || 12);
        const sw = Number(sl.layout_w || 240);
        const sh = Number(sl.layout_h || 115);
        if (stackMobile) {
          el.style.left = '';
          el.style.top = '';
          el.style.width = '';
          el.style.height = '';
        } else {
          el.style.left = sx + 'px';
          el.style.top = sy + 'px';
          el.style.width = sw + 'px';
          el.style.height = sh + 'px';
        }
        rectItems.push({ el, x: sx, y: sy, w: sw, h: sh, r: sx + sw, b: sy + sh });
        maxR = Math.max(maxR, sx + sw + 16);
        maxB = Math.max(maxB, sy + sh + 16);
      });
      if (slicerBar && !slicerBar.children.length) slicerBar.style.display = 'none';

      (DASHBOARD.widgets || []).forEach(w => {
        if (w.widget_type === 'map') return;
        const el = document.querySelector(`[data-widget-id="${w.id}"]`);
        if (!el || Number(w.layout_w || 0) <= 0) return;
        el.classList.add('freeform-card');
        const wx = Number(w.layout_x || 12);
        const wy = Number(w.layout_y || 12);
        const ww = Number(w.layout_w || 440);
        const wh = Number(w.layout_h || 280);
        if (stackMobile) {
          el.style.left = '';
          el.style.top = '';
          el.style.width = '';
          el.style.height = '';
        } else {
          el.style.left = wx + 'px';
          el.style.top = wy + 'px';
          el.style.width = ww + 'px';
          el.style.height = wh + 'px';
        }
        rectItems.push({ el, x: wx, y: wy, w: ww, h: wh, r: wx + ww, b: wy + wh });
        maxR = Math.max(maxR, wx + ww + 16);
        maxB = Math.max(maxB, wy + wh + 16);
        const plotEl = document.getElementById('plot_' + w.id);
        if (plotEl && typeof Plotly !== 'undefined' && Plotly && Plotly.Plots) {
          setTimeout(() => {
            try { Plotly.Plots.resize(plotEl); } catch (_re) {}
          }, 40);
        }
      });

      const appendOrder = stackMobile
        ? rectItems.slice().sort((a, b) => (Math.round(a.y / 80) - Math.round(b.y / 80)) || (a.x - b.x))
        : rectItems;
      const aeLayout = (typeof document !== 'undefined') ? document.activeElement : null;
      const keepWsFocus = Boolean(aeLayout && _isEditableEl(aeLayout) && (!ws.contains || ws.contains(aeLayout)));
      const targetEls = appendOrder.map(it => it.el).filter(Boolean);
      const curCards = Array.from(ws.children || []).filter(ch => ch && ch.id !== 'widgets-panel');
      const needsOrderSync = targetEls.length !== curCards.length || targetEls.some((el, idx) => curCards[idx] !== el);
      if (needsOrderSync && !keepWsFocus) {
        const scrollerEl = (typeof document !== 'undefined' && typeof document.querySelector === 'function')
          ? document.querySelector('.workspace-scroll')
          : null;
        const savedScrollTop = scrollerEl ? Number(scrollerEl.scrollTop || 0) : 0;
        const getCurCardAt = (pos) => {
          const ch = ws.children || [];
          let seen = 0;
          for (let k = 0; k < ch.length; k++) {
            if (ch[k] && ch[k].id === 'widgets-panel') continue;
            if (seen === pos) return ch[k];
            seen++;
          }
          return (wp && wp.parentNode === ws) ? wp : null;
        };
        targetEls.forEach((el, idx) => {
          const curAt = getCurCardAt(idx);
          if (curAt !== el) {
            if (typeof ws.insertBefore === 'function') ws.insertBefore(el, curAt || null);
            else ws.appendChild(el);
          }
        });
        if (scrollerEl && Math.abs(Number(scrollerEl.scrollTop || 0) - savedScrollTop) > 2) {
          scrollerEl.scrollTop = savedScrollTop;
        }
      }

      // Adjacent border dissolve (#5)
      rectItems.forEach(it => it.el.classList.remove('dissolve-adj-top', 'dissolve-adj-right', 'dissolve-adj-bottom', 'dissolve-adj-left'));
      if (DASHBOARD.dissolve_adjacent_borders && !stackMobile) {
        const tol = 4;
        for (let i = 0; i < rectItems.length; i++) {
          for (let j = i + 1; j < rectItems.length; j++) {
            const a = rectItems[i];
            const b = rectItems[j];
            const vOv = Math.min(a.b, b.b) - Math.max(a.y, b.y);
            const hOv = Math.min(a.r, b.r) - Math.max(a.x, b.x);
            if (vOv > 8) {
              if (Math.abs(a.r - b.x) <= tol) {
                a.el.classList.add('dissolve-adj-right');
                b.el.classList.add('dissolve-adj-left');
              } else if (Math.abs(b.r - a.x) <= tol) {
                b.el.classList.add('dissolve-adj-right');
                a.el.classList.add('dissolve-adj-left');
              }
            }
            if (hOv > 8) {
              if (Math.abs(a.b - b.y) <= tol) {
                a.el.classList.add('dissolve-adj-bottom');
                b.el.classList.add('dissolve-adj-top');
              } else if (Math.abs(b.b - a.y) <= tol) {
                b.el.classList.add('dissolve-adj-bottom');
                a.el.classList.add('dissolve-adj-top');
              }
            }
          }
        }
      }

      if (!stackMobile) {
        ws.style.width = maxR + 'px';
        ws.style.height = maxB + 'px';
      } else {
        ws.style.width = '100%';
        ws.style.height = 'auto';
        ws.style.transform = '';
        ws.style.marginBottom = '';
      }
      if (typeof _applyMobileFitScale === 'function' && MOBILE_FIT_OVERVIEW) _applyMobileFitScale();
      if (typeof updateMobileNavBar === 'function') updateMobileNavBar();
      if (map && typeof map.invalidateSize === 'function') setTimeout(() => map.invalidateSize(), 40);
    }

    let _LAST_VP_WIDTH = (typeof window !== 'undefined' && window.innerWidth) ? Number(window.innerWidth) : 0;
    let _LAST_VP_HEIGHT = (typeof window !== 'undefined' && window.innerHeight) ? Number(window.innerHeight) : 0;

    function _handleMobileResponsiveResize(opts) {
      const force = Boolean(opts && opts.force);
      const curW = (typeof window !== 'undefined' && window.innerWidth) ? Number(window.innerWidth) : _LAST_VP_WIDTH;
      const curH = (typeof window !== 'undefined' && window.innerHeight) ? Number(window.innerHeight) : _LAST_VP_HEIGHT;
      const widthChanged = _LAST_VP_WIDTH > 0 ? (Math.abs(curW - _LAST_VP_WIDTH) > 8) : false;
      const ae = (typeof document !== 'undefined') ? document.activeElement : null;
      const inputFocused = _isEditableEl(ae);

      // Soft keyboard opening/closing or mobile URL bar show/hide changes only viewport height.
      // Running layout reflow / card reordering on height-only resize blurs the input and snaps scrollTop to 0.
      if (!force && !widthChanged && (inputFocused || MOBILE_VIEW_ENABLED)) {
        _LAST_VP_WIDTH = curW;
        _LAST_VP_HEIGHT = curH;
        if (typeof syncMobileScrollBlob === 'function') syncMobileScrollBlob();
        if (inputFocused && ae && typeof document.querySelector === 'function') {
          const scroller = document.querySelector('.workspace-scroll');
          if (scroller && (!scroller.contains || scroller.contains(ae))
              && typeof ae.getBoundingClientRect === 'function'
              && typeof scroller.getBoundingClientRect === 'function') {
            const aRect = ae.getBoundingClientRect();
            const sRect = scroller.getBoundingClientRect();
            if (aRect.bottom > sRect.bottom - 8) {
              scroller.scrollTop += Math.max(0, Math.round(aRect.bottom - (sRect.bottom - 14)));
            } else if (aRect.top < sRect.top + 8) {
              scroller.scrollTop -= Math.max(0, Math.round((sRect.top + 14) - aRect.top));
            }
          }
        }
        return;
      }
      _LAST_VP_WIDTH = curW;
      _LAST_VP_HEIGHT = curH;

      const nextMobile = (typeof detectMobileDeviceViewport === 'function') ? detectMobileDeviceViewport() : MOBILE_VIEW_ENABLED;
      let changed = false;
      if (MOBILE_VIEW_OVERRIDE === null && nextMobile !== MOBILE_VIEW_ENABLED) {
        MOBILE_VIEW_ENABLED = nextMobile;
        if (MOBILE_VIEW_ENABLED) MOBILE_FIT_OVERVIEW = false;
        changed = true;
      }
      if (changed || MOBILE_VIEW_ENABLED || MOBILE_FIT_OVERVIEW) {
        applyArtboardLayout();
        updateMobileNavBar();
      }
      if (map && typeof map.invalidateSize === 'function') map.invalidateSize();
      if (typeof document !== 'undefined' && typeof document.querySelectorAll === 'function' && typeof Plotly !== 'undefined' && Plotly && Plotly.Plots) {
        document.querySelectorAll('.plot-container').forEach(p => {
          try { Plotly.Plots.resize(p); } catch (_rp) {}
        });
      }
    }

    window.addEventListener('DOMContentLoaded', async () => {
      const tbActionsInit = document.querySelector('.toolbar-actions');
      if (tbActionsInit && typeof tbActionsInit.addEventListener === 'function') {
        tbActionsInit.addEventListener('wheel', (ev) => {
          if (tbActionsInit.scrollWidth > tbActionsInit.clientWidth && Math.abs(ev.deltaY) > Math.abs(ev.deltaX)) {
            tbActionsInit.scrollLeft += ev.deltaY;
            ev.preventDefault();
          }
        }, { passive: false });
      }
      if (typeof document.addEventListener === 'function') {
        document.addEventListener('click', (ev) => {
          const menu = document.getElementById('map-scale-menu');
          const badgeBtn = document.getElementById('map-scale-badge');
          if (!menu || menu.style.display !== 'flex') return;
          if (menu.contains && menu.contains(ev.target)) return;
          if (badgeBtn && (ev.target === badgeBtn || (badgeBtn.contains && badgeBtn.contains(ev.target)))) return;
          closeMapScaleMenu();
        });
      }
      initDataCatalog();
      initMap();
      applyLanguageUI();
      if (typeof syncMobileMapTouchLock === 'function') syncMobileMapTouchLock();
      await unpackCompressedLayerRecords();
      Object.entries(BUNDLE.initial_geojson || {}).forEach(([ln, fc]) => {
        if (fc && Array.isArray(fc.features)) ingestGeoJsonFeatures(ln, fc.features, { mergeExisting: true });
      });
      await Promise.all(Object.keys(VECTOR_PYRAMIDS).map(ln => unpackLod1Pyramid(ln)));
      Object.keys(LAYER_RECORDS).forEach(ln => {
        LAYER_RECORDS[ln] = applyExcelJoinsToLayer(ln, LAYER_RECORDS[ln]);
      });
      computeBrowserNaturaPriaOverlap();
      const restoredSessionState = restoreDashboardSessionState();
      renderPagesBar();
      buildSlicers();
      renderActiveFiltersBanner();
      renderMapLayersDrawer();
      beginMapRenderLoader(t('map_rendering_layers'));
      const hasHomeBounds = Boolean(HOME_MAP_VIEW && Array.isArray(HOME_MAP_VIEW.bounds) && HOME_MAP_VIEW.bounds.length === 4);
      const finishInitRender = () => {
        try {
          renderAll((restoredSessionState || hasHomeBounds) ? { skipAutoZoom: true } : undefined);
          updateMobileNavBar();
        } finally {
          endMapRenderLoader(false);
        }
      };
      if (typeof requestAnimationFrame === 'function') {
        requestAnimationFrame(() => setTimeout(finishInitRender, 0));
      } else {
        finishInitRender();
      }
      loadCatalogCapabilities(false);
      if (typeof window !== 'undefined' && typeof window.addEventListener === 'function') {
        let _resizeDeb = null;
        let _pendingForceResize = false;
        const onViewportChange = (forceLayout) => {
          if (forceLayout) _pendingForceResize = true;
          if (_resizeDeb) clearTimeout(_resizeDeb);
          _resizeDeb = setTimeout(() => {
            const forceFlag = _pendingForceResize;
            _pendingForceResize = false;
            _resizeDeb = null;
            _handleMobileResponsiveResize({ force: forceFlag });
          }, 120);
        };
        window.addEventListener('resize', () => onViewportChange(false));
        window.addEventListener('orientationchange', () => onViewportChange(true));
      }
      const wfsServices = (BUNDLE.ogc_services || []).filter(s => s.type === 'wfs' && s.geojson_url);
      const dataMode = String(DASHBOARD.html_data_mode || 'cached').toLowerCase();
      const hasMissingWfs = wfsServices.some(s => !(LAYER_RECORDS[s.name] && LAYER_RECORDS[s.name].length));
      LIVE_SESSION_STAMP = LIVE_SESSION_STAMP || _formatLiveTimeStamp(new Date());
      if (wfsServices.length) {
        wfsServices.forEach(s => {
          const cnt = Array.isArray(LAYER_RECORDS[s.name]) ? LAYER_RECORDS[s.name].length : 0;
          if (cnt > 0 && !LAYER_LIVE_INFO[s.name]) {
            LAYER_LIVE_INFO[s.name] = { status: 'cached', label: 'Session RAM', loaded: cnt };
          }
        });
      }
      if (dataMode === 'cached' && !hasMissingWfs) {
        setLiveStatus('html_cached_snapshot');
      } else if (dataMode === 'cached' && hasMissingWfs) {
        setLiveStatus('html_cached_snapshot');
        refreshLiveWfs({ force: true, missingOnly: true });
      } else if (wfsServices.length && (dataMode === 'live' || dataMode === 'hybrid' || hasMissingWfs)) {
        refreshLiveWfs({ force: true });
      } else {
        setLiveStatus('html_cached_snapshot');
      }
      initAutoRefreshTimer();
    });
  </script>
</body>
</html>

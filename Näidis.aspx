    function _toWgs84Coord(x, y) {
      const nx = Number(x);
      const ny = Number(y);
      if (!isFinite(nx) || !isFinite(ny)) return null;
      if (Math.abs(nx) <= 180 && Math.abs(ny) <= 90) {
        // In GeoJSON [lon, lat], longitude for Estonia is ~21..28 and latitude ~57..60
        if (nx > 45 && ny < 45) return [nx, ny];
        return [ny, nx];
      }
      let estX = nx;
      let estY = ny;
      if (estX > 3000000 && estY < 1000000) {
        estX = ny;
        estY = nx;
      }
      if (typeof proj4 !== 'undefined') {
        try {
          const estProj = '+proj=lcc +lat_1=59.33333333333334 +lat_2=58 +lat_0=57.51755393055556 +lon_0=24 +x_0=500000 +y_0=6375000 +ellps=GRS80 +towgs84=0,0,0,0,0,0,0 +units=m +no_defs';
          const out = proj4(estProj, 'WGS84', [estX, estY]);
          if (out && isFinite(out[0]) && isFinite(out[1])) {
            return [out[1], out[0]];
          }
        } catch (_e) {}
      }
      return null;
    }

    function _convertEstGeomToWgs84(geom) {
      if (!geom) return null;
      let parsed = geom;
      if (typeof parsed === 'string' && parsed.trim().startsWith('{')) {
        try { parsed = JSON.parse(parsed); } catch (_e) { return null; }
      }
      if (!parsed || !parsed.coordinates) return null;
      const convPt = pt => {
        if (!Array.isArray(pt) || pt.length < 2) return pt;
        const px = Number(pt[0]);
        const py = Number(pt[1]);
        if (Math.abs(px) <= 180 && Math.abs(py) <= 90) {
          return (px > 45 && py < 45) ? [py, px] : [px, py];
        }
        const ll = _toWgs84Coord(px, py);
        return ll ? [ll[1], ll[0]] : [px, py];
      };
      const convRings = rings => (rings || []).map(r => (r || []).map(convPt));
      if (parsed.type === 'Point') return { type: 'Point', coordinates: convPt(parsed.coordinates) };
      if (parsed.type === 'LineString') return { type: 'LineString', coordinates: (parsed.coordinates || []).map(convPt) };
      if (parsed.type === 'MultiLineString') return { type: 'MultiLineString', coordinates: convRings(parsed.coordinates) };
      if (parsed.type === 'Polygon') return { type: 'Polygon', coordinates: convRings(parsed.coordinates) };
      if (parsed.type === 'MultiPolygon') return { type: 'MultiPolygon', coordinates: (parsed.coordinates || []).map(convRings) };
      return null;
    }


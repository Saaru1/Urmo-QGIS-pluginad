        }
      }
      if (effScale !== null && effScale > maxScaleForMinZoom(minZ)) return false;
      return true;
    }

    function syncZoomVisibilityImmediate() {
      if (!map) return;
      const z = (typeof map.getZoom === 'function') ? Number(map.getZoom()) : 7;
      const sDenom = computeMapScaleDenominator();
      const lnames = orderedMapLayerNames();
      let needRenderOnReveal = false;
      IS_SYNCING_MAP_LAYERS += 1;

    function computeInitialLayerVisibility(layerNames) {
      const mapWidget = (DASHBOARD.widgets || []).find(w => w.widget_type === 'map');
      const explicitList = (mapWidget && Array.isArray(mapWidget.map_layers) && mapWidget.map_layers.length > 0)
        ? new Set(mapWidget.map_layers)
        : null;
      const styles = (mapWidget && mapWidget.map_layer_styles) || {};
      const vis = {};
      (layerNames || []).forEach(ln => {
        const st = styles[ln];
        if (st && st.visible === false) vis[ln] = false;
        else if (st && st.visible === true) vis[ln] = true;

    function _clearPreviewWmsRunOverlays() {
      _setTileSourceLoading('preview_wms', false);
      if (map) {
        IS_SYNCING_MAP_LAYERS += 1;
        try {
          (PREVIEW_WMS_RUN_OVERLAYS || []).forEach(ov => {
            if (ov && map.hasLayer(ov)) map.removeLayer(ov);

      const next = L.canvas({ padding: 0.5, pane: paneName });
      if (next) next._qdashPane = paneName;
      LAYER_CANVAS_RENDERERS[layerName] = next;
      return next;
    }

    function maxScaleForMinZoom(minZoomVal) {
      const minZ = Number(minZoomVal || 0);
      if (!Number.isFinite(minZ) || minZ <= 0) return 0;
      const zIdx = Math.max(0, Math.min(ESTONIA_RESOLUTIONS.length - 1, Math.round(minZ)));
      const res = ESTONIA_RESOLUTIONS[zIdx] || 15.625;
      return Math.round(res * 3779.52756 * 1.15);
    }

    function isLayerVisibleAtZoom(ln, zoomVal, scaleDenom) {

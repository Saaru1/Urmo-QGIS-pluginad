      if (!LAYER_GEOMETRIES[layerName]) LAYER_GEOMETRIES[layerName] = {};
      if (!LAYER_GEOM_LOD[layerName]) LAYER_GEOM_LOD[layerName] = {};
      if (!LAYER_GEOM_BBOXES[layerName]) LAYER_GEOM_BBOXES[layerName] = {};
      const existingList = (options.mergeExisting && Array.isArray(LAYER_RECORDS[layerName]) && LAYER_RECORDS[layerName].length > 0)
        ? LAYER_RECORDS[layerName]
        : null;
      const byId = existingList ? new Map() : null;
      const byAltKey = existingList ? new Map() : null;
      const byCentroidBucket = existingList ? new Map() : null;
      const altIdFields = ['parandniidu_nr', 'sys_id', 'kr_kood', 'kood', 'tunnus', 'katastritunnus', 'elupaik_id', 'gml_id', 'objectid', 'gid', 'fid', 'id'];
      if (existingList) {
        existingList.forEach(rec => {
          if (!rec) return;
          if (rec._feature_id !== undefined && rec._feature_id !== null) {
            byId.set(String(rec._feature_id), rec);
          }
          altIdFields.forEach(fn => {
            const v = rec[fn];
            if (v !== undefined && v !== null && String(v).trim() !== '') {
              const k = fn + ':' + String(v).trim();
              if (!byAltKey.has(k)) byAltKey.set(k, []);
              byAltKey.get(k).push(rec);
            }
          });
          const rlat = Number(rec._lat), rlon = Number(rec._lon);
          if (Number.isFinite(rlat) && Number.isFinite(rlon)) {
            const bk = `${Math.round(rlat * 200)}_${Math.round(rlon * 200)}`;
            if (!byCentroidBucket.has(bk)) byCentroidBucket.set(bk, []);
            byCentroidBucket.get(bk).push(rec);
          }
        });
      }

      const parsed = features.map((f, idx) => {
        const fid = (f.id !== undefined && f.id !== null)
          ? f.id
          : ((f.properties && f.properties._feature_id !== undefined && f.properties._feature_id !== null)
              ? f.properties._feature_id
              : `${layerName}_${idx}`);
        const props = Object.assign({ _feature_id: fid }, f.properties || {});
        if (props.parandniidu_tyyp !== undefined && !props.koosluse_grupp) {
          const raw = String(props.parandniidu_tyyp || '').trim();

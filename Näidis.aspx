          const zoomVis = isLayerVisibleAtZoom(ln, z, sDenom);
          if (!userVis || !zoomVis) {
            if (grp && typeof grp.clearLayers === 'function') grp.clearLayers();
            if (!userVis && grp && typeof map.hasLayer === 'function' && map.hasLayer(grp)) map.removeLayer(grp);
            if (wms && typeof map.hasLayer === 'function' && map.hasLayer(wms)) map.removeLayer(wms);
          } else if (grp) {
            if (typeof map.hasLayer === 'function' && !map.hasLayer(grp)) grp.addTo(map);
            const stCfgZ = getMapLayerStyleCfg(ln);
            const isZoomGated = Boolean(stCfgZ && Number(stCfgZ.min_zoom) > 0);
            const hasGrpContent = (typeof grp.getLayers === 'function') ? grp.getLayers().length > 0 : false;
            const hasWmsContent = Boolean(wms && typeof map.hasLayer === 'function' && map.hasLayer(wms));
            if (isZoomGated && !hasGrpContent && !hasWmsContent) needRenderOnReveal = true;
